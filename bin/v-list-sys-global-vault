#!/bin/bash
# info: list masked global secrets in NexviaCP Vault
# options: [FORMAT]
#
# example: v-list-sys-global-vault json

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

format=${1:-json}
vault_file="$HESTIA/conf/vault.conf"

if [ ! -f "$vault_file" ]; then
	echo "{}"
	exit 0
fi

if [ "$format" = "json" ]; then
	echo "{"
	first=1
	while IFS= read -r line || [ -n "$line" ]; do
		[[ "$line" =~ ^[[:space:]]*# ]] && continue
		[[ -z "$line" ]] && continue
		key=$(echo "$line" | cut -d '=' -f 1 | tr -d ' \t\r\n')
		[ -z "$key" ] && continue
		if [ $first -eq 0 ]; then
			echo ","
		fi
		first=0
		printf '    "%s": {\n        "KEY": "%s",\n        "MASKED": "••••••••••••••••",\n        "TYPE": "Global Vault"\n    }' "$key" "$key"
	done < "$vault_file"
	echo ""
	echo "}"
else
	while IFS= read -r line || [ -n "$line" ]; do
		[[ "$line" =~ ^[[:space:]]*# ]] && continue
		[[ -z "$line" ]] && continue
		key=$(echo "$line" | cut -d '=' -f 1 | tr -d ' \t\r\n')
		[ -n "$key" ] && echo "$key: ••••••••••••••••"
	done < "$vault_file"
fi
exit 0
