#!/bin/bash
# info: update NexviaCP core from Nexvia-Digital-Studio/NexviaCP repository
# options: [BRANCH]

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

branch=${1:-main}
gh_token="$GITHUB_TOKEN"

echo "[*] Starting NexviaCP Core update from branch '$branch'..."

repo_url="https://github.com/Nexvia-Digital-Studio/NexviaCP.git"

tmp_dir=$(mktemp -d -t nexvia_update_XXXXXX)
src_dir="$tmp_dir/repo"
trap 'rm -rf "$tmp_dir"' EXIT

# Feed the GitHub token to git via a GIT_ASKPASS helper so it never
# appears on the command line or inside the repo URL (/proc safe)
askpass=""
if [ -n "$gh_token" ]; then
	askpass="$tmp_dir/.gh_askpass.sh"
	{
		echo '#!/bin/sh'
		echo "cat <<'_NXV_TOKEN_EOF_'"
		printf '%s\n' "$gh_token"
		echo '_NXV_TOKEN_EOF_'
	} > "$askpass"
	chmod 700 "$askpass"
fi

echo "[*] Cloning latest NexviaCP code..."
if [ -n "$askpass" ]; then
	if ! GIT_ASKPASS="$askpass" GIT_TERMINAL_PROMPT=0 git -c credential.helper= \
		clone --depth 1 -b "$branch" "$repo_url" "$src_dir" 2>/dev/null; then
		echo "[-] Error: Failed to fetch updates from GitHub."
		exit 1
	fi
else
	if ! git clone --depth 1 -b "$branch" "$repo_url" "$src_dir" 2>/dev/null; then
		echo "[-] Error: Failed to fetch updates from GitHub."
		exit 1
	fi
fi

echo "[*] Applying core updates to $HESTIA..."
# Copy bin
cp -rf "$src_dir/bin"/* "$HESTIA/bin/" 2>/dev/null || true
chmod +x "$HESTIA/bin"/*
chown -R root:root "$HESTIA/bin"

# Copy web
cp -rf "$src_dir/web"/* "$HESTIA/web/" 2>/dev/null || true

# Copy func / install
[ -d "$src_dir/func" ] && cp -rf "$src_dir/func"/* "$HESTIA/func/" 2>/dev/null || true
[ -d "$src_dir/install" ] && cp -rf "$src_dir/install"/* "$HESTIA/install/" 2>/dev/null || true

rm -rf "$tmp_dir"

# Sync templates to live data directory
mkdir -p "$HESTIA/data/templates"
cp -rf "$HESTIA/install/deb/templates/." "$HESTIA/data/templates/" 2>/dev/null || true
[ -d "$HESTIA/install/common/templates/web" ] && cp -rf "$HESTIA/install/common/templates/web/." "$HESTIA/data/templates/web/" 2>/dev/null || true
[ -d "$HESTIA/install/common/templates/dns" ] && cp -rf "$HESTIA/install/common/templates/dns/." "$HESTIA/data/templates/dns/" 2>/dev/null || true

# Sync packages
mkdir -p "$HESTIA/data/packages"
[ -d "$HESTIA/install/common/packages" ] && cp -rf "$HESTIA/install/common/packages/." "$HESTIA/data/packages/" 2>/dev/null || true

# Ensure File Manager is installed and configuration is synced
if [ ! -d "$HESTIA/web/fm" ] || [ ! -f "$HESTIA/web/fm/configuration.php" ]; then
	echo "[*] Ensuring File Manager is installed..."
	"$HESTIA/bin/v-add-sys-filemanager" >/dev/null 2>&1 || true
fi
if [ -d "$HESTIA/web/fm" ]; then
	cp -f "$HESTIA/install/deb/filemanager/filegator/configuration.php" "$HESTIA/web/fm/configuration.php" 2>/dev/null || true
	chown root:root "$HESTIA/web/fm/configuration.php" 2>/dev/null || true
	chmod 644 "$HESTIA/web/fm/configuration.php" 2>/dev/null || true
	chown -R hestiaweb:hestiaweb "$HESTIA/web/fm/private" 2>/dev/null || true
fi

# Ensure phpMyAdmin/phpPgAdmin routes exist in panel nginx config
# (panel nginx comes from the hestia-nginx package and is NOT managed by this
# script otherwise — inject idempotently so fresh installs get the routes too)
PMA_PANEL_CONF="$HESTIA/nginx/conf/nginx.conf"
if [ -f "$HESTIA/install/deb/nginx/phpmyadmin-panel.snippet" ] && ! grep -q "location /phpmyadmin" "$PMA_PANEL_CONF"; then
	echo "[*] Adding phpMyAdmin/phpPgAdmin routes to panel nginx..."
	cp -f "$PMA_PANEL_CONF" "${PMA_PANEL_CONF}.bak-nexvia"
	python3 - "$PMA_PANEL_CONF" "$HESTIA/install/deb/nginx/phpmyadmin-panel.snippet" <<'PYEOF'
import sys
conf_path, snippet_path = sys.argv[1], sys.argv[2]
conf = open(conf_path, encoding="utf-8-sig").read()
snippet = open(snippet_path, encoding="utf-8-sig").read().lstrip("\ufeff")
anchor = "\t\tlocation ~ \\.php$ {"
if anchor not in conf:
    sys.exit("anchor not found")
open(conf_path, "w", encoding="utf-8").write(conf.replace(anchor, snippet + anchor, 1))
PYEOF
	if ! "$HESTIA/nginx/sbin/hestia-nginx" -t -c "$PMA_PANEL_CONF" >/dev/null 2>&1; then
		echo "[-] Panel nginx config test failed; restoring backup."
		cp -f "${PMA_PANEL_CONF}.bak-nexvia" "$PMA_PANEL_CONF"
	else
		echo "[+] Panel phpMyAdmin/phpPgAdmin routes ensured."
	fi
fi

# Sync Dovecot config if present
if [ -d "/etc/dovecot/conf.d" ]; then
	DOVECOT_VER=$(dovecot --version 2>/dev/null | cut -d. -f1,2)
	if [ "$DOVECOT_VER" = "2.4" ] && [ -d "$HESTIA/install/common/dovecot/2.4/conf.d" ]; then
		cp -rf "$HESTIA/install/common/dovecot/2.4/conf.d/." "/etc/dovecot/conf.d/" 2>/dev/null || true
	elif [ -d "$HESTIA/install/common/dovecot/2.3/conf.d" ]; then
		cp -rf "$HESTIA/install/common/dovecot/2.3/conf.d/." "/etc/dovecot/conf.d/" 2>/dev/null || true
	fi
	systemctl reload dovecot 2>/dev/null || true
fi

# Reload panel services gracefully in background so HTTP response is returned cleanly
echo "[*] Scheduling graceful service reload..."
(sleep 1 && (systemctl reload hestia-php hestia-nginx 2>/dev/null || systemctl restart hestia-php hestia-nginx 2>/dev/null)) >/dev/null 2>&1 &

echo "[+] SUCCESS: NexviaCP updated to the latest version successfully."
log_event "$OK" "NexviaCP core updated to latest $branch"
exit 0
