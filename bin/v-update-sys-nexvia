#!/bin/bash
# info: update NexviaCP core from Nexvia-Digital-Studio/NexviaCP repository
# options: [BRANCH]

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

branch=${1:-main}
gh_token="$GITHUB_TOKEN"

echo "[*] Starting NexviaCP Core update from branch '$branch'..."

repo_url="https://github.com/Nexvia-Digital-Studio/NexviaCP.git"

tmp_dir=$(mktemp -d -t nexvia_update_XXXXXX)
src_dir="$tmp_dir/repo"
trap 'rm -rf "$tmp_dir"' EXIT

# Feed the GitHub token to git via a GIT_ASKPASS helper so it never
# appears on the command line or inside the repo URL (/proc safe)
askpass=""
if [ -n "$gh_token" ]; then
	askpass="$tmp_dir/.gh_askpass.sh"
	{
		echo '#!/bin/sh'
		echo "cat <<'_NXV_TOKEN_EOF_'"
		printf '%s\n' "$gh_token"
		echo '_NXV_TOKEN_EOF_'
	} > "$askpass"
	chmod 700 "$askpass"
fi

echo "[*] Cloning latest NexviaCP code..."
if [ -n "$askpass" ]; then
	if ! GIT_ASKPASS="$askpass" GIT_TERMINAL_PROMPT=0 git -c credential.helper= \
		clone --depth 1 -b "$branch" "$repo_url" "$src_dir" 2>/dev/null; then
		echo "[-] Error: Failed to fetch updates from GitHub."
		exit 1
	fi
else
	if ! git clone --depth 1 -b "$branch" "$repo_url" "$src_dir" 2>/dev/null; then
		echo "[-] Error: Failed to fetch updates from GitHub."
		exit 1
	fi
fi

echo "[*] Applying core updates to $HESTIA..."
# Copy bin
cp -rf "$src_dir/bin"/* "$HESTIA/bin/" 2>/dev/null || true
chmod +x "$HESTIA/bin"/*
chown -R root:root "$HESTIA/bin"

# Copy web
cp -rf "$src_dir/web"/* "$HESTIA/web/" 2>/dev/null || true

# Copy func / install
[ -d "$src_dir/func" ] && cp -rf "$src_dir/func"/* "$HESTIA/func/" 2>/dev/null || true
[ -d "$src_dir/install" ] && cp -rf "$src_dir/install"/* "$HESTIA/install/" 2>/dev/null || true

rm -rf "$tmp_dir"

# Reload panel services gracefully in background so HTTP response is returned cleanly
echo "[*] Scheduling graceful service reload..."
(sleep 1 && (systemctl reload hestia-php hestia-nginx 2>/dev/null || systemctl restart hestia-php hestia-nginx 2>/dev/null)) >/dev/null 2>&1 &

echo "[+] SUCCESS: NexviaCP updated to the latest version successfully."
log_event "$OK" "NexviaCP core updated to latest $branch"
exit 0
