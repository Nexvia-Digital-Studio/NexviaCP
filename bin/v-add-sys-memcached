#!/bin/bash
# info: install and enable Memcached server + PHP memcached extension
# options: NONE
#
# example: v-add-sys-memcached
#
# Installs the memcached package, enables the PHP memcached extension for every
# installed PHP-FPM version, starts the service, and flips MEMCACHED_SUPPORT=yes.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_hestia_demo_mode

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

# Idempotent: nothing to do if already enabled.
if [ "$MEMCACHED_SUPPORT" = "yes" ] && systemctl is-active --quiet memcached 2>/dev/null; then
	echo "[+] Memcached is already installed and enabled."
	exit 0
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

echo "[*] Installing Memcached server..."

apt-get -qq update >/dev/null 2>&1 || true

if ! apt-get -qq install -y memcached >/dev/null 2>&1; then
	check_result "$E_UPDATE" "unable to install memcached package"
fi

# Bind to localhost only (default memcached config listens on 127.0.0.1:11211
# but make sure the -l flag is set so it is never exposed publicly).
if [ -f /etc/memcached.conf ]; then
	if ! grep -q "^[[:space:]]*-l 127.0.0.1" /etc/memcached.conf; then
		echo "-l 127.0.0.1" >> /etc/memcached.conf
	fi
fi

# Enable + start the service.
systemctl enable memcached >/dev/null 2>&1 || true
systemctl restart memcached >/dev/null 2>&1 || true

# Enable the PHP memcached extension for every installed PHP version so apps can
# use Memcached for sessions/object-cache without manual configuration.
for phpdir in /etc/php/*/; do
	[ -d "$phpdir" ] || continue
	phpver="${phpdir%/}"
	phpver="${phpver##*/}"
	# Skip CLI-only or non-FPM versions gracefully.
	if [ -d "/etc/php/$phpver/fpm" ]; then
		# Install the matching php-memcached package if the Sury ondrej repo layout is in use.
		if apt-cache show "php$phpver-memcached" >/dev/null 2>&1; then
			apt-get -qq install -y "php$phpver-memcached" >/dev/null 2>&1 || true
		elif apt-cache show "php-memcached" >/dev/null 2>&1; then
			apt-get -qq install -y "php-memcached" >/dev/null 2>&1 || true
		fi
		# Make sure the extension is actually enabled.
		phpenmod -v "$phpver" memcached >/dev/null 2>&1 || true
		systemctl reload "php$phpver-fpm" >/dev/null 2>&1 || true
	fi
done

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-change-sys-config-value 'MEMCACHED_SUPPORT' 'yes'
$BIN/v-log-action "system" "Info" "Plugins" "Memcached server installed and PHP memcached extension enabled."
log_event "$OK" "$ARGUMENTS"

echo "[+] Memcached server installed and running on 127.0.0.1:11211."
echo "    PHP memcached extension enabled for all installed PHP versions."
exit
