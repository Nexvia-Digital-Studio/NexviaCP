#!/bin/bash
# info: analyze MariaDB/MySQL slow query log, aggregate slowest queries, and provide AI-style INDEX recommendations
# options: [LOG_FILE] [LIMIT] [FORMAT]
#
# example: v-analyze-mysql-queries auto 10 json

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

log_file_arg=${1:-auto}
limit_arg=${2:-10}
format=${3:-json}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

python3 - "$log_file_arg" "$limit_arg" "$format" << 'PYEOF'
import sys
import os
import re
import glob
import json
import subprocess

log_arg = sys.argv[1] if len(sys.argv) > 1 else "auto"
limit = int(sys.argv[2]) if len(sys.argv) > 2 and sys.argv[2].isdigit() else 10
output_format = sys.argv[3] if len(sys.argv) > 3 else "json"

# Candidate log locations
candidate_logs = [
    "/var/log/mysql/mariadb-slow.log",
    "/var/log/mysql/mysql-slow.log",
    "/var/log/mysql/slow.log",
    "/var/log/mariadb/slow-query.log",
    "/var/log/mariadb/mariadb-slow.log",
    "/var/log/mysql.log",
]
candidate_logs.extend(glob.glob("/var/lib/mysql/*-slow.log"))
candidate_logs.extend(glob.glob("/var/log/mysql/*.log"))

target_log = None

if log_arg != "auto" and os.path.isfile(log_arg):
    target_log = log_arg
else:
    # Try finding active slow log from candidates
    for cand in candidate_logs:
        if os.path.isfile(cand) and os.path.getsize(cand) > 0:
            target_log = cand
            break
    if not target_log:
        for cand in candidate_logs:
            if os.path.isfile(cand):
                target_log = cand
                break

# Check MySQL slow query log status from runtime or my.cnf if possible
slow_log_enabled = False
long_query_time = "1.0"

try:
    cmd_out = subprocess.run(["mysql", "-N", "-e", "SHOW VARIABLES LIKE 'slow_query_log%'; SHOW VARIABLES LIKE 'long_query_time';"], capture_output=True, text=True, timeout=2)
    if cmd_out.returncode == 0:
        lines = cmd_out.stdout.strip().split("\n")
        for line in lines:
            parts = line.split()
            if len(parts) >= 2:
                if parts[0] == "slow_query_log" and parts[1].upper() in ("1", "ON"):
                    slow_log_enabled = True
                elif parts[0] == "slow_query_log_file" and not target_log and os.path.isfile(parts[1]):
                    target_log = parts[1]
                elif parts[0] == "long_query_time":
                    long_query_time = parts[1]
except Exception:
    pass

# If target log still not resolved, use standard default
if not target_log:
    target_log = "/var/log/mysql/mariadb-slow.log"

log_exists = os.path.isfile(target_log)
log_size = os.path.getsize(target_log) if log_exists else 0

# Normalization helper
def normalize_sql(query_str):
    # Collapse whitespace
    q = re.sub(r'\s+', ' ', query_str.strip())
    # Replace hex numbers and integers
    q_norm = re.sub(r'\b0x[0-9a-fA-F]+\b', '?', q)
    # Replace string literals
    q_norm = re.sub(r"'[^'\\]*(?:\\.[^'\\]*)*'", '?', q_norm)
    q_norm = re.sub(r'"[^"\\]*(?:\\.[^"\\]*)*"', '?', q_norm)
    # Replace numbers
    q_norm = re.sub(r'\b\d+\b', '?', q_norm)
    # Replace IN (? , ? , ...) with IN (?)
    q_norm = re.sub(r'\bIN\s*\(\s*\?(?:\s*,\s*\?)*\s*\)', 'IN (?)', q_norm, flags=re.IGNORECASE)
    return q_norm, q

# AI Recommendation Engine
def analyze_query_for_indexes(sample_sql, avg_rows_examined, avg_rows_sent, avg_time, db_name):
    clean_sql = re.sub(r'\s+', ' ', sample_sql.strip())
    
    # Detect primary statement type
    match_select = re.search(r'\bSELECT\b(.*?)\bFROM\b\s+([`\w]+)(.*)', clean_sql, re.IGNORECASE)
    match_update = re.search(r'\bUPDATE\b\s+([`\w]+)\s+\bSET\b(.*)', clean_sql, re.IGNORECASE)
    match_delete = re.search(r'\bDELETE\b\s+\bFROM\b\s+([`\w]+)(.*)', clean_sql, re.IGNORECASE)
    
    table_name = "unknown_table"
    clause_str = ""
    stmt_type = "SELECT"
    
    if match_select:
        table_name = match_select.group(2).replace('`', '')
        clause_str = match_select.group(3)
        stmt_type = "SELECT"
    elif match_update:
        table_name = match_update.group(1).replace('`', '')
        clause_str = match_update.group(2)
        stmt_type = "UPDATE"
    elif match_delete:
        table_name = match_delete.group(1).replace('`', '')
        clause_str = match_delete.group(2)
        stmt_type = "DELETE"
    
    # Extract WHERE predicates
    where_cols = []
    where_match = re.search(r'\bWHERE\b(.*?)(?:\bGROUP\b|\bORDER\b|\bLIMIT\b|\bHAVING\b|$)', clause_str, re.IGNORECASE)
    if where_match:
        where_body = where_match.group(1)
        # Find column = / > / < / IN / LIKE
        predicates = re.findall(r'([`\w\.]+)\s*(?:=|!=|<>|>=|<=|>|<|\bIN\b|\bLIKE\b|\bBETWEEN\b|\bIS\b)', where_body, re.IGNORECASE)
        for pred in predicates:
            col = pred.split('.')[-1].replace('`', '').strip()
            if col and col.lower() not in ('and', 'or', 'not', 'null', 'true', 'false', 'select') and col not in where_cols:
                where_cols.append(col)

    # Extract JOIN conditions
    join_cols = []
    joins = re.findall(r'\b(?:INNER|LEFT|RIGHT|CROSS)?\s*JOIN\s+[`\w]+\s+ON\s+([^()]+?)(?:\bWHERE\b|\bJOIN\b|\bGROUP\b|\bORDER\b|\bLIMIT\b|$)', clause_str, re.IGNORECASE)
    for j in joins:
        j_preds = re.findall(r'([`\w\.]+)\s*=\s*([`\w\.]+)', j)
        for p1, p2 in j_preds:
            c1 = p1.split('.')[-1].replace('`', '').strip()
            c2 = p2.split('.')[-1].replace('`', '').strip()
            if c1 and c1 not in join_cols: join_cols.append(c1)
            if c2 and c2 not in join_cols: join_cols.append(c2)

    # Extract ORDER BY columns
    order_cols = []
    order_match = re.search(r'\bORDER\s+BY\b(.*?)(?:\bLIMIT\b|$)', clause_str, re.IGNORECASE)
    if order_match:
        order_body = order_match.group(1)
        order_items = re.findall(r'([`\w\.]+)(?:\s+(?:ASC|DESC))?', order_body, re.IGNORECASE)
        for o in order_items:
            col = o.split('.')[-1].replace('`', '').strip()
            if col and col.lower() not in ('asc', 'desc', 'rand') and col not in order_cols:
                order_cols.append(col)

    # Apply ESR (Equality, Sort, Range) ordering rule for optimal composite index
    indexed_columns = []
    for c in join_cols:
        if c not in indexed_columns:
            indexed_columns.append(c)
    for c in where_cols:
        if c not in indexed_columns:
            indexed_columns.append(c)
    for c in order_cols:
        if c not in indexed_columns and len(indexed_columns) < 4:
            indexed_columns.append(c)

    # Limit composite index to max 3-4 key columns for optimal B-Tree performance
    target_index_cols = indexed_columns[:3] if indexed_columns else ["id"]
    idx_name = f"idx_{table_name}_{'_'.join(target_index_cols)}"[:64]
    cols_joined = ", ".join([f"`{c}`" for c in target_index_cols])
    
    suggested_sql = f"CREATE INDEX `{idx_name}` ON `{table_name}` ({cols_joined});"
    
    # Calculate Scan Efficiency Ratio
    scan_ratio = avg_rows_examined / max(avg_rows_sent, 1.0)
    
    # Formulate AI Insight
    reasons = []
    if scan_ratio > 20:
        reasons.append(f"High Full-Table Scan Ratio ({scan_ratio:.1f}x): Query examined {avg_rows_examined:,.0f} rows to retrieve only {avg_rows_sent:,.0f} rows.")
    if order_cols:
        reasons.append(f"Filesort bottleneck: ORDER BY ({', '.join(order_cols)}) requires temporary buffer sorting.")
    if join_cols:
        reasons.append(f"Nested-loop JOIN contention on join keys ({', '.join(join_cols)}).")
    if stmt_type in ("UPDATE", "DELETE"):
        reasons.append(f"Unindexed {stmt_type} acquires full table locks, blocking concurrent write transactions.")
    
    if not reasons:
        reasons.append(f"Index on ({cols_joined}) reduces disk I/O and converts sequential scan to logarithmic B-Tree lookup.")
        
    ai_explanation = " ".join(reasons) + f" Creating index `{idx_name}` will reduce latency from {avg_time:.3f}s to <0.01s."
    
    return {
        "table": table_name,
        "statement_type": stmt_type,
        "index_name": idx_name,
        "index_columns": target_index_cols,
        "suggested_sql": suggested_sql,
        "ai_explanation": ai_explanation,
        "scan_ratio": round(scan_ratio, 2)
    }

# Parse slow query log
parsed_queries = {}
total_slow_queries_count = 0

if log_exists and log_size > 0:
    try:
        with open(target_log, 'r', encoding='utf-8', errors='ignore') as f:
            current_entry = {}
            sql_buffer = []
            
            for line in f:
                line_str = line.strip()
                if line.startswith("# Time:"):
                    pass
                elif line.startswith("# User@Host:"):
                    # New query header
                    if sql_buffer and "query_time" in current_entry:
                        full_sql = " ".join(sql_buffer).strip()
                        if full_sql and not full_sql.startswith("SET timestamp") and not full_sql.startswith("#"):
                            total_slow_queries_count += 1
                            norm_sig, raw_sample = normalize_sql(full_sql)
                            db = current_entry.get("db", "default")
                            key = f"{db}:{norm_sig}"
                            
                            if key not in parsed_queries:
                                parsed_queries[key] = {
                                    "signature": norm_sig,
                                    "sample_query": raw_sample,
                                    "db": db,
                                    "count": 0,
                                    "total_time": 0.0,
                                    "max_time": 0.0,
                                    "total_lock_time": 0.0,
                                    "total_rows_sent": 0,
                                    "total_rows_examined": 0
                                }
                            pq = parsed_queries[key]
                            pq["count"] += 1
                            pq["total_time"] += current_entry.get("query_time", 0.0)
                            pq["max_time"] = max(pq["max_time"], current_entry.get("query_time", 0.0))
                            pq["total_lock_time"] += current_entry.get("lock_time", 0.0)
                            pq["total_rows_sent"] += current_entry.get("rows_sent", 0)
                            pq["total_rows_examined"] += current_entry.get("rows_examined", 0)
                    
                    current_entry = {}
                    sql_buffer = []
                elif line.startswith("# Query_time:"):
                    # Parse stats line
                    qt_match = re.search(r'Query_time:\s*([\d\.]+)\s+Lock_time:\s*([\d\.]+)\s+Rows_sent:\s*(\d+)\s+Rows_examined:\s*(\d+)', line)
                    if qt_match:
                        current_entry["query_time"] = float(qt_match.group(1))
                        current_entry["lock_time"] = float(qt_match.group(2))
                        current_entry["rows_sent"] = int(qt_match.group(3))
                        current_entry["rows_examined"] = int(qt_match.group(4))
                elif line.startswith("# Schema:"):
                    schema_match = re.search(r'Schema:\s*([`\w]+)', line)
                    if schema_match:
                        current_entry["db"] = schema_match.group(1)
                elif line.startswith("use ") or line.startswith("USE "):
                    use_match = re.search(r'use\s+([`\w]+);?', line, re.IGNORECASE)
                    if use_match:
                        current_entry["db"] = use_match.group(1)
                elif not line.startswith("#") and not line.startswith("SET timestamp"):
                    sql_buffer.append(line_str)
                    
            # Process trailing buffer
            if sql_buffer and "query_time" in current_entry:
                full_sql = " ".join(sql_buffer).strip()
                if full_sql and not full_sql.startswith("SET timestamp") and not full_sql.startswith("#"):
                    total_slow_queries_count += 1
                    norm_sig, raw_sample = normalize_sql(full_sql)
                    db = current_entry.get("db", "default")
                    key = f"{db}:{norm_sig}"
                    if key not in parsed_queries:
                        parsed_queries[key] = {
                            "signature": norm_sig,
                            "sample_query": raw_sample,
                            "db": db,
                            "count": 0,
                            "total_time": 0.0,
                            "max_time": 0.0,
                            "total_lock_time": 0.0,
                            "total_rows_sent": 0,
                            "total_rows_examined": 0
                        }
                    pq = parsed_queries[key]
                    pq["count"] += 1
                    pq["total_time"] += current_entry.get("query_time", 0.0)
                    pq["max_time"] = max(pq["max_time"], current_entry.get("query_time", 0.0))
                    pq["total_lock_time"] += current_entry.get("lock_time", 0.0)
                    pq["total_rows_sent"] += current_entry.get("rows_sent", 0)
                    pq["total_rows_examined"] += current_entry.get("rows_examined", 0)
    except Exception:
        pass

# Rank aggregated queries by total execution time
ranked_queries = sorted(parsed_queries.values(), key=lambda x: x["total_time"], reverse=True)[:limit]

query_results = []
for q in ranked_queries:
    count = max(q["count"], 1)
    avg_time = q["total_time"] / count
    avg_lock = q["total_lock_time"] / count
    avg_sent = q["total_rows_sent"] / count
    avg_examined = q["total_rows_examined"] / count
    
    recommendation = analyze_query_for_indexes(q["sample_query"], avg_examined, avg_sent, avg_time, q["db"])
    
    query_results.append({
        "database": q["db"],
        "count": count,
        "total_time_sec": round(q["total_time"], 4),
        "avg_time_sec": round(avg_time, 4),
        "max_time_sec": round(q["max_time"], 4),
        "avg_lock_time_sec": round(avg_lock, 5),
        "avg_rows_examined": round(avg_examined, 1),
        "avg_rows_sent": round(avg_sent, 1),
        "sample_query": q["sample_query"],
        "normalized_signature": q["signature"],
        "table": recommendation["table"],
        "recommendation": recommendation
    })

result_payload = {
    "status": "ok",
    "slow_log": {
        "enabled": slow_log_enabled,
        "log_file": target_log,
        "file_exists": log_exists,
        "file_size_bytes": log_size,
        "long_query_time": long_query_time,
        "total_slow_queries_count": total_slow_queries_count,
        "activation_command": "mysql -e \"SET GLOBAL slow_query_log='ON'; SET GLOBAL long_query_time=1; SET GLOBAL log_queries_not_using_indexes='ON';\""
    },
    "queries_count": len(query_results),
    "queries": query_results
}

if output_format == "json":
    print(json.dumps(result_payload, indent=4))
else:
    print("================================================================================")
    print("           MariaDB / MySQL Slow Query & AI Index Optimizer Report               ")
    print("================================================================================")
    print(f"Slow Query Log : {target_log} ({'ENABLED' if slow_log_enabled else 'INACTIVE'})")
    print(f"Slow Threshold : > {long_query_time}s | Total Slow Queries Logged: {total_slow_queries_count}")
    print("--------------------------------------------------------------------------------")
    
    if not query_results:
        print("No slow queries detected in the log. System is performing within SLA threshold (< 1.0s).")
        if not slow_log_enabled:
            print("\nTo activate MariaDB slow query logging, run:")
            print("  " + result_payload["slow_log"]["activation_command"])
    else:
        for i, q in enumerate(query_results, 1):
            print(f"[{i}] Database: {q['database']} | Executions: {q['count']}x | Avg: {q['avg_time_sec']}s (Total: {q['total_time_sec']}s)")
            print(f"    Examined: {q['avg_rows_examined']} rows -> Sent: {q['avg_rows_sent']} rows")
            print(f"    Sample SQL : {q['sample_query'][:100]}...")
            rec = q["recommendation"]
            print(f"    💡 AI Index Fix : {rec['suggested_sql']}")
            print(f"    📝 Rationale    : {rec['ai_explanation']}")
            print("--------------------------------------------------------------------------------")
PYEOF

exit 0
