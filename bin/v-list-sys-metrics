#!/bin/bash
# info: export system and panel metrics as JSON or Prometheus text
# options: [FORMAT]
#
# example: v-list-sys-metrics json
# example: v-list-sys-metrics prometheus
#
# Fast (<1s, no external calls) local exporter: load averages, memory,
# swap, disk usage for / and /home plus the biggest mount, uptime, panel
# user count and web/mail/dns domain counts. Prometheus output uses the
# "nexviacp_" metric prefix with # HELP/# TYPE comments.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

arg1=$1

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
[ -f /etc/hestiacp/hestia.conf ] && source /etc/hestiacp/hestia.conf
[ -z "$HESTIA" ] && HESTIA="/usr/local/hestia"
if [ ! -d "$HESTIA" ] && [ -d "$(cd "$(dirname "$0")/.." && pwd)" ]; then
	HESTIA="$(cd "$(dirname "$0")/.." && pwd)"
fi
# shellcheck source=/usr/local/hestia/func/main.sh
[ -f "$HESTIA/func/main.sh" ] && source "$HESTIA/func/main.sh"
[ -f "$HESTIA/conf/hestia.conf" ] && source_conf "$HESTIA/conf/hestia.conf"

# Parse arguments
if [[ "$arg1" =~ ^(json|prometheus)$ ]]; then
	format="$arg1"
else
	format="json"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

python3 - "$format" "$HESTIA" <<'PYEOF'
import sys, os, re, glob, json, subprocess, datetime

fmt = sys.argv[1]
hestia = sys.argv[2]

# ---------------- load averages (/proc/loadavg) ----------------
load1 = load5 = load15 = 0.0
try:
    with open('/proc/loadavg') as f:
        parts = f.read().split()
    load1, load5, load15 = float(parts[0]), float(parts[1]), float(parts[2])
except Exception:
    pass

# ---------------- uptime (/proc/uptime) ----------------
uptime_seconds = 0.0
try:
    with open('/proc/uptime') as f:
        uptime_seconds = float(f.read().split()[0])
except Exception:
    pass

# ---------------- memory / swap (/proc/meminfo) ----------------
mem = {}
try:
    with open('/proc/meminfo') as f:
        for line in f:
            key, _, rest = line.partition(':')
            fields = rest.split()
            if fields:
                mem[key] = int(fields[0]) * 1024  # kB -> bytes
except Exception:
    pass

memory_total = mem.get('MemTotal', 0)
memory_available = mem.get('MemAvailable', mem.get('MemFree', 0))
swap_total = mem.get('SwapTotal', 0)
swap_free = mem.get('SwapFree', 0)

# ---------------- disks (df -B1 -P) ----------------
# Always include /, add /home if present, plus the biggest data mount.
skip_fs = {'tmpfs', 'devtmpfs', 'udev', 'none', 'overlay', 'squashfs',
           'fuse.lxcfs', 'cgroup', 'cgroup2', 'efivarfs', 'mqueue', 'hugetlbfs'}
disks = {}
biggest_mount, biggest_total, biggest_entry = None, 0, None
try:
    out = subprocess.run(['df', '-B1', '-P'], capture_output=True, text=True,
                         timeout=10).stdout
    for line in out.splitlines()[1:]:
        fields = line.split(None, 5)
        if len(fields) < 6:
            continue
        fs = fields[0]
        try:
            total, used, avail = int(fields[1]), int(fields[2]), int(fields[3])
        except ValueError:
            continue
        mount = fields[5].strip() or '/'
        fsname = fs.split('/')[-1]
        if total <= 0 or fs in skip_fs or fsname in skip_fs:
            continue
        entry = {'total_bytes': total, 'used_bytes': used, 'free_bytes': avail}
        if mount == '/' or mount == '/home':
            disks[mount] = entry
        elif (total > biggest_total and total >= 1073741824
              and not mount.startswith(('/boot', '/var/lib/snapd'))):
            # biggest data mount: real storage (>=1GiB), skip boot/snap
            biggest_mount, biggest_total, biggest_entry = mount, total, entry
    if biggest_mount and biggest_mount not in disks:
        disks[biggest_mount] = biggest_entry
except Exception:
    pass

# Ensure / always present
if '/' not in disks:
    disks['/'] = {'total_bytes': 0, 'used_bytes': 0, 'free_bytes': 0}

# ---------------- panel users (data/users dirs) ----------------
users_total = 0
users_dir = os.path.join(hestia, 'data', 'users')
try:
    for name in os.listdir(users_dir):
        if os.path.isdir(os.path.join(users_dir, name)) and not name.startswith('.'):
            users_total += 1
except Exception:
    pass

# ---------------- domain counts (per-user conf files) ----------------
def count_domains(kind):
    total = 0
    for conf in glob.glob(os.path.join(hestia, 'data', 'users', '*', kind + '.conf')):
        try:
            with open(conf, 'r', errors='replace') as f:
                total += sum(1 for l in f if l.strip())
        except Exception:
            continue
    return total

web_domains = count_domains('web')
mail_domains = count_domains('mail')
dns_domains = count_domains('dns')

timestamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')

# ---------------- output ----------------
if fmt == 'prometheus':
    def escape_label(v):
        return str(v).replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n')

    def emit(name, mtype, help_text, samples):
        print('# HELP %s %s' % (name, help_text))
        print('# TYPE %s %s' % (name, mtype))
        for labels, value in samples:
            if labels:
                label_str = ','.join(
                    '%s="%s"' % (k, escape_label(v)) for k, v in labels.items())
                print('%s{%s} %s' % (name, label_str, value))
            else:
                print('%s %s' % (name, value))

    emit('nexviacp_load1', 'gauge', '1-minute load average', [({}, format(load1, '.2f'))])
    emit('nexviacp_load5', 'gauge', '5-minute load average', [({}, format(load5, '.2f'))])
    emit('nexviacp_load15', 'gauge', '15-minute load average', [({}, format(load15, '.2f'))])
    emit('nexviacp_memory_total_bytes', 'gauge', 'Total physical memory in bytes',
         [({}, memory_total)])
    emit('nexviacp_memory_available_bytes', 'gauge', 'Available physical memory in bytes',
         [({}, memory_available)])
    emit('nexviacp_swap_total_bytes', 'gauge', 'Total swap in bytes', [({}, swap_total)])
    emit('nexviacp_swap_free_bytes', 'gauge', 'Free swap in bytes', [({}, swap_free)])
    emit('nexviacp_disk_total_bytes', 'gauge', 'Total disk space per mount in bytes',
         [({'mount': m}, d['total_bytes']) for m, d in sorted(disks.items())])
    emit('nexviacp_disk_free_bytes', 'gauge', 'Free disk space per mount in bytes',
         [({'mount': m}, d['free_bytes']) for m, d in sorted(disks.items())])
    emit('nexviacp_disk_used_bytes', 'gauge', 'Used disk space per mount in bytes',
         [({'mount': m}, d['used_bytes']) for m, d in sorted(disks.items())])
    emit('nexviacp_uptime_seconds', 'gauge', 'Uptime of the host in seconds',
         [({}, int(uptime_seconds))])
    emit('nexviacp_users_total', 'gauge', 'Number of hosted panel users', [({}, users_total)])
    emit('nexviacp_web_domains_total', 'gauge', 'Number of hosted web domains',
         [({}, web_domains)])
    emit('nexviacp_mail_domains_total', 'gauge', 'Number of hosted mail domains',
         [({}, mail_domains)])
    emit('nexviacp_dns_domains_total', 'gauge', 'Number of hosted dns domains',
         [({}, dns_domains)])
else:
    print(json.dumps({
        'timestamp': timestamp,
        'load': {'load1': round(load1, 2), 'load5': round(load5, 2), 'load15': round(load15, 2)},
        'memory': {'total_bytes': memory_total, 'available_bytes': memory_available},
        'swap': {'total_bytes': swap_total, 'free_bytes': swap_free},
        'disk': disks,
        'uptime_seconds': int(uptime_seconds),
        'users': {'total': users_total},
        'domains': {'web': web_domains, 'mail': mail_domains, 'dns': dns_domains},
    }, indent=2))
PYEOF

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit 0
