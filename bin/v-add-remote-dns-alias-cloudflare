#!/bin/bash
# info: create Cloudflare CNAME record for a web domain alias
# options: DOMAIN ALIAS
#
# example: v-add-remote-dns-alias-cloudflare example.com www2.example.com
#
# Uses the Cloudflare API v4 to create a CNAME record pointing ALIAS to DOMAIN.
# Requires DNS_API_PROVIDER=cloudflare and CF_API_TOKEN in hestia.conf.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
domain=$1
alias=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain.sh
source $HESTIA/func/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Cloudflare API helper function
cf_api() {
	local method="$1"
	local endpoint="$2"
	local data="$3"
	if [ -n "$data" ]; then
		printf 'header = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\n' "$CF_API_TOKEN" | \
			curl --silent --show-error --max-time 30 -K - \
				--request "$method" "https://api.cloudflare.com/client/v4$endpoint" \
				--data "$data"
	else
		printf 'header = "Authorization: Bearer %s"\n' "$CF_API_TOKEN" | \
			curl --silent --show-error --max-time 30 -K - \
				--request "$method" "https://api.cloudflare.com/client/v4$endpoint"
	fi
}

# Resolve zone ID by walking up domain hierarchy
resolve_zone_id() {
	local target="$1"
	local cur="$target"
	local zid=""
	while [ -n "$cur" ]; do
		zid=$(cf_api GET "/zones?name=$cur" | jq -r '.result[0].id // empty')
		if [ -n "$zid" ]; then
			echo "$zid"
			return 0
		fi
		if [[ "$cur" == *.* ]]; then
			cur="${cur#*.}"
		else
			break
		fi
	done
	return 1
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'DOMAIN ALIAS'
is_format_valid 'domain' 'alias'
check_hestia_demo_mode

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

# Exit silently if Cloudflare provider is not configured or auto zone is disabled
if [ "$DNS_API_PROVIDER" != "cloudflare" ]; then
	exit 0
fi

if [ "${CF_AUTO_ZONE:-yes}" = "no" ]; then
	exit 0
fi

if [ -z "$CF_API_TOKEN" ]; then
	check_result "$E_NOTEXIST" "CF_API_TOKEN is not configured"
fi

# Determine default proxied state (orange cloud)
cf_proxied="true"
if [ "$CF_PROXY_RECORDS_DEFAULT" = "false" ] || [ "$CF_PROXY_RECORDS_DEFAULT" = "no" ]; then
	cf_proxied="false"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

zone_id=$(resolve_zone_id "$alias")

# If no zone found for alias, check if we should create a zone for it (if apex)
if [ -z "$zone_id" ]; then
	account_id="$CF_ACCOUNT_ID"
	if [ -z "$account_id" ]; then
		account_id=$(cf_api GET "/zones?per_page=1" | jq -r '.result[0].account.id // empty')
	fi
	if [ -z "$account_id" ]; then
		account_id=$(cf_api GET "/accounts?per_page=1" | jq -r '.result[0].id // empty')
	fi

	if [ -n "$account_id" ]; then
		zone_payload=$(jq -nc --arg n "$alias" --arg a "$account_id" \
			'{name:$n, account:{id:$a}, type:"full"}')
		zone_json=$(cf_api POST "/zones" "$zone_payload")
		success=$(echo "$zone_json" | jq -r '.success // false')
		if [ "$success" = "true" ]; then
			zone_id=$(echo "$zone_json" | jq -r '.result.id')
			echo "$zone_json" | jq -r '.result.name_servers[]? // empty' | while read -r ns; do
				[ -n "$ns" ] && $BIN/v-log-action "system" "Info" "DNS" "Cloudflare zone $alias created, assigned NS: $ns"
			done
		fi
	fi
fi

if [ -z "$zone_id" ]; then
	check_result "$E_NOTEXIST" "Could not resolve Cloudflare Zone ID for alias $alias"
fi

# Check if CNAME record already exists
existing_id=$(cf_api GET "/zones/$zone_id/dns_records?type=CNAME&name=$alias" | jq -r '.result[0].id // empty')
if [ -z "$existing_id" ]; then
	rec_payload=$(jq -nc \
		--arg name "$alias" \
		--arg content "$domain" \
		--argjson proxied "$cf_proxied" \
		'{type:"CNAME", name:$name, content:$content, ttl:1, proxied:$proxied}')

	rec_resp=$(cf_api POST "/zones/$zone_id/dns_records" "$rec_payload")
	rec_success=$(echo "$rec_resp" | jq -r '.success // false')
	if [ "$rec_success" != "true" ]; then
		err_msg=$(echo "$rec_resp" | jq -r '.errors[0].message // "Failed to create CNAME record"')
		check_result "$E_CONNECT" "Failed to create Cloudflare CNAME record for alias $alias: $err_msg"
	fi
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "DNS" "Added Cloudflare CNAME record for alias $alias -> $domain."
log_event "$OK" "$ARGUMENTS"

exit 0
