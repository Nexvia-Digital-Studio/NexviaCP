#!/bin/bash
# info: register cron job for AI Ops self-healing engine (v-monitor-sys-healing)
# options: NONE
#
# example: v-add-cron-sys-healing
#
# Adds a 5-minute cron job to the "hestiaweb" crontab to run v-monitor-sys-healing:
#   */5 * * * * sudo /usr/local/hestia/bin/v-monitor-sys-healing
# Safe to run multiple times (idempotent).

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

CRON_FILE="/etc/cron.d/nexvia-healing"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_hestia_demo_mode

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

cat << 'EOF' > "$CRON_FILE"
# NexviaCP AI Ops & Self-Healing Engine (runs every 5 minutes)
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

*/5 * * * * root /usr/local/hestia/bin/v-monitor-sys-healing >/dev/null 2>&1
EOF

chmod 644 "$CRON_FILE"

# Restarting cron
$BIN/v-restart-cron
check_result $? "Cron restart failed" > /dev/null

# Logging
$BIN/v-log-action "system" "Info" "System" "AI Ops self-healing system cron job enabled (/etc/cron.d/nexvia-healing)."

log_event "$OK" "$ARGUMENTS"

exit 0
