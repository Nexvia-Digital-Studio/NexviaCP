#!/bin/bash
# info: ensure demo-site infrastructure exists (user, dirs, php-fpm pool, nginx include)
# options: —
#
# Idempotent setup for the demo site feature (v-add-demo-site). Called by
# v-update-sys-nexvia after every core update; safe to run any time.
#
#   - system user/group nexviademo (runs demo PHP, owns demo files)
#   - /var/lib/hestia/demos            published demo trees
#   - /etc/nginx/demo-sites            per-demo nginx location files
#   - php-fpm pool 'nexvia-demo'       isolated backend for demo PHP
#   - include line in live panelproxy SSL confs (panel domain) so the
#     /<name>-<random>/ URLs are served without touching the panel proxy
#
# nginx/php-fpm are only RELOADED (never restarted) — a hard restart of
# system nginx drops the listener the panel itself is proxied through.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/demo-site.sh
source $HESTIA/func/demo-site.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

NGINX_RELOAD=0
PHP_POOL_VER=""
PHP_POOL_CHANGED=0

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# --- dirs -------------------------------------------------------------
mkdir -p "$DEMO_NGINX_DIR" "$DEMO_DEMOS_DIR"
chmod 755 "$DEMO_NGINX_DIR" "$DEMO_DEMOS_DIR"

# --- system user ------------------------------------------------------
if ! getent group "$DEMO_POOL_GROUP" >/dev/null 2>&1; then
	groupadd -r "$DEMO_POOL_GROUP"
fi
if ! id "$DEMO_POOL_USER" >/dev/null 2>&1; then
	useradd -r -g "$DEMO_POOL_GROUP" -d "$DEMO_DEMOS_DIR" -s /usr/sbin/nologin \
		-M "$DEMO_POOL_USER"
	echo "[+] Created system user $DEMO_POOL_USER."
fi

# --- php-fpm pool -----------------------------------------------------
# Reuse the existing pool's PHP version if present, otherwise pick the
# highest installed FPM (func/demo-site.sh derives the socket the same way).
for p in /etc/php/*/fpm/pool.d/nexvia-demo.conf; do
	if [ -f "$p" ]; then
		PHP_POOL_VER="${p#/etc/php/}"
		PHP_POOL_VER="${PHP_POOL_VER%%/*}"
		break
	fi
done
if [ -z "$PHP_POOL_VER" ]; then
	for v in 8.5 8.4 8.3 8.2; do
		[ -d "/etc/php/$v/fpm/pool.d" ] && PHP_POOL_VER="$v" && break
	done
fi
if [ -z "$PHP_POOL_VER" ]; then
	echo "[!] No php-fpm found — demo PHP disabled (static demos still work)."
else
	pool_file="/etc/php/$PHP_POOL_VER/fpm/pool.d/nexvia-demo.conf"
	pool_sock="/run/php/php${PHP_POOL_VER}-fpm-nexviademo.sock"
	pool_content="[nexvia-demo]
; Managed by v-ensure-demo-sites — isolated backend for demo sites
; published under the panel domain (see func/demo-site.sh).
user = $DEMO_POOL_USER
group = $DEMO_POOL_GROUP
listen = $pool_sock
listen.owner = www-data
listen.group = www-data
listen.mode = 0660
pm = dynamic
pm.max_children = 8
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3
pm.max_requests = 200
catch_workers_output = yes
slowlog = /var/log/hestia/demo-php-slow.log
request_slowlog_timeout = 15s
php_admin_value[open_basedir] = $DEMO_DEMOS_DIR:/var/lib/php/sessions:/tmp:/usr/share/php
php_admin_value[disable_functions] = exec,passthru,system,shell_exec,popen,proc_open,pcntl_exec,putenv,dl,mail,socket_create,socket_bind,socket_listen,socket_accept,stream_socket_server,pfsockopen
php_admin_flag[allow_url_fopen] = off
php_admin_flag[allow_url_include] = off
php_admin_value[upload_max_filesize] = 32M
php_admin_value[post_max_size] = 32M
php_admin_value[max_execution_time] = 60
php_admin_value[memory_limit] = 128M
php_admin_flag[display_errors] = off"
	if [ ! -f "$pool_file" ] || ! printf '%s' "$pool_content" | cmp -s - "$pool_file"; then
		printf '%s\n' "$pool_content" > "$pool_file"
		chmod 644 "$pool_file"
		PHP_POOL_CHANGED=1
		echo "[+] php$PHP_POOL_VER-fpm pool 'nexvia-demo' written."
	fi
fi

# --- demo PHP network jail (nftables egress filter) -------------------
# Demos need zero server-side network EXCEPT repo sync (demo_git runs git
# as the pool user -> github.com:443 + DNS). Blocks SSRF/lateral movement
# to localhost services even if a demo repo is compromised; separate inet
# table survives v-update-firewall INPUT rebuilds. All steps idempotent.
if command -v nft >/dev/null 2>&1; then
	mkdir -p /etc/nftables.d
	jail_changed=0
	if ! grep -q "nxv_phpjail" /etc/nftables.d/nexvia-phpjail.nft 2>/dev/null; then
		cat > /etc/nftables.d/nexvia-phpjail.nft <<'NXV_JAIL_EOF'
# Nexvia demo-PHP network jail — egress filter for the demo pool user.
# Applied by nexvia-phpjail.service. GitHub ranges per api.github.com/meta.
table inet nxv_phpjail {
	set gh_v4 {
		type ipv4_addr
		flags interval
		elements = { 140.82.112.0/20, 143.55.192.0/20, 185.199.108.0/22,
		             192.30.252.0/22, 20.201.28.151, 20.205.243.166,
		             102.133.202.242, 20.248.137.48, 20.207.73.82,
		             20.27.177.113, 20.200.245.247, 20.233.83.145,
		             20.5.157.168, 20.61.105.242, 20.66.244.0/24 }
	}
	set gh_v6 {
		type ipv6_addr
		flags interval
		elements = { 2a0a:a440::/29, 2606:50c0::/32 }
	}
	chain jail_out {
		type filter hook output priority filter; policy accept;
		meta skuid nexviademo udp dport 53 accept comment "dns for git sync"
		meta skuid nexviademo tcp dport 53 accept comment "dns for git sync"
		meta skuid nexviademo ip  daddr @gh_v4 tcp dport 443 accept comment "git sync github"
		meta skuid nexviademo ip6 daddr @gh_v6 tcp dport 443 accept comment "git sync github v6"
		meta skuid nexviademo counter reject comment "demo php jail"
	}
}
NXV_JAIL_EOF
		chmod 644 /etc/nftables.d/nexvia-phpjail.nft
		jail_changed=1
	fi
	if [ ! -x /usr/local/sbin/nxv-phpjail-apply ]; then
		cat > /usr/local/sbin/nxv-phpjail-apply <<'NXV_APPLY_EOF'
#!/bin/bash
# Nexvia demo-PHP network jail applier — idempotent, run at boot/update.
# Applies /etc/nftables.d/nexvia-phpjail.nft, then live-resolves the GitHub
# hosts the demo repo-sync needs and adds them to the gh_v4 set (covers
# regional IP variance beyond the static ranges).
set -u
NFT_FILE=/etc/nftables.d/nexvia-phpjail.nft
command -v nft >/dev/null 2>&1 || exit 0
[ -f "$NFT_FILE" ] || exit 0

nft list table inet nxv_phpjail >/dev/null 2>&1 && nft delete table inet nxv_phpjail
if ! nft -f "$NFT_FILE"; then
	echo "nexvia-phpjail: nft apply failed" >&2
	exit 1
fi

for h in github.com api.github.com codeload.github.com objects.githubusercontent.com; do
	for ip in $(getent ahostsv4 "$h" 2>/dev/null | awk '{print $1}' | sort -u); do
		nft add element inet nxv_phpjail gh_v4 "{ $ip }" 2>/dev/null || true
	done
done
exit 0
NXV_APPLY_EOF
		chmod 700 /usr/local/sbin/nxv-phpjail-apply
		jail_changed=1
	fi
	if ! grep -q "nxvia-phpjail" /etc/systemd/system/nexvia-phpjail.service 2>/dev/null; then
		cat > /etc/systemd/system/nexvia-phpjail.service <<'NXV_UNIT_EOF'
[Unit]
Description=Nexvia demo-PHP network jail (nftables egress filter for nexviademo)
After=network.target nss-user-lookup.target
Documentation=file:///etc/nftables.d/nexvia-phpjail.nft

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/nxv-phpjail-apply
ExecReload=/usr/local/sbin/nxv-phpjail-apply

[Install]
WantedBy=multi-user.target
NXV_UNIT_EOF
		systemctl daemon-reload
		jail_changed=1
	fi
	systemctl enable nexvia-phpjail.service >/dev/null 2>&1 || true
	if [ "$jail_changed" = "1" ]; then
		systemctl restart nexvia-phpjail.service \
			&& echo "[+] demo PHP network jail (re)applied."
	fi
fi

# --- nginx include line in live panelproxy SSL confs ------------------
for conf in /etc/nginx/conf.d/domains/*.ssl.conf; do
	[ -f "$conf" ] || continue
	grep -q "proxy_pass https://127.0.0.1:2083" "$conf" || continue
	grep -q "demo-sites" "$conf" && continue
	# Insert before the final closing brace of the server block.
	if [ "$(tail -n1 "$conf" | tr -d '[:space:]')" != "}" ]; then
		echo "[!] ${conf##*/}: unexpected layout, include NOT added"
		continue
	fi
	cp -f "$conf" "${conf}.bak-nexvia"
	sed -i "\$i\\$(printf '\t# Nexvia demo sites (secret demo URLs served locally)')\\n$(printf '\tinclude %s/*.conf;' "$DEMO_NGINX_DIR")" "$conf"
	if ! nginx -t >/dev/null 2>&1; then
		cp -f "${conf}.bak-nexvia" "$conf"
		echo "[!] ${conf##*/}: nginx rejected the include, restored."
	else
		NGINX_RELOAD=1
		echo "[+] ${conf##*/}: demo-sites include added."
	fi
done

# --- reloads (graceful only) ------------------------------------------
if [ "$PHP_POOL_CHANGED" = "1" ] && [ -n "$PHP_POOL_VER" ]; then
	systemctl reload "php${PHP_POOL_VER}-fpm" && echo "[+] php${PHP_POOL_VER}-fpm reloaded."
fi
if [ "$NGINX_RELOAD" = "1" ]; then
	nginx -t >/dev/null 2>&1 && systemctl reload nginx && echo "[+] nginx reloaded."
fi

echo "[+] demo-sites infrastructure ensured."
exit 0
