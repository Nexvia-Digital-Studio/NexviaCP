#!/bin/bash
# info: delete Cloudflare DNS records (or zone) for a web domain
# options: DOMAIN
#
# example: v-delete-remote-dns-host-cloudflare example.com
#
# Uses the Cloudflare API v4 to remove DNS records for the given domain.
# If CF_DELETE_ZONE is set to "yes" and the domain is the zone apex, the entire
# Cloudflare zone is deleted; otherwise, only host records for the domain and
# its www subdomain are safely deleted.
# Requires DNS_API_PROVIDER=cloudflare and CF_API_TOKEN in hestia.conf.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
domain=$1

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain.sh
source $HESTIA/func/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Cloudflare API helper function
cf_api() {
	local method="$1"
	local endpoint="$2"
	local data="$3"
	if [ -n "$data" ]; then
		printf 'header = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\n' "$CF_API_TOKEN" | \
			curl --silent --show-error --max-time 30 -K - \
				--request "$method" "https://api.cloudflare.com/client/v4$endpoint" \
				--data "$data"
	else
		printf 'header = "Authorization: Bearer %s"\n' "$CF_API_TOKEN" | \
			curl --silent --show-error --max-time 30 -K - \
				--request "$method" "https://api.cloudflare.com/client/v4$endpoint"
	fi
}

# Resolve zone ID by walking up domain hierarchy
resolve_zone_id() {
	local target="$1"
	local cur="$target"
	local zid=""
	while [ -n "$cur" ]; do
		zid=$(cf_api GET "/zones?name=$cur" | jq -r '.result[0].id // empty')
		if [ -n "$zid" ]; then
			echo "$zid"
			return 0
		fi
		if [[ "$cur" == *.* ]]; then
			cur="${cur#*.}"
		else
			break
		fi
	done
	return 1
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'DOMAIN'
is_format_valid 'domain'
check_hestia_demo_mode

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

# Exit silently if Cloudflare provider is not configured
if [ "$DNS_API_PROVIDER" != "cloudflare" ]; then
	exit 0
fi

if [ -z "$CF_API_TOKEN" ]; then
	exit 0
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

zone_id=$(resolve_zone_id "$domain")

if [ -z "$zone_id" ]; then
	# No matching Cloudflare zone found; nothing to delete
	exit 0
fi

# Check if entire zone deletion is requested
if [ "${CF_DELETE_ZONE}" = "yes" ]; then
	zone_name=$(cf_api GET "/zones/$zone_id" | jq -r '.result.name // empty')
	if [ "$zone_name" = "$domain" ]; then
		del_resp=$(cf_api DELETE "/zones/$zone_id")
		del_success=$(echo "$del_resp" | jq -r '.success // false')
		if [ "$del_success" = "true" ]; then
			$BIN/v-log-action "system" "Info" "DNS" "Deleted Cloudflare zone $domain (Zone ID: $zone_id)."
			log_event "$OK" "$ARGUMENTS"
			exit 0
		else
			err_msg=$(echo "$del_resp" | jq -r '.errors[0].message // "Failed to delete zone"')
			$BIN/v-log-action "system" "Warning" "DNS" "Cloudflare zone delete failed for $domain: $err_msg"
		fi
	fi
fi

# Default safe cleanup: delete matching DNS records for this hostname & www
record_ids=$(cf_api GET "/zones/$zone_id/dns_records?name=$domain" | jq -r '.result[].id // empty')
for rec_id in $record_ids; do
	[ -n "$rec_id" ] && cf_api DELETE "/zones/$zone_id/dns_records/$rec_id" >/dev/null 2>&1
done

www_record_ids=$(cf_api GET "/zones/$zone_id/dns_records?name=www.$domain" | jq -r '.result[].id // empty')
for rec_id in $www_record_ids; do
	[ -n "$rec_id" ] && cf_api DELETE "/zones/$zone_id/dns_records/$rec_id" >/dev/null 2>&1
done

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "DNS" "Deleted Cloudflare DNS records for $domain."
log_event "$OK" "$ARGUMENTS"

exit 0
