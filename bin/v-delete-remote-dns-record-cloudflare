#!/bin/bash
# info: delete a DNS TXT record from Cloudflare (cleanup after LE dns-01)
# options: DOMAIN RECORD_ID
#
# example: v-delete-remote-dns-record-cloudflare example.com abc123recordid
#
# Uses the Cloudflare API v4 to delete the given DNS record id. The DOMAIN
# argument is accepted for symmetry/logging but only the RECORD_ID is used.
# Requires DNS_API_PROVIDER=cloudflare, CF_API_TOKEN and CF_ZONE_ID in hestia.conf.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
domain=$1
record_id=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Cloudflare API helper
cf_get() {
	printf 'header = "Authorization: Bearer %s"\n' "$CF_API_TOKEN" | \
		curl --silent --show-error --max-time 30 -K - "https://api.cloudflare.com/client/v4$1"
}

# Resolve zone ID by walking up domain hierarchy
resolve_zone_id() {
	local target="$1"
	local cur="$target"
	local zid=""
	while [ -n "$cur" ]; do
		zid=$(cf_get "/zones?name=$cur" | jq -r '.result[0].id // empty')
		if [ -n "$zid" ]; then
			echo "$zid"
			return 0
		fi
		if [[ "$cur" == *.* ]]; then
			cur="${cur#*.}"
		else
			break
		fi
	done
	return 1
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'DOMAIN RECORD_ID'
is_format_valid 'domain' 'record_id'
check_hestia_demo_mode

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

if [ "$DNS_API_PROVIDER" != "cloudflare" ]; then
	check_result "$E_INVALID" "DNS_API_PROVIDER is not set to cloudflare"
fi
if [ -z "$CF_API_TOKEN" ]; then
	check_result "$E_NOTEXIST" "CF_API_TOKEN is not configured"
fi

# Dynamically resolve zone ID from domain or fallback to CF_ZONE_ID
zone_id=$(resolve_zone_id "$domain")
if [ -z "$zone_id" ] && [ -n "$CF_ZONE_ID" ]; then
	zone_id="$CF_ZONE_ID"
fi
if [ -z "$zone_id" ]; then
	check_result "$E_NOTEXIST" "Could not resolve Cloudflare Zone ID for $domain"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

api_url="https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records/$record_id"

answer=$(curl --silent --show-error --max-time 30 \
	--request DELETE "$api_url" \
	--header "Authorization: Bearer $CF_API_TOKEN" \
	--header "Content-Type: application/json")

success=$(echo "$answer" | jq -r '.success // false')
if [ "$success" != "true" ]; then
	err_msg=$(echo "$answer" | jq -r '.errors[0].message // "unknown Cloudflare API error"')
	# A missing/already-deleted record is not fatal during LE cleanup.
	if echo "$err_msg" | grep -qi "could not find\|not exist\|invalid"; then
		$BIN/v-log-action "system" "Info" "DNS" "Cloudflare record $record_id already gone for $domain."
		log_event "$OK" "$ARGUMENTS"
		exit
	fi
	check_result "$E_CONNECT" "Cloudflare API delete failed for $domain (id: $record_id): $err_msg"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "DNS" "Deleted Cloudflare TXT record $record_id for $domain."
log_event "$OK" "$ARGUMENTS"

exit
