#!/bin/bash
# info: start a suspended docker compose application
# options: APP
#
# example: v-unsuspend-docker-app mercanadisyon

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
app=$1

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/docker-app.sh
source $HESTIA/func/docker-app.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'APP'
is_docker_app_format_valid "$app" || check_result "$E_INVALID" "invalid APP name"
is_docker_app_valid "$app" || check_result "$E_NOTEXIST" "docker app '$app' doesn't exist"

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

docker_app_compose "$app" start || check_result "$E_INVALID" "failed to start app '$app'"
docker_app_set "$app" STATE "running"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "Docker" "Docker app resumed (App: $app)."
log_event "$OK" "$ARGUMENTS"

echo "[+] '$app' started (STATE=running)"
exit
