#!/bin/bash
# info: safely set or update an environment secret (.env) for a web domain
# options: USER DOMAIN KEY VALUE
#
# example: v-set-web-domain-env admin neredeyasanir.localhost GEMINI_API_KEY AIzaSy...
#
# This script stores keys inside /home/user/web/domain/public_html/.env with strict permissions (600)
#
# Security: the .env file lives in a directory the customer controls, so all
# file access runs with the customer's own privileges (user_env_edit). A
# root-side touch/chmod/chown here used to follow a planted symlink and hand
# ownership of an arbitrary system file to the customer.

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

check_args '4' "$#" 'USER DOMAIN KEY VALUE'

user=$1
domain=$2
key=$(echo "$3" | sed 's/[^A-Za-z0-9_]//g' | tr '[:lower:]' '[:upper:]')
value=$4

is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
USER_DATA=$HESTIA/data/users/$user
is_object_valid 'web' 'DOMAIN' "$domain"

if [ -z "$key" ]; then
	check_result "$E_INVALID" "invalid secret KEY name"
fi
if [[ "$value" == *$'\n'* ]] || [[ "$value" == *$'\r'* ]]; then
	check_result "$E_INVALID" "secret VALUE must be a single line"
fi

docroot="$HOMEDIR/$user/web/$domain/public_html"
env_file="$docroot/.env"

is_user_path_nosymlink "$docroot"
[ ! -d "$docroot" ] && exit 1

user_env_edit "$env_file" "$key" "$value"
check_result $? "unable to update $env_file" > /dev/null

log_event "$OK" "$user $domain $key [SECRET_MASKED]"
exit 0
