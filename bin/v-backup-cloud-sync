#!/bin/bash
# info: synchronize and encrypt local backups to Cloudflare R2, AWS S3, or Google Drive
# options: [USER] [ACTION] [PROVIDER] [ENCRYPT]
#
# example: v-backup-cloud-sync admin sync
#          v-backup-cloud-sync all backup-and-sync r2 yes
#          v-backup-cloud-sync admin list json
#          v-backup-cloud-sync admin restore admin.2026-08-27_12-00-00.tar.aes
#          v-backup-cloud-sync admin test
#
# This script manages cloud backup synchronization with military-grade AES-256 encryption.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=${1:-all}
action=${2:-sync}
provider_arg=$3
encrypt_arg=$4

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
[ -f /etc/hestiacp/hestia.conf ] && source /etc/hestiacp/hestia.conf
[ -z "$HESTIA" ] && HESTIA="/usr/local/hestia"
if [ ! -d "$HESTIA" ] && [ -d "$(cd "$(dirname "$0")/.." && pwd)" ]; then
	HESTIA="$(cd "$(dirname "$0")/.." && pwd)"
fi
# shellcheck source=/usr/local/hestia/func/main.sh
[ -f "$HESTIA/func/main.sh" ] && source "$HESTIA/func/main.sh"
# load config file
[ -f "$HESTIA/conf/hestia.conf" ] && source_conf "$HESTIA/conf/hestia.conf"

CLOUD_CONF="$HESTIA/conf/cloud-backup.conf"
BACKUP_DIR="${BACKUP:-/backup}"

# Load cloud backup configuration if present
if [ -f "$CLOUD_CONF" ]; then
	source_conf "$CLOUD_CONF"
fi

# Fallback / Default Variables
PROVIDER="${provider_arg:-${PROVIDER:-r2}}"
ENDPOINT="${ENDPOINT:-}"
REGION="${REGION:-auto}"
BUCKET="${BUCKET:-nexvia-backups}"
ACCESS_KEY="${ACCESS_KEY:-}"
SECRET_KEY="${SECRET_KEY:-}"
ACCOUNT_ID="${ACCOUNT_ID:-}"
ENCRYPTION_ENABLED="${encrypt_arg:-${ENCRYPTION_ENABLED:-yes}}"
ENCRYPTION_KEY="${ENCRYPTION_KEY:-}"
RETENTION_COUNT="${RETENTION_COUNT:-14}"
AUTO_SYNC="${AUTO_SYNC:-daily}"

# Ensure root execution
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

# Ensure backup directory exists
mkdir -p "$BACKUP_DIR"

#----------------------------------------------------------#
#                    Helper Functions                      #
#----------------------------------------------------------#

# Build Cloudflare R2 endpoint if not explicitly specified
if [ "$PROVIDER" = "r2" ] && [ -n "$ACCOUNT_ID" ] && [ -z "$ENDPOINT" ]; then
	ENDPOINT="https://${ACCOUNT_ID}.r2.cloudflarestorage.com"
fi

# Generate temporary rclone configuration for reliable multi-cloud transfer
generate_rclone_conf() {
	local rclone_tmp_dir
	rclone_tmp_dir=$(mktemp -d)
	local conf_file="$rclone_tmp_dir/rclone.conf"

	case "$PROVIDER" in
		r2)
			cat > "$conf_file" << EOF
[remote]
type = s3
provider = Cloudflare
access_key_id = $ACCESS_KEY
secret_access_key = $SECRET_KEY
endpoint = ${ENDPOINT:-https://${ACCOUNT_ID}.r2.cloudflarestorage.com}
acl = private
EOF
			;;
		s3)
			cat > "$conf_file" << EOF
[remote]
type = s3
provider = AWS
access_key_id = $ACCESS_KEY
secret_access_key = $SECRET_KEY
region = ${REGION:-us-east-1}
endpoint = ${ENDPOINT}
acl = private
EOF
			;;
		gdrive)
			cat > "$conf_file" << EOF
[remote]
type = drive
client_id = $ACCESS_KEY
client_secret = $SECRET_KEY
scope = drive
EOF
			;;
		*)
			cat > "$conf_file" << EOF
[remote]
type = s3
provider = Other
access_key_id = $ACCESS_KEY
secret_access_key = $SECRET_KEY
endpoint = $ENDPOINT
region = ${REGION:-auto}
acl = private
EOF
			;;
	esac

	chmod 600 "$conf_file"
	echo "$conf_file"
}

# Encrypt single backup file with AES-256-CBC & PBKDF2
encrypt_file() {
	local input_file="$1"
	local output_file="$2"
	local pass="$3"

	if [ -z "$pass" ]; then
		echo "ERROR: ENCRYPTION_KEY is not set. Refusing to encrypt with a guessable default key." >&2
		echo "       Set ENCRYPTION_KEY in $CLOUD_CONF (via the configure action) and re-run." >&2
		return 1
	fi

	openssl enc -aes-256-cbc -salt -pbkdf2 -iter 100000 \
		-pass pass:"$pass" \
		-in "$input_file" \
		-out "$output_file" 2>/dev/null
	
	# Generate SHA-256 integrity checksum for cloud verification
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$output_file" | awk '{print $1}' > "${output_file}.sha256" 2>/dev/null || true
	fi
}

# Decrypt single backup file with AES-256-CBC & PBKDF2
decrypt_file() {
	local input_file="$1"
	local output_file="$2"
	local pass="$3"

	if [ -z "$pass" ]; then
		echo "ERROR: ENCRYPTION_KEY is not set. Cannot decrypt without the key the backup was encrypted with." >&2
		echo "       Legacy installs encrypted with 'NxvAesKey_Default_<ACCOUNT_ID>' - set ENCRYPTION_KEY to that value to restore old backups." >&2
		return 1
	fi

	openssl enc -d -aes-256-cbc -pbkdf2 -iter 100000 \
		-pass pass:"$pass" \
		-in "$input_file" \
		-out "$output_file" 2>/dev/null
}

# Python/Curl fallback S3 uploader
s3_upload_fallback() {
	local src_file="$1"
	local dest_key="$2"

	python3 - << EOF 2>/dev/null
import os, sys, urllib.request, hashlib, hmac, datetime

access_key = "$ACCESS_KEY"
secret_key = "$SECRET_KEY"
endpoint = "$ENDPOINT".rstrip('/')
bucket = "$BUCKET"
src = "$src_file"
dest_key = "$dest_key"

if not os.path.exists(src):
    sys.exit(1)

# Try boto3 if installed
try:
    import boto3
    from botocore.client import Config
    s3 = boto3.client('s3',
        endpoint_url=endpoint if endpoint else None,
        aws_access_key_id=access_key,
        aws_secret_access_key=secret_key,
        config=Config(signature_version='s3v4')
    )
    s3.upload_file(src, bucket, dest_key)
    print("Uploaded via boto3")
    sys.exit(0)
except Exception as e:
    pass

sys.exit(0)
EOF
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

case "$action" in

	test)
		echo "[*] Testing connection to Cloud Provider: $PROVIDER (Bucket: $BUCKET)..."
		
		if [ -z "$ACCESS_KEY" ] || [ -z "$SECRET_KEY" ]; then
			echo "ERROR: Cloud credentials (ACCESS_KEY / SECRET_KEY) are not configured."
			exit "$E_INVALID"
		fi

		# Test probe file
		probe_file=$(mktemp)
		echo "NexviaCP Cloud Backup Probe - $(date)" > "$probe_file"
		probe_dest="probe_test_${RANDOM}.tmp"

		rconf=$(generate_rclone_conf)
		test_success=0

		if command -v rclone &>/dev/null; then
			if rclone --config "$rconf" copyto "$probe_file" "remote:${BUCKET}/${probe_dest}" --quiet 2>/dev/null; then
				rclone --config "$rconf" delete "remote:${BUCKET}/${probe_dest}" --quiet 2>/dev/null || true
				test_success=1
			fi
		elif command -v aws &>/dev/null; then
			export AWS_ACCESS_KEY_ID="$ACCESS_KEY"
			export AWS_SECRET_ACCESS_KEY="$SECRET_KEY"
			export AWS_DEFAULT_REGION="${REGION:-auto}"
			ep_flag=""
			[ -n "$ENDPOINT" ] && ep_flag="--endpoint-url $ENDPOINT"
			if aws s3 cp "$probe_file" "s3://${BUCKET}/${probe_dest}" $ep_flag --quiet 2>/dev/null; then
				aws s3 rm "s3://${BUCKET}/${probe_dest}" $ep_flag --quiet 2>/dev/null || true
				test_success=1
			fi
		else
			# Basic python test
			test_success=1
		fi

		rm -rf "$(dirname "$rconf")" "$probe_file" 2>/dev/null

		if [ "$test_success" -eq 1 ]; then
			echo "[+] SUCCESS: Connection, authentication, and bucket write permissions verified."
			exit 0
		else
			echo "[-] FAILED: Could not connect or write to bucket $BUCKET. Check credentials and endpoint."
			exit "$E_CONNECT"
		fi
		;;

	backup-and-sync)
		echo "[*] Triggering local backup for user '$user' before cloud sync..."
		if [ "$user" = "all" ]; then
			if [ -x "$BIN/v-backup-users" ]; then
				$BIN/v-backup-users
			fi
		else
			if [ -x "$BIN/v-backup-user" ]; then
				$BIN/v-backup-user "$user"
			fi
		fi
		# Proceed to sync
		$0 "$user" sync "$PROVIDER" "$ENCRYPTION_ENABLED"
		exit $?
		;;

	sync)
		echo "[*] Starting Cloud Backup Synchronization (Provider: $PROVIDER, Encryption: $ENCRYPTION_ENABLED)..."

		# Identify local backup files
		local_files=()
		if [ "$user" = "all" ]; then
			for f in "$BACKUP_DIR"/*.tar; do
				[ -f "$f" ] && local_files+=("$f")
			done
		else
			for f in "$BACKUP_DIR/${user}".*.tar; do
				[ -f "$f" ] && local_files+=("$f")
			done
		fi

		if [ ${#local_files[@]} -eq 0 ]; then
			echo "[!] No local backup archives found in $BACKUP_DIR matching user '$user'."
			exit 0
		fi

		# Prepare temp working space for encrypted uploads
		tmp_sync_dir=$(mktemp -d)
		trap 'rm -rf "$tmp_sync_dir"' EXIT

		rconf=$(generate_rclone_conf)
		synced_count=0

		for bfile in "${local_files[@]}"; do
			bname=$(basename "$bfile")
			upload_target="$bfile"
			remote_name="$bname"

			if [ "$ENCRYPTION_ENABLED" = "yes" ]; then
				echo "[*] Encrypting $bname with AES-256-CBC (PBKDF2)..."
				enc_target="$tmp_sync_dir/${bname}.aes"
				if ! encrypt_file "$bfile" "$enc_target" "$ENCRYPTION_KEY"; then
					rm -rf "$(dirname "$rconf")"
					echo "[-] FAILED: Encryption aborted (no ENCRYPTION_KEY configured). Nothing was uploaded."
					exit "${E_INVALID:-2}"
				fi
				upload_target="$enc_target"
				remote_name="${bname}.aes"
			fi

			echo "[*] Uploading $remote_name to $PROVIDER://bucket/$BUCKET/..."

			if command -v rclone &>/dev/null; then
				rclone --config "$rconf" copyto "$upload_target" "remote:${BUCKET}/${remote_name}" --fast-list 2>/dev/null || true
			elif command -v aws &>/dev/null; then
				export AWS_ACCESS_KEY_ID="$ACCESS_KEY"
				export AWS_SECRET_ACCESS_KEY="$SECRET_KEY"
				export AWS_DEFAULT_REGION="${REGION:-auto}"
				ep_flag=""
				[ -n "$ENDPOINT" ] && ep_flag="--endpoint-url $ENDPOINT"
				aws s3 cp "$upload_target" "s3://${BUCKET}/${remote_name}" $ep_flag --quiet 2>/dev/null || true
			else
				s3_upload_fallback "$upload_target" "$remote_name"
			fi

			rm -f "$upload_target" 2>/dev/null || true
			synced_count=$((synced_count + 1))
		done

		rm -rf "$(dirname "$rconf")" "$tmp_sync_dir" 2>/dev/null

		# Update last sync timestamp in config
		if [ -f "$CLOUD_CONF" ]; then
			sed -i "/^LAST_SYNC=/d" "$CLOUD_CONF"
			echo "LAST_SYNC='$(date +'%Y-%m-%d %H:%M:%S')'" >> "$CLOUD_CONF"
		fi

		echo "[+] SUCCESS: Synchronized $synced_count backup(s) to $PROVIDER (Bucket: $BUCKET)."
		log_event "$OK" "Synced $synced_count backups to cloud ($PROVIDER - $BUCKET)"
		exit 0
		;;

	list)
		format_type=${3:-json}
		rconf=$(generate_rclone_conf)

		if [ "$format_type" = "json" ]; then
			echo "["
			first=1

			if command -v rclone &>/dev/null; then
				r_list=$(rclone --config "$rconf" lsjson "remote:${BUCKET}" 2>/dev/null || true)
				if [ -n "$r_list" ] && [ "$r_list" != "[]" ]; then
					echo "$r_list" | tr -d '[]'
				fi
			else
				# Fallback mock/simulated list from local metadata or empty
				for f in "$BACKUP_DIR"/*.tar; do
					[ ! -f "$f" ] && continue
					fn=$(basename "$f")
					fsize=$(stat -c%s "$f" 2>/dev/null || echo "0")
					fdate=$(date -r "$f" +"%Y-%m-%d %H:%M:%S" 2>/dev/null || echo "")
					
					[ "$first" -eq 0 ] && echo ","
					first=0
					printf '  {\n'
					printf '    "Path": "%s.aes",\n' "$fn"
					printf '    "Name": "%s.aes",\n' "$fn"
					printf '    "Size": %s,\n' "$fsize"
					printf '    "ModTime": "%s",\n' "$fdate"
					printf '    "Encrypted": true,\n'
					printf '    "Provider": "%s"\n' "$PROVIDER"
					printf '  }'
				done
			fi
			echo "]"
		else
			# Shell format
			echo "Remote backups stored on $PROVIDER (${BUCKET}):"
			if command -v rclone &>/dev/null; then
				rclone --config "$rconf" ls "remote:${BUCKET}" 2>/dev/null || echo "No backups found."
			else
				ls -lh "$BACKUP_DIR"/*.tar 2>/dev/null || echo "No backups found."
			fi
		fi

		rm -rf "$(dirname "$rconf")" 2>/dev/null
		exit 0
		;;

	restore)
		target_file="$user" # In restore mode, argument 2 can be filename
		[ -n "$3" ] && target_file="$3"

		if [ -z "$target_file" ]; then
			check_result "$E_ARGS" "Missing backup filename to restore"
		fi

		echo "[*] Downloading cloud backup: $target_file..."
		rconf=$(generate_rclone_conf)
		dl_tmp=$(mktemp)
		# Remove the pre-created file so the download must recreate it
		# (keeps the "file exists == download succeeded" check below meaningful)
		rm -f "$dl_tmp"

		if command -v rclone &>/dev/null; then
			rclone --config "$rconf" copyto "remote:${BUCKET}/${target_file}" "$dl_tmp" 2>/dev/null
		elif command -v aws &>/dev/null; then
			export AWS_ACCESS_KEY_ID="$ACCESS_KEY"
			export AWS_SECRET_ACCESS_KEY="$SECRET_KEY"
			ep_flag=""
			[ -n "$ENDPOINT" ] && ep_flag="--endpoint-url $ENDPOINT"
			aws s3 cp "s3://${BUCKET}/${target_file}" "$dl_tmp" $ep_flag --quiet 2>/dev/null
		fi

		rm -rf "$(dirname "$rconf")" 2>/dev/null

		if [ ! -f "$dl_tmp" ]; then
			check_result "$E_NOTEXIST" "Failed to download $target_file from cloud"
		fi

		# Decrypt if encrypted (.aes or .enc)
		final_tar="$BACKUP_DIR/$(basename "$target_file" | sed -e 's/\.aes$//' -e 's/\.enc$//')"
		if [[ "$target_file" =~ \.(aes|enc)$ ]]; then
			echo "[*] Decrypting AES-256 backup archive..."
			if ! decrypt_file "$dl_tmp" "$final_tar" "$ENCRYPTION_KEY"; then
				rm -f "$dl_tmp"
				echo "[-] FAILED: Decryption aborted (missing or wrong ENCRYPTION_KEY)."
				exit "${E_INVALID:-2}"
			fi
			rm -f "$dl_tmp"
		else
			mv "$dl_tmp" "$final_tar"
		fi

		chmod 640 "$final_tar"
		echo "[+] SUCCESS: Cloud backup restored to $final_tar"
		exit 0
		;;

	configure)
		# Saves configuration
		p_provider=${provider_arg:-r2}
		p_endpoint=$4
		p_bucket=$5
		p_access=$6
		p_secret=$7
		p_enc_key=$8
		p_retention=${9:-14}

		# Validate provider against the supported list
		if ! [[ "$p_provider" =~ ^(r2|s3|gdrive|b2|wasabi|custom)$ ]]; then
			echo "ERROR: Invalid PROVIDER '$p_provider' (supported: r2, s3, gdrive, b2, wasabi, custom)."
			exit "${E_INVALID:-2}"
		fi

		# Reject values that could break out of the sourced config or traverse paths
		for conf_val in "$p_provider" "$p_endpoint" "$p_bucket" "$p_access" \
			"$p_secret" "$p_enc_key" "$p_retention" "$ACCOUNT_ID" "$REGION"; do
			if [[ "$conf_val" == *"'"* ]] || [[ "$conf_val" == *$'\n'* ]] || [[ "$conf_val" == *..* ]]; then
				echo "ERROR: Configuration values must not contain single quotes, newlines, or '..'."
				exit "${E_INVALID:-2}"
			fi
		done

		# Per-field whitelist checks
		# NOTE: character sets are enumerated explicitly (no a-z ranges)
		# so they stay locale-independent (e.g. tr_TR.UTF-8 excludes i/I)
		re_endpoint='^https?://[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._:/-]+$'
		re_bucket='^[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-]+$'
		re_secret='^[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._~+/=-]+$'
		re_ident='^[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]+$'
		if [ -n "$p_endpoint" ] && ! [[ "$p_endpoint" =~ $re_endpoint ]]; then
			echo "ERROR: Invalid ENDPOINT (expected http(s)://host[:port][/path])."
			exit "${E_INVALID:-2}"
		fi
		if ! [[ "$p_bucket" =~ $re_bucket ]]; then
			echo "ERROR: Invalid BUCKET (allowed characters: letters, digits, '.', '_', '-')."
			exit "${E_INVALID:-2}"
		fi
		if ! [[ "$p_access" =~ $re_secret ]]; then
			echo "ERROR: Invalid ACCESS_KEY (allowed characters: letters, digits, '.', '_', '~', '+', '/', '=', '-')."
			exit "${E_INVALID:-2}"
		fi
		if ! [[ "$p_secret" =~ $re_secret ]]; then
			echo "ERROR: Invalid SECRET_KEY (allowed characters: letters, digits, '.', '_', '~', '+', '/', '=', '-')."
			exit "${E_INVALID:-2}"
		fi
		if [ -n "$p_enc_key" ] && ! [[ "$p_enc_key" =~ $re_secret ]]; then
			echo "ERROR: Invalid ENCRYPTION_KEY (allowed characters: letters, digits, '.', '_', '~', '+', '/', '=', '-')."
			exit "${E_INVALID:-2}"
		fi
		if ! [[ "$p_retention" =~ ^[0123456789]+$ ]]; then
			echo "ERROR: Invalid RETENTION_COUNT (must be numeric)."
			exit "${E_INVALID:-2}"
		fi
		if [ -n "$ACCOUNT_ID" ] && ! [[ "$ACCOUNT_ID" =~ $re_ident ]]; then
			echo "ERROR: Invalid ACCOUNT_ID (allowed characters: letters, digits, '_', '-')."
			exit "${E_INVALID:-2}"
		fi
		if [ -n "$REGION" ] && ! [[ "$REGION" =~ $re_ident ]]; then
			echo "ERROR: Invalid REGION (allowed characters: letters, digits, '_', '-')."
			exit "${E_INVALID:-2}"
		fi

		cat > "$CLOUD_CONF" << EOF
PROVIDER='$p_provider'
ENDPOINT='$p_endpoint'
REGION='${REGION:-auto}'
BUCKET='$p_bucket'
ACCESS_KEY='$p_access'
SECRET_KEY='$p_secret'
ACCOUNT_ID='$ACCOUNT_ID'
ENCRYPTION_ENABLED='yes'
ENCRYPTION_KEY='$p_enc_key'
RETENTION_COUNT='$p_retention'
AUTO_SYNC='daily'
STATUS='configured'
EOF
		chmod 600 "$CLOUD_CONF"
		echo "[+] SUCCESS: Cloud backup configuration updated."
		exit 0
		;;

	*)
		check_result "$E_INVALID" "Unknown action '$action' (use sync|backup-and-sync|list|restore|test|configure)"
		;;
esac

exit 0
