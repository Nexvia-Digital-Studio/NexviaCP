#!/bin/bash
# info: create Cloudflare DNS records (MX, SPF, DKIM, DMARC, mail A) for a mail domain
# options: USER DOMAIN
#
# example: v-add-remote-dns-mail-cloudflare admin example.com
#
# Uses the Cloudflare API v4 to automatically provision essential mail records:
#   - A:     mail.example.com -> server IP (proxied: false)
#   - CNAME: webmail.example.com -> mail.example.com (proxied: false)
#   - MX:    example.com -> mail.example.com (priority: 10)
#   - TXT:   example.com -> v=spf1 a mx ip4:<IP> ~all (SPF)
#   - TXT:   mail._domainkey.example.com -> v=DKIM1; k=rsa; p=... (DKIM)
#   - TXT:   _dmarc.example.com -> v=DMARC1; p=quarantine; sp=none; (DMARC)
# Requires DNS_API_PROVIDER=cloudflare and CF_API_TOKEN in hestia.conf.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/ip.sh
source $HESTIA/func/ip.sh
# shellcheck source=/usr/local/hestia/func/domain.sh
source $HESTIA/func/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Cloudflare API helper function
cf_api() {
	local method="$1"
	local endpoint="$2"
	local data="$3"
	if [ -n "$data" ]; then
		printf 'header = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\n' "$CF_API_TOKEN" | \
			curl --silent --show-error --max-time 30 -K - \
				--request "$method" "https://api.cloudflare.com/client/v4$endpoint" \
				--data "$data"
	else
		printf 'header = "Authorization: Bearer %s"\n' "$CF_API_TOKEN" | \
			curl --silent --show-error --max-time 30 -K - \
				--request "$method" "https://api.cloudflare.com/client/v4$endpoint"
	fi
}

# Resolve zone ID by walking up domain hierarchy
resolve_zone_id() {
	local target="$1"
	local cur="$target"
	local zid=""
	while [ -n "$cur" ]; do
		zid=$(cf_api GET "/zones?name=$cur" | jq -r '.result[0].id // empty')
		if [ -n "$zid" ]; then
			echo "$zid"
			return 0
		fi
		if [[ "$cur" == *.* ]]; then
			cur="${cur#*.}"
		else
			break
		fi
	done
	return 1
}

# Add standard DNS record idempotently
cf_add_record() {
	local rec_name="$1"
	local rec_type="$2"
	local rec_content="$3"
	local rec_proxied="${4:-false}"

	local existing_id
	existing_id=$(cf_api GET "/zones/$zone_id/dns_records?type=$rec_type&name=$rec_name" | jq -r '.result[0].id // empty')
	if [ -n "$existing_id" ]; then
		return 0
	fi

	local rec_payload rec_resp rec_success
	rec_payload=$(jq -nc \
		--arg name "$rec_name" \
		--arg type "$rec_type" \
		--arg content "$rec_content" \
		--argjson proxied "$rec_proxied" \
		'{type:$type, name:$name, content:$content, ttl:1, proxied:$proxied}')

	rec_resp=$(cf_api POST "/zones/$zone_id/dns_records" "$rec_payload")
	rec_success=$(echo "$rec_resp" | jq -r '.success // false')
	if [ "$rec_success" != "true" ]; then
		local rec_err
		rec_err=$(echo "$rec_resp" | jq -r '.errors[0].message // "Failed to create record"')
		$BIN/v-log-action "system" "Warning" "DNS" "Cloudflare record create failed for $rec_name ($rec_type): $rec_err"
		return 1
	fi
	return 0
}

# Add MX record idempotently checking content
cf_add_mx_record() {
	local rec_name="$1"
	local rec_content="$2"
	local rec_priority="${3:-10}"

	local matching_id
	matching_id=$(cf_api GET "/zones/$zone_id/dns_records?type=MX&name=$rec_name" | jq -r --arg content "$rec_content" '.result[] | select(.content == $content) | .id // empty' | head -n1)
	if [ -n "$matching_id" ]; then
		return 0
	fi

	local rec_payload rec_resp rec_success
	rec_payload=$(jq -nc \
		--arg name "$rec_name" \
		--arg content "$rec_content" \
		--argjson priority "$rec_priority" \
		'{type:"MX", name:$name, content:$content, priority:$priority, ttl:1}')

	rec_resp=$(cf_api POST "/zones/$zone_id/dns_records" "$rec_payload")
	rec_success=$(echo "$rec_resp" | jq -r '.success // false')
	if [ "$rec_success" != "true" ]; then
		local rec_err
		rec_err=$(echo "$rec_resp" | jq -r '.errors[0].message // "Failed to create MX record"')
		$BIN/v-log-action "system" "Warning" "DNS" "Cloudflare MX create failed for $rec_name: $rec_err"
		return 1
	fi
	return 0
}

# Sync or merge SPF TXT record (preserves existing SPF while ensuring server IP is authorized)
cf_sync_spf_record() {
	local rec_name="$1"
	local target_ip="$2"
	local ip_token="ip4:$target_ip"

	local txt_records spf_record_id spf_content
	txt_records=$(cf_api GET "/zones/$zone_id/dns_records?type=TXT&name=$rec_name")
	spf_record_id=$(echo "$txt_records" | jq -r '.result[] | select(.content | startswith("v=spf1")) | .id // empty' | head -n1)
	spf_content=$(echo "$txt_records" | jq -r '.result[] | select(.content | startswith("v=spf1")) | .content // empty' | head -n1)

	if [ -z "$spf_record_id" ]; then
		local default_spf="v=spf1 a mx ip4:$target_ip ~all"
		local payload
		payload=$(jq -nc --arg name "$rec_name" --arg content "$default_spf" \
			'{type:"TXT", name:$name, content:$content, ttl:1, proxied:false}')
		cf_api POST "/zones/$zone_id/dns_records" "$payload" >/dev/null 2>&1
	else
		if [[ "$spf_content" =~ $ip_token ]]; then
			return 0
		fi
		local new_content
		if [[ "$spf_content" =~ (\~all|\-all|\?all|\+all) ]]; then
			new_content=$(echo "$spf_content" | sed -E "s/(\~all|\-all|\?all|\+all)/$ip_token \1/")
		else
			new_content="$spf_content $ip_token ~all"
		fi
		local payload
		payload=$(jq -nc --arg name "$rec_name" --arg content "$new_content" \
			'{type:"TXT", name:$name, content:$content, ttl:1, proxied:false}')
		cf_api PUT "/zones/$zone_id/dns_records/$spf_record_id" "$payload" >/dev/null 2>&1
		$BIN/v-log-action "system" "Info" "DNS" "Updated Cloudflare SPF record for $rec_name to include $ip_token."
	fi
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
check_hestia_demo_mode

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

# Exit silently if Cloudflare provider is not configured or auto zone is disabled
if [ "$DNS_API_PROVIDER" != "cloudflare" ]; then
	exit 0
fi

if [ "${CF_AUTO_ZONE:-yes}" = "no" ]; then
	exit 0
fi

if [ -z "$CF_API_TOKEN" ]; then
	check_result "$E_NOTEXIST" "CF_API_TOKEN is not configured"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# 1) Determine IP address for mail domain
local_ip=""
if [ -f "$HOMEDIR/$user/conf/mail/$domain/ip" ]; then
	local_ip=$(cat "$HOMEDIR/$user/conf/mail/$domain/ip" 2>/dev/null | tr -d '\n\r ')
fi
if [ -z "$local_ip" ]; then
	web_ip=$(get_object_value 'web' 'DOMAIN' "$domain" '$IP' 2>/dev/null)
	if [ -n "$web_ip" ]; then
		local_ip=$(get_real_ip "$web_ip")
	fi
fi
if [ -z "$local_ip" ]; then
	if [ -d "$HESTIA/data/ips" ]; then
		local_ip=$(ls "$HESTIA/data/ips" 2>/dev/null | head -1)
	fi
fi
if [ -z "$local_ip" ] && [ -n "$IP" ]; then
	local_ip=$(get_real_ip "$IP")
fi

if [ -z "$local_ip" ]; then
	check_result "$E_NOTEXIST" "Cannot determine server IP for mail domain $domain"
fi

# 2) Resolve or create Cloudflare zone
zone_id=$(resolve_zone_id "$domain")

if [ -z "$zone_id" ]; then
	account_id="$CF_ACCOUNT_ID"
	if [ -z "$account_id" ]; then
		account_id=$(cf_api GET "/zones?per_page=1" | jq -r '.result[0].account.id // empty')
	fi
	if [ -z "$account_id" ]; then
		account_id=$(cf_api GET "/accounts?per_page=1" | jq -r '.result[0].id // empty')
	fi

	if [ -n "$account_id" ]; then
		zone_payload=$(jq -nc --arg n "$domain" --arg a "$account_id" \
			'{name:$n, account:{id:$a}, type:"full"}')
		zone_json=$(cf_api POST "/zones" "$zone_payload")
		success=$(echo "$zone_json" | jq -r '.success // false')
		if [ "$success" = "true" ]; then
			zone_id=$(echo "$zone_json" | jq -r '.result.id')
			ns_array=$(echo "$zone_json" | jq -r '.result.name_servers[]? // empty')
			ns_list=$(echo "$ns_array" | paste -sd ", " -)
			if [ -n "$ns_list" ]; then
				$BIN/v-log-action "system" "Info" "DNS" "Cloudflare zone $domain created, assigned NS: $ns_list"
				if [ -x "$BIN/v-add-user-notification" ]; then
					$BIN/v-add-user-notification "admin" "Cloudflare NS Yönlendirmesi Gerekli: $domain" "Yeni Cloudflare DNS alanı oluşturuldu. Lütfen domain kayıt firmanızda (Registrar) nameserver adreslerini şu şekilde güncelleyin:<br><strong>$ns_list</strong>" "warning" >/dev/null 2>&1 || true
				fi
				if [ -x "$BIN/v-send-sys-notification" ]; then
					notif_sub="[DNS Yönlendirmesi] Cloudflare NS Atandı: $domain"
					notif_body="Yeni mail domaini için Cloudflare DNS alanı (zone) oluşturuldu.\n\nDomain: $domain\nAtanan Cloudflare Nameserver (NS) Adresleri:\n$ns_list\n\nMail gönderimi ve DNS kayıtlarının doğrulanması için domain kayıt firmanızın yönetim panelinden NS kayıtlarını yukarıdaki adreslerle güncelleyin."
					notif_extra=$(jq -nc --arg d "$domain" --arg ns "$ns_list" '{"service":"Cloudflare DNS","status":"NS_DELEGATION_REQUIRED","domain":$d,"name_servers":$ns}')
					$BIN/v-send-sys-notification "$notif_sub" "$notif_body" "WARNING" "" "dns_ns_assigned" "$notif_extra" >/dev/null 2>&1 &
				fi
			fi
		fi
	fi
fi

if [ -z "$zone_id" ]; then
	check_result "$E_NOTEXIST" "Could not resolve Cloudflare Zone ID for $domain"
fi

# 3) Provision Mail DNS Records

# A record for mail subdomain (Grey cloud mandatory for SMTP/IMAP traffic)
cf_add_record "mail.$domain" "A" "$local_ip" "false"

# CNAME record for webmail subdomain
cf_add_record "webmail.$domain" "CNAME" "mail.$domain" "false"

# MX record
cf_add_mx_record "$domain" "mail.$domain" 10

# SPF TXT record (intelligent merge)
cf_sync_spf_record "$domain" "$local_ip"

# DKIM TXT record
if [ -f "$USER_DATA/mail/$domain.pub" ]; then
	dkim_pub=$(cat "$USER_DATA/mail/$domain.pub" | grep -v ' KEY---' | tr -d '\n\r ')
	if [ -n "$dkim_pub" ]; then
		cf_add_record "mail._domainkey.$domain" "TXT" "v=DKIM1; k=rsa; p=$dkim_pub" "false"
	fi
fi

# DMARC TXT record
cf_add_record "_dmarc.$domain" "TXT" "v=DMARC1; p=quarantine; sp=none;" "false"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "$user" "Info" "DNS" "Configured Cloudflare mail DNS records (MX, SPF, DKIM, DMARC) for $domain."
log_event "$OK" "$ARGUMENTS"

exit 0
