#!/bin/bash
# info: 1-click deploy web application or API from GitHub repository
# options: USER DOMAIN REPO [BRANCH] [APP_MODE]
#
# example: v-deploy-github-repo admin neredeyasanir.localhost Nexvia-Nerede-Yasanir main auto
#
# This script deploys PHP, Node.js, React, Django/Python, .NET websites & APIs directly from GitHub.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
repo_input=$3
branch=${4:-main}
app_mode=${5:-auto}
env_file=${6:-}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN REPO [BRANCH] [APP_MODE] [ENV_FILE]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

# Build full git repository URL
repo_url="$repo_input"
if [[ ! "$repo_input" =~ ^https?:// ]] && [[ ! "$repo_input" =~ ^git@ ]]; then
	if [ -d "$repo_input" ]; then
		# local repository directory (tests / pre-staged code)
		repo_slug=$(basename "$repo_input" | sed -e 's#\.git$##')
	elif [ -n "$GITHUB_ORG" ]; then
		repo_url="https://github.com/${GITHUB_ORG}/${repo_input}.git"
	else
		check_result "$E_INVALID" "GitHub token/org not configured. Provide full git URL."
	fi
fi

# Human-readable repo slug used for DB naming: bare repo names stay as-is,
# full URLs (any GitHub repo, not just our org) reduce to owner_repo —
# otherwise every URL deploy would collide on the same "https_github..." db.
# (A local-dir source may have set repo_slug already.)
if [ -z "$repo_slug" ]; then
	repo_slug="$repo_input"
	if [[ "$repo_input" =~ ^https?:// ]] || [[ "$repo_input" =~ ^git@ ]]; then
		repo_slug=$(echo "$repo_input" | sed -e 's#\.git/*$##' -e 's#^\(https\{0,1\}://[^/]*/\|git@[^:]*:\)##' -e 's#/#_#g')
	fi
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

echo "[*] Step 1: Checking Web Domain $domain for user $user..."
if ! $BIN/v-list-web-domain "$user" "$domain" >/dev/null 2>&1; then
	echo "[*] Creating web domain $domain..."
	$BIN/v-add-web-domain "$user" "$domain"
fi

docroot="$HOMEDIR/$user/web/$domain/public_html"
mkdir -p "$docroot"

echo "[*] Step 2: Cloning repository into $docroot..."
# Authenticated clone without embedding the PAT in the URL (it would be
# visible on the process command line via /proc): credentials are supplied
# through a GIT_ASKPASS helper instead.

# Secure temporary directory with auto-cleanup
tmp_dir=$(mktemp -d -t nexvia_deploy_XXXXXX)
trap 'rm -rf "$tmp_dir"' EXIT
tmp_clone="$tmp_dir/clone"
mkdir -p "$tmp_clone"

if [ -n "$GITHUB_TOKEN" ] && [[ "$repo_url" =~ ^https://github.com/ ]]; then
	askpass="$tmp_dir/askpass.sh"
	printf '#!/bin/sh\nprintf "%%s\\n" "$NEXVIA_GIT_TOKEN"\n' > "$askpass"
	chmod 700 "$askpass"
	echo "[*] Fetching branch '$branch' from $repo_input (authenticated)..."
	if ! NEXVIA_GIT_TOKEN="$GITHUB_TOKEN" GIT_ASKPASS="$askpass" GIT_TERMINAL_PROMPT=0 git -c credential.helper= clone --depth 1 -b "$branch" "$repo_url" "$tmp_clone" 2>/dev/null; then
		if ! NEXVIA_GIT_TOKEN="$GITHUB_TOKEN" GIT_ASKPASS="$askpass" GIT_TERMINAL_PROMPT=0 git -c credential.helper= clone --depth 1 "$repo_url" "$tmp_clone" 2>/dev/null; then
			check_result "$E_CONNECT" "Git clone failed. Please check repository name and GitHub Token permissions."
		fi
	fi
else
	if [ -d "$repo_url" ]; then
		# local dir: silence "dubious ownership" (fixture repos owned by other users)
		git -c safe.directory='*' clone --depth 1 -b "$branch" "$repo_url" "$tmp_clone" 2>/dev/null \
			|| git -c safe.directory='*' clone --depth 1 "$repo_url" "$tmp_clone" 2>/dev/null \
			|| check_result "$E_CONNECT" "Git clone failed. Check repository path/branch."
	else
		echo "[*] Fetching branch '$branch' from $repo_input..."
		if ! git clone --depth 1 -b "$branch" "$repo_url" "$tmp_clone" 2>/dev/null; then
			# Fallback to default branch
			if ! git clone --depth 1 "$repo_url" "$tmp_clone" 2>/dev/null; then
				check_result "$E_CONNECT" "Git clone failed. Please check repository name and access."
			fi
		fi
	fi
fi

# Step 2.1: Snapshot current docroot before overwriting (rollback support).
# Snapshots are stored OUTSIDE the docroot ($HESTIA/data/users/...), which is a
# completely separate tree from $HOMEDIR, so the archive never recurses into
# previous snapshots. Everything in the docroot is included (.git, .env,
# vendor/, node_modules/) so a rollback restores a faithful, deployable state.
# A snapshot failure must NEVER block the deploy itself: log & continue.
releases_dir="$HESTIA/data/users/$user/web/$domain/releases"
if [ -d "$docroot" ] && [ -n "$(ls -A "$docroot" 2>/dev/null)" ]; then
	release_ts=$(date +%Y%m%d%H%M%S)
	release_file="$releases_dir/release-${release_ts}.tar.gz"
	echo "[*] Snapshotting current docroot to $release_file..."
	mkdir -p "$releases_dir"
	chmod 700 "$releases_dir"
	snap_rc=0
	tar --warning=no-file-changed -C "$docroot" -czf "$release_file" . >/dev/null 2>&1 || snap_rc=$?
	# rc=1 means "some files changed while being archived" (live site) and is
	# tolerated; rc>=2 is a fatal archive error.
	if [ "$snap_rc" -le 1 ] && [ -s "$release_file" ]; then
		echo "[+] Snapshot created: release-${release_ts}.tar.gz"
		# Retention: keep the 5 newest plain snapshots (fixed-width timestamps
		# sort chronologically). Safety snapshots (*-pre-rollback.tar.gz) are
		# never pruned here — they are owned by v-rollback-web-domain-deploy.
		snap_count=$(ls -1 "$releases_dir" 2>/dev/null | grep -c '^release-[0-9]\{14\}\.tar\.gz$')
		if [ "${snap_count:-0}" -gt 5 ]; then
			ls -1 "$releases_dir" | grep '^release-[0-9]\{14\}\.tar\.gz$' | sort | head -n $((snap_count - 5)) \
				| while read -r old_snapshot; do
					rm -f "$releases_dir/$old_snapshot"
				done
		fi
	else
		rm -f "$release_file"
		echo "[!] WARNING: pre-deploy snapshot failed (tar rc=$snap_rc) — continuing deploy without snapshot."
		log_event "$E_PARSING" "pre-deploy snapshot failed for $domain (tar rc=$snap_rc), deploy continued"
	fi
fi

# Backup existing .env if present
env_backup="$tmp_dir/env_backup"
[ -f "$docroot/.env" ] && cp "$docroot/.env" "$env_backup"

# Move files to docroot
rm -rf "$docroot"/* "$docroot"/.[!.]* 2>/dev/null || true
cp -r "$tmp_clone"/* "$docroot"/ 2>/dev/null || true
cp -r "$tmp_clone"/.[!.]* "$docroot"/ 2>/dev/null || true

# Strip token from remote URL in git config for security
git -C "$docroot" remote set-url origin "$repo_url" 2>/dev/null || true

# Restore or initialize .env
if [ -f "$env_backup" ]; then
	mv "$env_backup" "$docroot/.env"
elif [ -f "$docroot/.env.example" ]; then
	cp "$docroot/.env.example" "$docroot/.env"
else
	touch "$docroot/.env"
fi

# Merge wizard-supplied environment values (KEY=VALUE lines, created by the
# panel from the analyze-repo env template). Only well-formed keys are
# accepted; DB credentials injected below always win, so the wizard cannot
# corrupt auto-provisioned values.
if [ -n "$env_file" ] && [ -f "$env_file" ]; then
	echo "[*] Applying setup wizard .env values..."
	merge_count=0
	while IFS='=' read -r ek ev; do
		case "$ek" in
			'' | *[!A-Za-z0-9_]* | DB_HOST | DB_PORT | DB_NAME | DB_DATABASE | DB_USER | DB_USERNAME | DB_PASS | DB_PASSWORD)
				continue
				;;
		esac
		[ -z "$ek" ] && continue
		if grep -q "^${ek}=" "$docroot/.env" 2>/dev/null; then
			sed -i "s|^${ek}=.*|${ek}=${ev}|" "$docroot/.env"
		else
			echo "${ek}=${ev}" >> "$docroot/.env"
		fi
		merge_count=$((merge_count + 1))
	done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=.*$' "$env_file" | head -200)
	echo "[+] $merge_count environment value(s) applied."
	rm -f "$env_file"
fi

# NOTE: global vault secrets are deliberately NOT injected into deployed
# application environments — deployed code runs as the hosting user and
# must never see the admin's global API keys. Use v-set-web-domain-env to
# manage per-domain secrets explicitly.

# Step 2.5: Auto-provision MySQL Database if schema.sql exists
sql_file=""
for f in "$docroot/schema.sql" "$docroot/database.sql" "$docroot/db.sql" "$docroot/install.sql" "$docroot/build/schema.sql"; do
	if [ -f "$f" ]; then
		sql_file="$f"
		break
	fi
done

if [ -n "$sql_file" ]; then
	clean_repo_db=$(echo "$repo_slug" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/_/g' | cut -c 1-12)
	db_name="${clean_repo_db}"
	full_db_name="${user}_${db_name}"
	db_pass=$(head /dev/urandom 2>/dev/null | tr -dc A-Za-z0-9 | head -c 16)
	[ -z "$db_pass" ] && db_pass="NxvPass$(date +%s)"

	echo "[*] Database schema found ($sql_file). Provisioning panel database: $full_db_name..."
	if ! $BIN/v-list-database "$user" "$full_db_name" >/dev/null 2>&1; then
		$BIN/v-add-database "$user" "$db_name" "$db_name" "$db_pass" >/dev/null 2>&1 || true
	fi

	# Import SQL schema — as the deployment's dedicated database user,
	# never as root: the schema file comes from the deployed repository
	echo "[*] Importing SQL schema into $full_db_name..."
	$BIN/v-change-database-password "$user" "$full_db_name" "$db_pass" >/dev/null 2>&1 || true
	mysql_cnf=$(mktemp /tmp/nexvia_repo_sql.XXXXXX)
	chmod 600 "$mysql_cnf"
	printf '[client]\nuser=%s\npassword=%s\n' "$full_db_name" "$db_pass" > "$mysql_cnf"
	if mariadb --defaults-file="$mysql_cnf" "$full_db_name" < "$sql_file" 2>/dev/null; then
		echo "[+] Schema imported as dedicated database user."
	else
		echo "[!] Schema import failed (continuing)"
	fi
	shred -u "$mysql_cnf" 2>/dev/null || rm -f "$mysql_cnf"

	# Inject DB credentials into .env (force-update: the password may have
	# been rotated above, stale values from older deployments must go)
	for db_var in "DB_HOST=127.0.0.1" "DB_PORT=3306" "DB_NAME=$full_db_name" "DB_DATABASE=$full_db_name" "DB_USER=$full_db_name" "DB_USERNAME=$full_db_name" "DB_PASS=$db_pass" "DB_PASSWORD=$db_pass"; do
		k=$(echo "$db_var" | cut -d '=' -f 1)
		if grep -q "^${k}=" "$docroot/.env" 2>/dev/null; then
			sed -i "s|^${k}=.*|${db_var}|g" "$docroot/.env"
		else
			echo "$db_var" >> "$docroot/.env"
		fi
	done

	# Import seed data (idempotent SQL), then generalized PHP seeders.
	import_sql() {
		local f="$1"
		echo "[*] Importing seed data: ${f#"$docroot"/}"
		mysql_cnf=$(mktemp /tmp/nexvia_repo_sql.XXXXXX)
		chmod 600 "$mysql_cnf"
		printf '[client]\nuser=%s\npassword=%s\n' "$full_db_name" "$db_pass" > "$mysql_cnf"
		if mariadb --defaults-file="$mysql_cnf" "$full_db_name" < "$f" 2>/dev/null; then
			echo "[+] Seed imported: ${f#"$docroot"/}"
		else
			echo "[!] Seed import failed: ${f#"$docroot"/} (continuing)"
		fi
		shred -u "$mysql_cnf" 2>/dev/null || rm -f "$mysql_cnf"
	}
	for seed in "$docroot/seed.sql" "$docroot/seeds.sql" "$docroot/database/seed.sql" \
		"$docroot/database/seeds.sql" "$docroot/build/seed.sql" "$docroot/db/seed.sql" \
		"$docroot/db/seeds.sql" "$docroot/data/seed.sql"; do
		[ -f "$seed" ] && import_sql "$seed"
	done
	for seed_dir in "$docroot/seeds" "$docroot/database/seeds" "$docroot/build/seeds" "$docroot/db/seeds"; do
		for seed in "$seed_dir"/*.sql; do
			[ -f "$seed" ] && import_sql "$seed"
		done
	done
	# PHP seeders under build/ run as the hosting user (seed_provinces.php etc.)
	for seeder in "$docroot"/build/seed*.php; do
		[ -f "$seeder" ] || continue
		echo "[*] Running seeder: ${seeder#"$docroot"/}"
		su - "$user" -s /bin/bash -c "cd '$docroot/build' && php '$(basename "$seeder")'" >/dev/null 2>&1 \
			|| echo "[!] Seeder failed: $(basename "$seeder") (continuing)"
	done
elif ls "$docroot"/seed.sql "$docroot"/seeds.sql "$docroot"/database/seed.sql "$docroot"/build/seed.sql &>/dev/null; then
	echo "[i] Seed data found but no schema.sql — database not provisioned, seeds skipped."
	echo "    (Add schema.sql so the panel can auto-create the database, or create the DB manually and re-deploy.)"
fi

# Detect .env values the user still has to fill in — the panel turns this
# into a post-deploy notice. Auto-filled DB credentials and generated keys
# are excluded; a value counts as "missing" when empty or a placeholder.
env_required=""
if [ -f "$docroot/.env" ]; then
	while IFS='=' read -r ek ev; do
		case "$ek" in
			"" | DB_HOST | DB_PORT | DB_NAME | DB_DATABASE | DB_USER | DB_USERNAME | DB_PASS | DB_PASSWORD | APP_KEY)
				continue
				;;
		esac
		[[ "$ek" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
		ev_low=$(echo "$ev" | tr '[:upper:]' '[:lower:]')
		case "$ev_low" in
			"" | "changeme" | "change_me" | "xxx"* | "your"* | *"here" | *"<"* | *"{"*)
				env_required="${env_required:+$env_required,}$ek"
				;;
		esac
	done < <(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$docroot/.env" | head -120)
fi
[ -n "$env_required" ] && echo "__NEXVIA_ENV_REQUIRED__ $env_required"

chmod 600 "$docroot/.env" 2>/dev/null || true
chown -R "$user:$user" "$docroot"

echo "[*] Step 3: Detecting application stack..."
detected_type="php"
pkg_mgr="npm"
out_dir="dist"
detected_orm=""

# Run rich analyzer if available
if [ -f "$HESTIA/lib/nexvia-repo-scan.py" ] && command -v python3 &>/dev/null; then
	scan_json=$(python3 "$HESTIA/lib/nexvia-repo-scan.py" "$docroot" "$branch" 2>/dev/null || echo "{}")
	if [ -n "$scan_json" ]; then
		detected_type=$(echo "$scan_json" | python3 -c 'import sys, json; data=json.load(sys.stdin); print(data.get("platform", {}).get("mode") or "php")' 2>/dev/null || echo "php")
		pkg_mgr=$(echo "$scan_json" | python3 -c 'import sys, json; data=json.load(sys.stdin); comps=data.get("components", []); print(comps[0].get("package_manager") if comps else "npm")' 2>/dev/null || echo "npm")
		out_dir=$(echo "$scan_json" | python3 -c 'import sys, json; data=json.load(sys.stdin); comps=data.get("components", []); print(comps[0].get("output_dir") if comps else "dist")' 2>/dev/null || echo "dist")
		detected_orm=$(echo "$scan_json" | python3 -c 'import sys, json; data=json.load(sys.stdin); print(data.get("database", {}).get("orm") or "")' 2>/dev/null || echo "")
	fi
fi

# Fallback heuristic if scan didn't resolve
if [ -z "$detected_type" ] || [ "$detected_type" = "unknown" ]; then
	if [ "$app_mode" = "dotnet" ] || [ "$app_mode" = "api" ] || ls "$docroot"/*.csproj &>/dev/null || ls "$docroot"/*.sln &>/dev/null; then
		detected_type="dotnet"
	elif [ "$app_mode" = "node" ] || [ -f "$docroot/package.json" ]; then
		if [ -d "$docroot/dist" ] && [ ! -f "$docroot/server.js" ] && [ ! -f "$docroot/app.js" ] && [ "$app_mode" = "react" ]; then
			detected_type="react"
		else
			detected_type="node"
		fi
	elif [ "$app_mode" = "react" ] || [ -d "$docroot/dist" ]; then
		detected_type="react"
	elif [ -f "$docroot/artisan" ]; then
		detected_type="laravel"
	fi
fi

# Override if app_mode explicitly specified
if [ "$app_mode" = "php" ]; then
	detected_type="php"
elif [ "$app_mode" = "node" ]; then
	detected_type="node"
elif [ "$app_mode" = "react" ]; then
	detected_type="react"
elif [ "$app_mode" = "dotnet" ]; then
	detected_type="dotnet"
fi

echo "[+] Application Stack Detected: $detected_type (Mode: $app_mode | Pkg: $pkg_mgr | Out: $out_dir)"

# Helper for running Node.js package manager commands under user privileges
run_node_pkg() {
	local action="$1"
	local mgr="$pkg_mgr"
	if [ "$mgr" = "bun" ] && command -v bun &>/dev/null; then
		if [ "$action" = "install" ]; then
			su - "$user" -s /bin/bash -c "cd '$docroot' && bun install" 2>/dev/null || true
		elif [ "$action" = "build" ]; then
			su - "$user" -s /bin/bash -c "cd '$docroot' && bun run build" 2>/dev/null || true
		fi
	elif [ "$mgr" = "pnpm" ] && command -v pnpm &>/dev/null; then
		if [ "$action" = "install" ]; then
			su - "$user" -s /bin/bash -c "cd '$docroot' && pnpm install --frozen-lockfile 2>/dev/null || pnpm install" 2>/dev/null || true
		elif [ "$action" = "build" ]; then
			su - "$user" -s /bin/bash -c "cd '$docroot' && pnpm build" 2>/dev/null || true
		fi
	elif [ "$mgr" = "yarn" ] && command -v yarn &>/dev/null; then
		if [ "$action" = "install" ]; then
			su - "$user" -s /bin/bash -c "cd '$docroot' && yarn install --production=false" 2>/dev/null || true
		elif [ "$action" = "build" ]; then
			su - "$user" -s /bin/bash -c "cd '$docroot' && yarn build" 2>/dev/null || true
		fi
	elif command -v npm &>/dev/null; then
		if [ "$action" = "install" ]; then
			su - "$user" -s /bin/bash -c "cd '$docroot' && npm install --production=false" 2>/dev/null || true
		elif [ "$action" = "build" ]; then
			su - "$user" -s /bin/bash -c "cd '$docroot' && npm run build" 2>/dev/null || true
		fi
	fi
}

case "$detected_type" in
	dotnet)
		echo "[*] Configuring .NET Kestrel backend..."
		$BIN/v-change-web-domain-tpl "$user" "$domain" "dotnet"
		if ls "$docroot"/*.csproj &>/dev/null && command -v dotnet &>/dev/null; then
			echo "[*] Building .NET project..."
			su - "$user" -s /bin/bash -c "cd '$docroot' && dotnet publish -c Release -o '$docroot/publish'" 2>/dev/null || true
			dll_file=$(find "$docroot/publish" -maxdepth 1 -name "*.dll" ! -name "Microsoft.*" ! -name "System.*" | head -n 1)
			if [ -n "$dll_file" ]; then
				dll_base=$(basename "$dll_file")
				$BIN/v-add-web-domain-app "$user" "$domain" dotnet "dotnet $docroot/publish/$dll_base"
			fi
		fi
		;;
	node|next)
		echo "[*] Configuring Node.js application ($pkg_mgr)..."
		$BIN/v-change-web-domain-tpl "$user" "$domain" "node-js"
		if [ -f "$docroot/package.json" ]; then
			run_node_pkg "install"
			run_node_pkg "build"
			# Prisma migration hook if detected
			if [ "$detected_orm" = "prisma" ] || [ -f "$docroot/prisma/schema.prisma" ]; then
				echo "[*] Running Prisma database setup..."
				su - "$user" -s /bin/bash -c "cd '$docroot' && npx prisma generate >/dev/null 2>&1 && npx prisma migrate deploy >/dev/null 2>&1" || true
			fi
		fi
		entry_file="app.js"
		[ -f "$docroot/server.js" ] && entry_file="server.js"
		[ -f "$docroot/index.js" ] && entry_file="index.js"
		[ -f "$docroot/dist/main.js" ] && entry_file="dist/main.js"
		if [ "$detected_type" = "next" ] || [ -d "$docroot/.next" ]; then
			$BIN/v-add-web-domain-app "$user" "$domain" node "npx next start"
		else
			$BIN/v-add-web-domain-app "$user" "$domain" node "node $entry_file"
		fi
		;;
	react)
		echo "[*] Configuring Static SPA / Frontend ($pkg_mgr)..."
		$BIN/v-change-web-domain-tpl "$user" "$domain" "default"
		if [ -f "$docroot/package.json" ]; then
			run_node_pkg "install"
			run_node_pkg "build"
		fi
		# Copy compiled assets from output directory (out, dist, build)
		target_out="$docroot/dist"
		[ -d "$docroot/out" ] && target_out="$docroot/out"
		[ -d "$docroot/build" ] && [ "$target_out" != "$docroot/out" ] && target_out="$docroot/build"
		[ -n "$out_dir" ] && [ -d "$docroot/$out_dir" ] && target_out="$docroot/$out_dir"
		if [ -d "$target_out" ] && [ "$target_out" != "$docroot" ]; then
			echo "[*] Deploying static build from ${target_out#"$docroot"/}/..."
			cp -rf "$target_out"/* "$docroot"/ 2>/dev/null || true
		fi
		;;
	laravel)
		echo "[*] Configuring Laravel PHP framework..."
		$BIN/v-change-web-domain-tpl "$user" "$domain" "default"
		if command -v composer &>/dev/null; then
			su - "$user" -s /bin/bash -c "cd '$docroot' && composer install --no-dev -o" 2>/dev/null || true
		fi
		su - "$user" -s /bin/bash -c "cd '$docroot' && php artisan key:generate --force 2>/dev/null" || true
		if [ -n "$sql_file" ] || [ -f "$docroot/.env" ]; then
			su - "$user" -s /bin/bash -c "cd '$docroot' && php artisan migrate --force 2>/dev/null" || true
		fi
		;;
	php)
		echo "[*] Configuring PHP / Native application..."
		$BIN/v-change-web-domain-tpl "$user" "$domain" "default"
		if [ -f "$docroot/composer.json" ] && command -v composer &>/dev/null; then
			su - "$user" -s /bin/bash -c "cd '$docroot' && composer install --no-dev -o" 2>/dev/null || true
		fi
		;;
esac

# Final Permissions Hardening
chown -R "$user:$user" "$docroot"
find "$docroot" -type d -exec chmod 755 {} + 2>/dev/null || true
find "$docroot" -type f -exec chmod 644 {} + 2>/dev/null || true
[ -f "$docroot/.env" ] && chmod 600 "$docroot/.env"
[ -d "$docroot/.git" ] && chmod -R 700 "$docroot/.git"

# Restart web server
$BIN/v-restart-web 2>/dev/null || systemctl reload nginx 2>/dev/null || true

echo "[+] SUCCESS: Deployment completed for $domain"
log_event "$OK" "GitHub repo $repo_input deployed to $domain ($detected_type)"
exit 0
