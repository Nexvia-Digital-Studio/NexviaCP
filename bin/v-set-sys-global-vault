#!/bin/bash
# info: set or update a global secret in NexviaCP Vault
# options: KEY VALUE
#
# example: v-set-sys-global-vault GLOBAL_GEMINI_API_KEY AIzaSy...

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'KEY VALUE'

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

key=$(echo "$1" | sed 's/[^A-Za-z0-9_]//g' | tr '[:lower:]' '[:upper:]')
value=$2

if [ -z "$key" ]; then
	check_result "$E_INVALID" "invalid secret KEY name"
fi

vault_file="$HESTIA/conf/vault.conf"
touch "$vault_file"
chmod 600 "$vault_file"
chown root:root "$vault_file"

escaped_value=$(printf '%s' "$value" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')

tmp_v=$(mktemp /tmp/nexvia_vault_XXXXXX)
chmod 600 "$tmp_v"

if [ -f "$vault_file" ]; then
	grep -v "^${key}=" "$vault_file" > "$tmp_v" 2>/dev/null || true
fi
echo "${key}=\"${escaped_value}\"" >> "$tmp_v"

mv -f "$tmp_v" "$vault_file"
chmod 600 "$vault_file"
chown root:root "$vault_file"

log_event "$OK" "$key [MASKED]"
exit 0
