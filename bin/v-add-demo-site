#!/bin/bash
# info: publish a git repository as a demo site under a secret panel URL
# options: USER REPO [BRANCH] [NAME] [SUBDIR] [--db[=ENV_PREFIX]] [--install=CMD] [--build=CMD] [--dist=DIR]
#
# example: v-add-demo-site admin onlymutfak
# example: v-add-demo-site admin Nexvia-Digital-Studio/onlymutfak main
# example: v-add-demo-site admin https://github.com/user/site.git main "" web
# example: v-add-demo-site admin org/blog main "" "" --db=BLOG --install "php bin/install.php"
# example: v-add-demo-site admin org/astro-site main "" "" --build "npm ci && npm run build" --dist dist
#
# Publishes static HTML and plain PHP sites (no build steps) at
# https://panel.example.com/<name>-<random16>/ — the random suffix is
# the access control. Pushes to the repo update the demo automatically
# (v-sync-github-repos picks up demo sites too). Output's URL_PATH line is
# machine-readable for the panel.
#
# --db[=ENV_PREFIX]: provision a per-demo MariaDB database + user (dropped
# with the demo). Credentials reach PHP as fastcgi params DB_HOST/DB_NAME/
# DB_USER/DB_PASS and, when a prefix is given (e.g. URBANA), additionally
# as URBANA_DB_HOST/… — getenv()/$_SERVER both see them.
# --install=CMD: run CMD inside the repo clone as the demo pool user right
# after publishing (and on every v-update-demo-site), with the DB creds in
# the environment — e.g. "php bin/install.php" to load schema+seed.
# Without --install the DB stays empty (app must self-provision or the
# site must run without DB).
# --build=CMD: run CMD inside the repo clone BEFORE publishing (and on
# every update) as the unjailed build user — for static-site generators
# (Astro, Vite, Next export, Hugo…): "npm ci && npm run build". The
# command sees NEXVIA_DEMO_BASE='/<slug>/' (the demo's URL base path,
# trailing slash) so frameworks can bake it in — Astro: astro build --base
# "$NEXVIA_DEMO_BASE". Exclusive with SUBDIR (build always runs at the
# repo root).
# --dist=DIR: publish this folder of the clone after the build (e.g.
# dist, out, build) instead of the repo root. Requires --build — a plain
# subfolder of an unbuildable repo is what SUBDIR is for.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Positional args + flags. Flags are recognized anywhere (--db, --db=PFX,
# --install=CMD, --build=CMD, --dist=DIR); the rest are positional in order:
#   USER REPO [BRANCH] [NAME] [SUBDIR]
db_flag=0
db_prefix=""
install_cmd=""
build_cmd=""
dist_dir=""
positionals=()
for _a in "$@"; do
	case "$_a" in
		--db)
			db_flag=1
			;;
		--db=*)
			db_flag=1
			db_prefix="${_a#--db=}"
			;;
		--install=*)
			install_cmd="${_a#--install=}"
			;;
		--build=*)
			build_cmd="${_a#--build=}"
			;;
		--dist=*)
			dist_dir="${_a#--dist=}"
			;;
		--*)
			bad_flag="$_a"
			;;
		*)
			positionals+=("$_a")
			;;
	esac
done
set -- "${positionals[@]}"

user=$1
repo_input=$2
branch=${3:-main}
name_input=${4:-}
subdir=${5:-}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/demo-site.sh
source $HESTIA/func/demo-site.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

[ -z "$bad_flag" ] || check_result "$E_INVALID" "unknown flag: $bad_flag"
if [ "$db_flag" = "1" ] && [ -n "$db_prefix" ]; then
	[[ "$db_prefix" =~ ^[A-Za-z][A-Za-z0-9_]{0,30}$ ]] \
		|| check_result "$E_INVALID" "invalid ENV_PREFIX (letters/digits/underscore, e.g. URBANA)"
	db_prefix=$(echo "$db_prefix" | tr '[:lower:]' '[:upper:]')
fi
if [ -n "$install_cmd" ]; then
	# The registry stores single-quoted values — keep quotes/newlines out.
	case "$install_cmd" in
		*"'"*|*$'\n'*)
			check_result "$E_INVALID" "invalid --install command (no quotes or newlines)"
			;;
	esac
	[ "${#install_cmd}" -le 300 ] || check_result "$E_INVALID" "--install command too long (max 300 chars)"
fi

check_args '2' "$#" 'USER REPO [BRANCH] [NAME] [SUBDIR] [--db[=ENV_PREFIX]] [--install=CMD] [--build=CMD] [--dist=DIR]'
is_format_valid 'user'
is_object_valid 'user' 'USER' "$user"
if [ -n "$branch" ] && [[ ! "$branch" =~ ^[A-Za-z0-9._/-]{1,100}$ ]]; then
	check_result "$E_INVALID" "invalid BRANCH name"
fi
if [ -n "$subdir" ]; then
	case "$subdir" in
		/*|*..*|*\ *)
			check_result "$E_INVALID" "invalid SUBDIR (relative path inside the repo, e.g. 'web')"
			;;
	esac
	[[ "$subdir" =~ ^[A-Za-z0-9._/-]{1,200}$ ]] || check_result "$E_INVALID" "invalid SUBDIR"
fi
for _cmd_name in install_cmd build_cmd; do
	declare -n _cmd_value="$_cmd_name"
	# The registry stores single-quoted values — keep quotes/newlines out.
	case "$_cmd_value" in
		*"'"*|*$'\n'*)
			check_result "$E_INVALID" "invalid --${_cmd_name%_cmd} command (no quotes or newlines)"
			;;
	esac
	[ "${#_cmd_value}" -le 300 ] \
		|| check_result "$E_INVALID" "--${_cmd_name%_cmd} command too long (max 300 chars)"
done
if [ -n "$dist_dir" ]; then
	case "$dist_dir" in
		/*|*..*|*\ *)
			check_result "$E_INVALID" "invalid DIST (relative folder inside the repo, e.g. 'dist')"
			;;
	esac
	[[ "$dist_dir" =~ ^[A-Za-z0-9._/-]{1,200}$ ]] || check_result "$E_INVALID" "invalid DIST"
	[ -n "$build_cmd" ] || check_result "$E_INVALID" "--dist requires --build (a plain subfolder is SUBDIR)"
fi
[ -z "$build_cmd" ] || [ -z "$subdir" ] \
	|| check_result "$E_INVALID" "SUBDIR and --build are mutually exclusive (build runs at the repo root)"

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

# Normalize the repository to a plain github.com URL (owner/repo and bare
# org repo names are accepted; the org comes from the GitHub connection).
repo_url="${repo_input%/}"
if [[ ! "$repo_url" =~ ^https?:// ]]; then
	if [[ "$repo_url" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
		repo_url="https://github.com/${repo_url}.git"
	elif [ -n "$GITHUB_ORG" ]; then
		repo_url="https://github.com/${GITHUB_ORG}/${repo_url}.git"
	else
		check_result "$E_INVALID" "provide the full GitHub repository URL"
	fi
fi
repo_path="${repo_url#http://}"
repo_path="${repo_path#https://}"
repo_path="${repo_path#www.github.com/}"
repo_path="${repo_path#github.com/}"
repo_url="https://github.com/${repo_path}"
[[ "$repo_url" =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(\.git)?$ ]] \
	|| check_result "$E_INVALID" "only github.com owner/repo URLs are supported"
[[ "$repo_url" =~ \.git$ ]] || repo_url="${repo_url}.git"
repo_owner=$(echo "$repo_url" | cut -d/ -f4)
repo_name=$(basename "$repo_url" .git)
repo_norm="${repo_owner}/${repo_name}"

# Demo name: explicit > repo name. Sanitized to lowercase dashes.
name=$(demo_sanitize_name "${name_input:-$repo_name}")
[ -n "$name" ] || check_result "$E_INVALID" "could not derive a valid NAME from '$repo_name'"

# Infrastructure must exist (user, dirs, php pool). Deployed/ensured by
# v-update-sys-nexvia; refuse with a helpful message instead of failing
# half-way on fresh installs.
id "$DEMO_POOL_USER" >/dev/null 2>&1 \
	|| check_result "$E_NOTEXIST" "demo infrastructure missing — run: v-ensure-demo-sites"
mkdir -p "$DEMO_NGINX_DIR" "$DEMO_DEMOS_DIR"
chmod 755 "$DEMO_NGINX_DIR" "$DEMO_DEMOS_DIR"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Random slug: <name>-<16 hex>. Regenerate a few times on the (absurdly
# unlikely) chance of a collision with an existing demo or nginx conf.
slug=""
for _ in 1 2 3 4 5; do
	cand="${name}-$(openssl rand -hex 8)"
	if [ ! -e "$(demo_reg_file "$user" "$cand")" ] && [ ! -e "$DEMO_NGINX_DIR/$cand.conf" ] \
		&& [ ! -d "$DEMO_DEMOS_DIR/$cand" ]; then
		slug="$cand"
		break
	fi
done
[ -n "$slug" ] || check_result "$E_EXISTS" "could not generate a unique slug"

demo_dir="$DEMO_DEMOS_DIR/$slug"
mkdir -p "$demo_dir/.src"
chown -R "$DEMO_POOL_USER:$DEMO_POOL_GROUP" "$demo_dir"

echo "[*] Cloning ${repo_norm} (branch: ${branch})…"
clone_rc=0
demo_git clone --depth 1 -b "$branch" -- "$repo_url" "$demo_dir/.src" 2>/dev/null || {
	# Requested branch may not exist — fall back to the repo default.
	demo_git clone --depth 1 -- "$repo_url" "$demo_dir/.src" 2>/dev/null || clone_rc=1
}
if [ "$clone_rc" != "0" ]; then
	rm -rf "$demo_dir"
	check_result "$E_CONNECT" "git clone failed for ${repo_url} (private repo? check GITHUB_TOKEN)"
fi

# Record the branch that is actually checked out (the fallback above may
# have landed on the default branch instead of the requested one).
real_branch=$(demo_git -C "$demo_dir/.src" symbolic-ref --short HEAD 2>/dev/null || echo "$branch")
commit=$(demo_git -C "$demo_dir/.src" rev-parse --short HEAD 2>/dev/null || echo "")

if [ -n "$subdir" ] && [ ! -d "$demo_dir/.src/$subdir" ]; then
	rm -rf "$demo_dir"
	check_result "$E_NOTEXIST" "SUBDIR '$subdir' not found in ${repo_norm}"
fi

# Build hook: run the repo's build (static-site generators) before
# publishing. Runs as the unjailed build user; the published tree is the
# DIST folder when given, otherwise the repo root (post-build).
if [ -n "$build_cmd" ]; then
	echo "[*] Building (${build_cmd})…"
	if ! demo_build_run "$slug" "$build_cmd"; then
		rm -rf "$demo_dir"
		check_result "$E_INVALID" "build command failed — see output above (node/npm installed? correct build script?)"
	fi
fi
publish_dir="$dist_dir"

demo_publish_tree "$slug" "$publish_dir" || {
	rm -rf "$demo_dir"
	check_result "$E_INVALID" "failed to publish demo tree"
}

# Per-demo database (admin panels, DB-backed apps). Provisioned before the
# nginx conf so the credentials can be injected as fastcgi params.
db_name=""
db_user=""
db_pass=""
db_params=""
if [ "$db_flag" = "1" ]; then
	echo "[*] Provisioning demo database…"
	prov=$(demo_db_provision "$slug") || {
		rm -rf "$demo_dir"
		check_result "$E_CONNECT" "failed to create the demo database (mysql reachable as root?)"
	}
	read -r db_name db_user db_pass <<EOF
$prov
EOF
	db_params=$(demo_db_fastcgi_params "$db_name" "$db_user" "$db_pass" "$db_prefix")
fi

demo_gen_nginx_conf "$slug" "$user" "$repo_norm" "$real_branch" "$db_params"
if ! nginx -t >/dev/null 2>&1; then
	rm -f "$DEMO_NGINX_DIR/$slug.conf"
	[ -n "$db_name" ] && demo_db_drop "$slug"
	rm -rf "$demo_dir"
	check_result "$E_INVALID" "nginx config test failed — demo not created"
fi
systemctl reload nginx

# Registry entry (sourceable key='val', one file per demo).
mkdir -p "$HESTIA/data/users/$user/demo-sites"
reg=$(demo_reg_file "$user" "$slug")
cat > "$reg" <<NXV_REG_EOF
SLUG='$slug'
NAME='$name'
REPO='$repo_norm'
REPO_URL='$repo_url'
BRANCH='$real_branch'
SUBDIR='$subdir'
DIR='$demo_dir'
COMMIT='$commit'
DB_NAME='$db_name'
DB_USER='$db_user'
DB_PASS='$db_pass'
DB_PREFIX='$db_prefix'
INSTALL='$install_cmd'
BUILD='$build_cmd'
DIST='$dist_dir'
CREATED='$(date '+%F %T')'
UPDATED='$(date '+%F %T')'
STATE='active'
NXV_REG_EOF
chown root:root "$reg"
chmod 640 "$reg"

# Install hook: load schema/seed into the fresh DB (repo code, pool user —
# or the build user for --build demos, whose .src the pool user can't read).
if [ -n "$install_cmd" ]; then
	echo "[*] Running install command…"
	if ! demo_install_run "$slug" "$install_cmd" "$db_name" "$db_user" "$db_pass" \
		"$([ -n "$build_cmd" ] && echo "$DEMO_BUILD_USER")"; then
		echo " [!] install command failed — the demo is published but the DB may be empty"
	fi
fi

index_hint=""
if [ ! -f "$demo_dir/index.html" ] && [ ! -f "$demo_dir/index.htm" ] && [ ! -f "$demo_dir/index.php" ]; then
	index_hint=" [!] no index.(html|php) at the demo root — set SUBDIR if the site lives in a subfolder"
fi

log_event "$OK" "created demo site $slug (user $user, repo $repo_norm${db_name:+, db $db_name})"
echo "OK:$slug"
echo "URL_PATH:/$slug/"
echo "REPO:$repo_norm@$real_branch"
[ -n "$db_name" ] && echo "DB:$db_name"
[ -n "$index_hint" ] && echo "$index_hint"
exit 0
