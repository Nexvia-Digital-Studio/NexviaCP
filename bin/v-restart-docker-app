#!/bin/bash
# info: restart a docker compose application (or a single service of it)
# options: APP [SERVICE]
#
# example: v-restart-docker-app mercanadisyon
# example: v-restart-docker-app mercanadisyon api

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
app=$1
service=${2:-}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/docker-app.sh
source $HESTIA/func/docker-app.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'APP [SERVICE]'
is_docker_app_format_valid "$app" || check_result "$E_INVALID" "invalid APP name"
is_docker_app_valid "$app" || check_result "$E_NOTEXIST" "docker app '$app' doesn't exist"

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

if [ -n "$service" ]; then
	docker_app_compose "$app" restart "$service" \
		|| check_result "$E_INVALID" "failed to restart service '$service'"
else
	docker_app_compose "$app" restart \
		|| check_result "$E_INVALID" "failed to restart app '$app'"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "Docker" "Docker app restarted (App: $app${service:+, Service: $service})."
log_event "$OK" "$ARGUMENTS"

echo "[+] Restarted '$app'${service:+ service '$service'}"
exit
