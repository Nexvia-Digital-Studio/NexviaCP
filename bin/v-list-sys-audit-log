#!/bin/bash
# info: list recent login/auth and API events from the system auth log
# options: [LINES] [FORMAT]
#
# example: v-list-sys-audit-log
# example: v-list-sys-audit-log 200 json
# example: v-list-sys-audit-log 50 shell
#
# Returns the last LINES (default 100, max 1000) entries of
# $HESTIA/log/auth.log, the central log where logins, API key checks and
# API command launches (success and failure) are recorded by
# v-check-user-password, v-get-user-salt, v-check-api-key and
# v-check-access-key. Needed by the API audit page because /var/log/hestia
# is not readable by the hestiaweb user.

# Use a stable locale so regex character ranges behave identically
# regardless of the server language (e.g. tr_TR.UTF-8 collation)
export LC_ALL=C

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

arg1=$1
arg2=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
[ -f /etc/hestiacp/hestia.conf ] && source /etc/hestiacp/hestia.conf
[ -z "$HESTIA" ] && HESTIA="/usr/local/hestia"
if [ ! -d "$HESTIA" ] && [ -d "$(cd "$(dirname "$0")/.." && pwd)" ]; then
	HESTIA="$(cd "$(dirname "$0")/.." && pwd)"
fi
# shellcheck source=/usr/local/hestia/func/main.sh
[ -f "$HESTIA/func/main.sh" ] && source "$HESTIA/func/main.sh"
[ -f "$HESTIA/conf/hestia.conf" ] && source_conf "$HESTIA/conf/hestia.conf"

lines="${arg1:-100}"
format="${arg2:-json}"
LOG_FILE="$HESTIA/log/auth.log"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

if ! [[ "$lines" =~ ^[0-9]+$ ]] || [ "$lines" -lt 1 ] || [ "$lines" -gt 1000 ]; then
	echo "ERROR: Invalid LINES '$lines'. Use an integer between 1 and 1000."
	exit 1
fi

case "$format" in
	json) ;;
	shell) ;;
	*)
		echo "ERROR: Invalid FORMAT '$format'. Allowed: json, shell."
		exit 1
		;;
esac

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# JSON list function
json_list() {
	echo '{'
	echo '    "lines": ['
	first=1
	n=0
	tail -n "$lines" "$LOG_FILE" 2> /dev/null | while read -r l_date l_time l_rest; do
		n=$((n + 1))
		# Escape backslashes and double quotes for safe JSON output
		l_rest="${l_rest//\\/\\\\}"
		l_rest="${l_rest//\"/\\\"}"
		if [ "$first" -eq 1 ]; then
			first=0
		else
			echo ','
		fi
		echo -n "        {\"LINE\": $n, \"DATE\": \"$l_date\", \"TIME\": \"$l_time\", \"MESSAGE\": \"$l_rest\"}"
	done
	echo
	echo '    ]'
	echo '}'
}

# SHELL list function
shell_list() {
	tail -n "$lines" "$LOG_FILE" 2> /dev/null
}

case "$format" in
	json) json_list ;;
	shell) shell_list ;;
esac

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

exit 0
