#!/bin/bash
# info: delete a global secret from NexviaCP Vault
# options: KEY

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

check_args '1' "$#" 'KEY'

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

key=$(echo "$1" | sed 's/[^A-Za-z0-9_]//g' | tr '[:lower:]' '[:upper:]')
vault_file="$HESTIA/conf/vault.conf"

if [ -f "$vault_file" ] && [ -n "$key" ]; then
	tmp_v=$(mktemp /tmp/nexvia_vault_del_XXXXXX)
	chmod 600 "$tmp_v"
	grep -v "^${key}=" "$vault_file" > "$tmp_v" 2>/dev/null || true
	mv -f "$tmp_v" "$vault_file"
	chmod 600 "$vault_file"
	chown root:root "$vault_file"
fi

log_event "$OK" "$key deleted from vault"
exit 0
