#!/bin/bash
# info: safely list masked environment keys (.env) for a web domain
# options: USER DOMAIN [FORMAT]

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DOMAIN [FORMAT]'

user=$1
domain=$2
format=${3:-json}

is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
USER_DATA=$HESTIA/data/users/$user
is_object_valid 'web' 'DOMAIN' "$domain"

docroot="$HOMEDIR/$user/web/$domain/public_html"
env_file="$docroot/.env"
is_user_path_nosymlink "$docroot"

# Read the file as the domain owner: a symlinked .env must not let root
# disclose (even only the key names of) a file the user cannot read.
if ! env_content=$(user_exec cat -- "$env_file" 2>/dev/null); then
	if [ "$format" = "json" ]; then
		echo "{}"
	fi
	exit 0
fi

NEXVIA_ENV_CONTENT="$env_content" python3 - "$format" << 'PYEOF'
import json, os, sys

format_type = sys.argv[1] if len(sys.argv) > 1 else "json"

res = {}
for line in os.environ.get("NEXVIA_ENV_CONTENT", "").splitlines():
    line = line.strip()
    if not line or line.startswith('#'):
        continue
    if '=' in line:
        key, _ = line.split('=', 1)
        key = key.strip()
        if key:
            res[key] = {
                "KEY": key,
                "MASKED": "••••••••••••••••",
                "EXISTS": "yes"
            }

if format_type == "json":
    print(json.dumps(res, indent=4))
else:
    for k in res:
        print(k)
PYEOF

exit 0
