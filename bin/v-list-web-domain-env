#!/bin/bash
# info: safely list masked environment keys (.env) for a web domain
# options: USER DOMAIN [FORMAT]

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DOMAIN [FORMAT]'

user=$1
domain=$2
format=${3:-json}

is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"

env_file="$HOMEDIR/$user/web/$domain/public_html/.env"

if [ ! -f "$env_file" ]; then
	if [ "$format" = "json" ]; then
		echo "{}"
	fi
	exit 0
fi

python3 - "$env_file" "$format" << 'PYEOF'
import sys, json, os

env_path = sys.argv[1]
format_type = sys.argv[2] if len(sys.argv) > 2 else "json"

res = {}
if os.path.exists(env_path):
    with open(env_path, 'r', errors='ignore') as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            if '=' in line:
                key, _ = line.split('=', 1)
                key = key.strip()
                if key:
                    res[key] = {
                        "KEY": key,
                        "MASKED": "••••••••••••••••",
                        "EXISTS": "yes"
                    }

if format_type == "json":
    print(json.dumps(res, indent=4))
else:
    for k in res:
        print(k)
PYEOF

exit 0
