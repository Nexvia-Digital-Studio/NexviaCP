#!/bin/bash
# info: smart adaptive auto-tuner for web domains and backend apps
# options: [USER] [DOMAIN]
#
# example: v-tune-sys-resources
# example: v-tune-sys-resources admin neredeyasanir.localhost
#
# Delegates per-domain measurement and sizing to the demand engine
# ($HESTIA/lib/nexvia-demand-engine.py), which scores real demand 0-100
# from active visitors, dynamic request load, the site's own traffic
# baseline and memory pressure, then decides state (idle/active/busy/
# boosted) and computes RAM/CPU limits (per-worker memory_limit and a
# Little's-law based peak). This script applies the resulting limits via
# v-change-web-domain-cgroup and keeps the governance state directory
# that the panel dashboard reads.

# Argument definition
target_user=$1
target_domain=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
[ -f /etc/hestiacp/hestia.conf ] && source /etc/hestiacp/hestia.conf
[ -z "$HESTIA" ] && HESTIA="/usr/local/hestia"
if [ ! -d "$HESTIA" ] && [ -d "$(cd "$(dirname "$0")/.." && pwd)" ]; then
	HESTIA="$(cd "$(dirname "$0")/.." && pwd)"
fi
# shellcheck source=/usr/local/hestia/func/main.sh
[ -f "$HESTIA/func/main.sh" ] && source "$HESTIA/func/main.sh"
# load config file
[ -f "$HESTIA/conf/hestia.conf" ] && source_conf "$HESTIA/conf/hestia.conf"

ENGINE="$HESTIA/lib/nexvia-demand-engine.py"
GOV_DIR="/var/lib/hestia/governance"
mkdir -p "$GOV_DIR" 2>/dev/null || true
chmod 700 "$GOV_DIR" 2>/dev/null || true

# Serialize concurrent tuning passes (cron + panel trigger)
LOCK_FILE="$GOV_DIR/tune.lock"
exec 8>"$LOCK_FILE"
flock -n 8 || exit 0

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Optional args: with no USER/DOMAIN the script tunes all domains.
if [ -n "$target_user" ] && [ -n "$target_domain" ]; then
	check_args '2' "$#" 'USER DOMAIN'
	user="$target_user"
	domain="$target_domain"
	is_format_valid 'user' 'domain'
	is_object_valid 'user' 'USER' "$target_user"
	is_object_valid 'web' 'DOMAIN' "$target_domain"
fi

json_field() {
	# json_field <json> <key> — crude but dependency-free extraction of a
	# scalar value from the single-line engine JSON.
	echo "$1" | python3 -c "
import json, sys
try:
	doc = json.load(sys.stdin)
except Exception:
	sys.exit(1)
v = doc.get(sys.argv[1], '')
print(v if not isinstance(v, list) else ','.join(v))
" "$2" 2>/dev/null
}

# Function to tune a single domain
tune_domain() {
	local u="$1"
	local d="$2"

	# Read priority (default: 0 = Auto)
	local prio=$(get_object_value 'web' 'DOMAIN' "$d" '$RESOURCE_PRIORITY')
	[ -z "$prio" ] && prio="0"

	# API/backend domains (docker apps, standalone dotnet/node services):
	# the engine scores them distress-first and never idles them; docker
	# domains get real container memory pressure instead of PHP cgroups.
	local wline
	wline=$(grep -F "DOMAIN='$d'" "$HESTIA/data/users/$u/web.conf" 2>/dev/null | head -1)
	local app_type
	app_type=$(echo "$wline" | grep -o "APP_TYPE='[^']*'" | cut -d"'" -f2)
	if [ -z "$app_type" ]; then
		local tpl_type
		tpl_type=$(echo "$wline" | grep -o "TPL='[^']*'" | cut -d"'" -f2)
		case "$tpl_type" in dotnet*|node-js*|python*|reverse-proxy*|custom-port*) app_type="$tpl_type" ;; esac
	fi

	# Auto-detect standalone app runtime from directory content or processes
	if [ -z "$app_type" ]; then
		local web_dir="$HOMEDIR/$u/web/$d"
		if [ -d "$web_dir" ]; then
			if ls "$web_dir"/*.dll "$web_dir"/public_html/*.dll "$web_dir"/appsettings.json "$web_dir"/public_html/appsettings.json >/dev/null 2>&1; then
				app_type="dotnet"
			elif [ -f "$web_dir/public_html/package.json" ] || [ -f "$web_dir/package.json" ]; then
				app_type="node-js"
			elif [ -f "$web_dir/public_html/requirements.txt" ] || [ -f "$web_dir/requirements.txt" ]; then
				app_type="python"
			elif [[ "$d" =~ ^api\. ]] || [[ "$d" =~ ^backend\. ]] || [[ "$d" =~ ^app\. ]]; then
				app_type="api"
			fi
		fi
	fi

	local engine_extra=()
	if [ -n "$app_type" ]; then
		engine_extra+=(--app-type "$app_type")
	fi
	if [ "$app_type" = "docker" ]; then
		local dapp="" dsvc=""
		for acf in "$HESTIA"/data/docker-apps/*/app.conf; do
			[ -f "$acf" ] || continue
			for dent in $(grep -m1 '^DOMAINS=' "$acf" | cut -d"'" -f2); do
				if [ "${dent%%:*}" = "$u@$d" ]; then
					dapp=$(basename "$(dirname "$acf")")
					dsvc=$(echo "$dent" | cut -d: -f2)
					break 2
				fi
			done
		done
		if [ -n "$dapp" ]; then
			engine_extra+=(--docker-app "$dapp" --docker-service "$dsvc")
		fi
	fi

	# Engine measures distress (latency/memory/cpu saturation), scores demand,
	# decides state and writes the governance state JSON; the same JSON is
	# echoed on stdout.
	local out=""
	if [ -x "$ENGINE" ] && [ -x "$(command -v python3)" ]; then
		out=$("$ENGINE" --user "$u" --domain "$d" --priority "$prio" \
			--gov-dir "$GOV_DIR" --homedir "$HOMEDIR" \
			${engine_extra[@]+"${engine_extra[@]}"} 2>/dev/null) || out=""
	fi

	local status="active"
	local mem_high="256M"
	local mem_max="1G"
	local cpu_quota="100%"

	if [ -n "$out" ]; then
		status=$(json_field "$out" STATUS)
		mem_high=$(json_field "$out" MEMORY_HIGH)
		mem_max=$(json_field "$out" MEMORY_MAX)
		cpu_quota=$(json_field "$out" CPU_QUOTA)
	fi
	[ -z "$status" ] && status="active"
	[ -z "$mem_high" ] && mem_high="256M"
	[ -z "$mem_max" ] && mem_max="1G"
	[ -z "$cpu_quota" ] && cpu_quota="100%"

	# Read current stored values and apply changes only if different.
	local old_high=$(get_object_value 'web' 'DOMAIN' "$d" '$WEB_CGROUP_HIGH')
	local old_max=$(get_object_value 'web' 'DOMAIN' "$d" '$WEB_CGROUP_MAX')
	local old_cpu=$(get_object_value 'web' 'DOMAIN' "$d" '$WEB_CPU_QUOTA')

	if [ "$old_high" != "$mem_high" ] || [ "$old_max" != "$mem_max" ] || [ "$old_cpu" != "$cpu_quota" ]; then
		$BIN/v-change-web-domain-cgroup "$u" "$d" "$mem_high" "$mem_max" "$cpu_quota" >/dev/null 2>&1 || true
	fi
}

# Main Execution Loop
if [ -n "$target_user" ] && [ -n "$target_domain" ]; then
	tune_domain "$target_user" "$target_domain"
else
	# Tune all domains across all users
	if [ -d "$HESTIA/data/users" ]; then
		for u_dir in "$HESTIA/data/users"/*; do
			[ ! -d "$u_dir" ] && continue
			u=$(basename "$u_dir")
			if [ -f "$u_dir/web.conf" ]; then
				while read -r line; do
					d=$(echo "$line" | grep -oE "DOMAIN='[^']+'" | cut -d"'" -f2)
					[ -n "$d" ] && tune_domain "$u" "$d"
				done < "$u_dir/web.conf"
			fi
		done
	else
		for u_dir in "$HOMEDIR"/*; do
			[ ! -d "$u_dir/web" ] && continue
			u=$(basename "$u_dir")
			for d_dir in "$u_dir/web"/*; do
				[ ! -d "$d_dir" ] && continue
				d=$(basename "$d_dir")
				tune_domain "$u" "$d"
			done
		done
	fi
fi

exit 0
