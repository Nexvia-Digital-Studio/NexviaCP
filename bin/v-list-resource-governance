#!/bin/bash
# info: list resource governance metrics and comparative stats for all web domains
# options: [FORMAT]

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

format=${1:-json}
GOV_DIR="/var/lib/hestia/governance"

# Auto-run tune if governance state is empty or stale (>60s)
stale=0
if [ ! -d "$GOV_DIR" ] || [ -z "$(ls -A "$GOV_DIR" 2>/dev/null)" ]; then
	stale=1
else
	newest_file=$(ls -t "$GOV_DIR"/*.json 2>/dev/null | head -n 1)
	if [ -z "$newest_file" ]; then
		stale=1
	else
		now_ts=$(date +%s)
		file_ts=$(stat -c %Y "$newest_file" 2>/dev/null || echo 0)
		if [ $((now_ts - file_ts)) -gt 60 ]; then
			stale=1
		fi
	fi
fi

if [ "$stale" -eq 1 ]; then
	$BIN/v-tune-sys-resources >/dev/null 2>&1 || true
fi

python3 - "$GOV_DIR" "$HOMEDIR" "$HESTIA" "$format" << 'PYEOF'
import sys, os, json, glob

gov_dir = sys.argv[1]
homedir = sys.argv[2]
hestia = sys.argv[3]
format_type = sys.argv[4] if len(sys.argv) > 4 else "json"

domains = {}
summary = {
    "TOTAL_DOMAINS": 0,
    "IDLE_COUNT": 0,
    "ACTIVE_COUNT": 0,
    "BOOSTED_COUNT": 0,
    "THROTTLED_COUNT": 0,
    "VIP_COUNT": 0,
    "AUTO_MANAGED_COUNT": 0,
    "TOTAL_RAM_MANAGED_MB": 0,
    "ESTIMATED_SAVED_RAM_MB": 0
}

# Scan domains from data directory or state files
state_files = glob.glob(os.path.join(gov_dir, "*.json"))

for sfile in state_files:
    try:
        with open(sfile, 'r') as f:
            data = json.load(f)
            dname = data.get("DOMAIN")
            if dname:
                domains[dname] = data
                summary["TOTAL_DOMAINS"] += 1
                
                status = data.get("STATUS", "active")
                prio = data.get("PRIORITY", 0)
                
                if prio == 0:
                    summary["AUTO_MANAGED_COUNT"] += 1
                
                if status == "idle":
                    summary["IDLE_COUNT"] += 1
                    # Idle saves ~192MB compared to standard 256MB baseline
                    summary["ESTIMATED_SAVED_RAM_MB"] += 192
                elif status == "boosted":
                    summary["BOOSTED_COUNT"] += 1
                elif status == "throttled":
                    summary["THROTTLED_COUNT"] += 1
                    summary["ESTIMATED_SAVED_RAM_MB"] += 192
                elif status == "vip":
                    summary["VIP_COUNT"] += 1
                else:
                    summary["ACTIVE_COUNT"] += 1
                
                summary["TOTAL_RAM_MANAGED_MB"] += data.get("MEMORY_USAGE_MB", 0)
    except Exception:
        pass

# If no state files were found, list domains from HESTIA user data
if not domains:
    for u_dir in glob.glob(os.path.join(homedir, "*")):
        u = os.path.basename(u_dir)
        for d_dir in glob.glob(os.path.join(u_dir, "web", "*")):
            d = os.path.basename(d_dir)
            if os.path.isdir(d_dir):
                domains[d] = {
                    "DOMAIN": d,
                    "USER": u,
                    "PRIORITY": 0,
                    "STATUS": "idle",
                    "MEMORY_USAGE_MB": 12,
                    "MEMORY_HIGH": "64M",
                    "MEMORY_MAX": "256M",
                    "CPU_QUOTA": "25%",
                    "IO_WEIGHT": 50,
                    "REQ_COUNT_10M": 0,
                    "PSI_PRESSURE": 0,
                    "LAST_TUNED": "Just now"
                }
                summary["TOTAL_DOMAINS"] += 1
                summary["IDLE_COUNT"] += 1
                summary["AUTO_MANAGED_COUNT"] += 1

result = {
    "summary": summary,
    "domains": domains
}

if format_type == "json":
    print(json.dumps(result, indent=4))
else:
    for d, val in domains.items():
        print(f"{d} {val.get('USER')} {val.get('PRIORITY')} {val.get('STATUS')} {val.get('MEMORY_HIGH')} {val.get('CPU_QUOTA')}")
PYEOF

exit 0
