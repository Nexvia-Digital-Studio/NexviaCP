#!/bin/bash
# info: sync and pull updates in parallel for all domains connected to GitHub repos
# options: [REPO_NAME]

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

# Root-side logging: the webhook endpoint (running as hestiaweb) cannot write
# to /var/log/hestia itself, so all output is captured here instead.
mkdir -p /var/log/hestia
exec >> /var/log/hestia/github-webhook.log 2>&1
echo "[*] [$(date +'%Y-%m-%d %H:%M:%S')] Invoked (Target: ${1:-all})"

target_repo=$(echo "$1" | sed 's/[^a-zA-Z0-9._-]//g')

# Serialize concurrent webhook runs: parallel syncs on the same docroot would
# race (simultaneous git pull / chmod passes).
lock_file="/var/log/hestia/github-webhook.lock"
exec 9>"$lock_file"
if ! flock -n 9; then
	echo "[!] Another sync is already running; skipping this run."
	exit 0
fi

echo "[*] [$(date +'%Y-%m-%d %H:%M:%S')] Scanning domains for GitHub sync (Target: ${target_repo:-all})..."

sync_pids=()
sync_domains=()
max_jobs=4
running_jobs=0

for u_dir in "$HOMEDIR"/*; do
	[ ! -d "$u_dir/web" ] && continue
	user=$(basename "$u_dir")

	for d_dir in "$u_dir/web"/*; do
		[ ! -d "$d_dir/public_html/.git" ] && continue
		domain=$(basename "$d_dir")

		# Kill-switch: domains whose git integration was disabled with
		# v-delete-web-domain-git have GIT_REPO emptied — a bare .git dir must
		# NOT keep them on the webhook sync path. (Read the user's web.conf
		# directly: get_object_value is bound to $USER_DATA and resolves to the
		# wrong file inside this multi-user loop.)
		domain_repo=$(sed -n "s/^DOMAIN='$domain' .*GIT_REPO='\([^']*\)'.*$/\1/p" "$HESTIA/data/users/$user/web.conf" 2>/dev/null | head -1)
		if [ -z "$domain_repo" ]; then
			continue
		fi

		# Check remote origin URL (dropped to user to avoid dubious ownership)
		remote_url=$(su - "$user" -s /bin/bash -c "git -C '$d_dir/public_html' config --get remote.origin.url 2>/dev/null")
		repo_base=$(basename "$remote_url" .git)

		if [ -n "$target_repo" ]; then
			if [ "$repo_base" != "$target_repo" ] && [[ "$remote_url" != *"/$target_repo.git" ]] && [[ "$remote_url" != *"/$target_repo" ]]; then
				continue
			fi
		fi

		echo "[*] Triggering update for domain: $domain (User: $user)..."
		# Run update in parallel subshell; record failures for the summary.
		(
			$BIN/v-update-web-domain-git "$user" "$domain" >/dev/null 2>&1
			rc=$?
			if [ $rc -ne 0 ]; then
				echo "[!] FAILED: v-update-web-domain-git $user $domain (exit $rc)"
			fi
			exit $rc
		) &
		sync_pids+=($!)
		sync_domains+=("$user/$domain")
		running_jobs=$((running_jobs + 1))

		if [ "$running_jobs" -ge "$max_jobs" ]; then
			wait -n 2>/dev/null || wait "${sync_pids[0]}" 2>/dev/null || true
			running_jobs=$((running_jobs - 1))
		fi
	done
done

# Wait for all remaining domain updates to complete and count failures
failed=0
if [ ${#sync_pids[@]} -gt 0 ]; then
	for i in "${!sync_pids[@]}"; do
		if ! wait "${sync_pids[$i]}" 2>/dev/null; then
			failed=$((failed + 1))
		fi
	done
fi

total=${#sync_pids[@]}

# ---- Demo sites (secret demo URLs under the panel domain) --------------
# Registry REPO is owner/name; match by repo basename like the domain
# loop above so one push refreshes every demo cloned from that repo.
demo_pids=()
for reg_dir in "$HESTIA"/data/users/*/demo-sites; do
	[ -d "$reg_dir" ] || continue
	d_owner=$(basename "$(dirname "$reg_dir")")
	for reg in "$reg_dir"/*.conf; do
		[ -f "$reg" ] || continue
		d_repo=$(sed -n "s/^REPO='\([^']*\)'$/\1/p" "$reg" | head -1)
		d_slug=$(sed -n "s/^SLUG='\([^']*\)'$/\1/p" "$reg" | head -1)
		[ -n "$d_repo" ] && [ -n "$d_slug" ] || continue
		if [ -n "$target_repo" ] && [ "${d_repo##*/}" != "$target_repo" ]; then
			continue
		fi
		echo "[*] Triggering update for demo site: $d_slug (User: $d_owner)..."
		(
			$BIN/v-update-demo-site "$d_owner" "$d_slug"
			exit $?
		) &
		demo_pids+=($!)
	done
done

demo_failed=0
for i in "${!demo_pids[@]}"; do
	if ! wait "${demo_pids[$i]}" 2>/dev/null; then
		demo_failed=$((demo_failed + 1))
	fi
done
if [ "$demo_failed" -gt 0 ]; then
	echo "[!] FINISHED WITH ERRORS: $demo_failed demo site update(s) FAILED (see v-update-demo-site output above)."
fi

total=$((total + ${#demo_pids[@]}))
failed=$((failed + demo_failed))

# A push for a repo with zero connected domains/demos is almost certainly a
# misconfiguration (e.g. a site deployed from GitHub without registering
# auto-sync) — it must never hide behind a "SUCCESS (0 sites)" line, which
# is exactly how weareclean.com.tr stayed stale unnoticed.
zero_match=0
if [ -n "$target_repo" ] && [ "$total" -eq 0 ]; then
	zero_match=1
	echo "[!] WARNING: push received for '$target_repo' but no domain or demo site on this server is connected to that repository — nothing was updated."
	echo "    Connect the site with: v-add-web-domain-git <user> <domain> <repo-url> — or publish a demo with: v-add-demo-site <user> <repo>."
	$BIN/v-add-user-notification admin "GitHub Sync" "GitHub'dan '${target_repo}' deposuna push geldi ama bu depoya bağlı site/demo yok — hiçbir şey güncellenmedi. Siteyi bağlamak için: v-add-web-domain-git kullanıcı domain repo-url · Demo yayınlamak için: v-add-demo-site kullanıcı repo" 2>/dev/null || true
fi

if [ "$failed" -gt 0 ]; then
	echo "[!] FINISHED WITH ERRORS: $failed of $total update(s) FAILED (see lines above)."
	exit 1
fi
if [ "$zero_match" -eq 0 ]; then
	echo "[+] SUCCESS: All connected domains and demo sites (${total} total) updated from GitHub in parallel with zero downtime."
fi
exit 0
