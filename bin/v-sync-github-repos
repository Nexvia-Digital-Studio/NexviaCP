#!/bin/bash
# info: sync and pull updates for all domains connected to GitHub repos
# options: [REPO_NAME]

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

target_repo=$(echo "$1" | sed 's/[^a-zA-Z0-9._-]//g')

echo "[*] Scanning domains for GitHub sync (Filter: ${target_repo:-all})..."

for u_dir in "$HOMEDIR"/*; do
	[ ! -d "$u_dir/web" ] && continue
	user=$(basename "$u_dir")

	for d_dir in "$u_dir/web"/*; do
		[ ! -d "$d_dir/public_html/.git" ] && continue
		domain=$(basename "$d_dir")

		# Check remote URL
		remote_url=$(git -C "$d_dir/public_html" config --get remote.origin.url 2>/dev/null)
		repo_base=$(basename "$remote_url" .git)

		if [ -n "$target_repo" ]; then
			if [ "$repo_base" != "$target_repo" ] && [[ "$remote_url" != *"/$target_repo.git" ]] && [[ "$remote_url" != *"/$target_repo" ]]; then
				continue
			fi
		fi

		echo "[*] Updating domain $domain (User: $user, Remote: $remote_url)..."
		$BIN/v-update-web-domain-git "$user" "$domain"
	done
done

echo "[+] Sync completed."
exit 0
