#!/bin/bash
# info: pull latest changes and rebuild web domain deployed from GitHub
# options: USER DOMAIN

user=$1
domain=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

docroot="$HOMEDIR/$user/web/$domain/public_html"

if [ ! -d "$docroot/.git" ]; then
	check_result "$E_NOTEXIST" "Domain $domain is not a git repository."
fi

echo "[*] Updating git repository in $docroot..."
cd "$docroot" || exit 1

# Pull latest commits as user
su - "$user" -s /bin/bash -c "cd '$docroot' && git pull" 2>&1

# Build if necessary
if [ -f "$docroot/composer.json" ] && command -v composer &>/dev/null; then
	echo "[*] Running composer install..."
	su - "$user" -s /bin/bash -c "cd '$docroot' && composer install --no-dev -o" 2>&1 || true
fi

if [ -f "$docroot/package.json" ] && command -v npm &>/dev/null; then
	echo "[*] Running npm build..."
	su - "$user" -s /bin/bash -c "cd '$docroot' && (npm run build 2>/dev/null || npm install --production)" 2>&1 || true
fi

if ls "$docroot"/*.csproj &>/dev/null && command -v dotnet &>/dev/null; then
	echo "[*] Re-building .NET project..."
	su - "$user" -s /bin/bash -c "cd '$docroot' && dotnet publish -c Release -o '$docroot/publish'" 2>&1 || true
fi

# Permissions Hardening
chown -R "$user:$user" "$docroot"
find "$docroot" -type d -exec chmod 755 {} + 2>/dev/null || true
find "$docroot" -type f -exec chmod 644 {} + 2>/dev/null || true
[ -f "$docroot/.env" ] && chmod 600 "$docroot/.env"
[ -d "$docroot/.git" ] && chmod -R 700 "$docroot/.git"

# Restart isolated app service if configured
unit_name="hestia-app-${user}-${domain}"
if systemctl is-active --quiet "$unit_name" 2>/dev/null; then
	echo "[*] Restarting application service: $unit_name..."
	systemctl restart "$unit_name" 2>/dev/null || true
fi

echo "[+] SUCCESS: Domain $domain updated from GitHub."
log_event "$OK" "$user $domain git updated"
exit 0
