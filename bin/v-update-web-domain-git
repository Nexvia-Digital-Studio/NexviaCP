#!/bin/bash
# info: pull latest changes and rebuild web domain deployed from GitHub
# options: USER DOMAIN

user=$1
domain=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

docroot="$HOMEDIR/$user/web/$domain/public_html"

if [ ! -d "$docroot/.git" ]; then
	check_result "$E_NOTEXIST" "Domain $domain is not a git repository."
fi

echo "[*] Updating git repository in $docroot..."
cd "$docroot" || exit 1

# Remember the deployed commit: caches are purged below only when the pull
# actually moves HEAD, so "Already up to date." webhooks stay free.
old_head=$(su - "$user" -s /bin/bash -c "cd '$docroot' && git rev-parse HEAD" 2>/dev/null)

# Fetch, then fast-forward. A bare `git pull` both aborts on a dirty tree and
# can create surprise merge commits — and apps dirty their tree in normal
# operation (admin image uploads overwriting tracked uploads/, generated
# caches, sitemaps). One conflicting upload therefore used to stall that
# site's deploys forever, silently. Recovery ladder:
#   1. fetch + `merge --ff-only`          → the clean, common path
#   2. dirty/diverged → audit the local state, log it, notify the user, then
#      `reset --hard origin/<branch>`. Untracked files (fresh runtime uploads)
#      are never touched, so nothing the site wrote is deleted; overwritten
#      tracked paths and any dropped local commits are listed in the log and
#      in the panel notification for auditability.
git_as_user() {
	su - "$user" -s /bin/bash -c "cd '$docroot' && git $1"
}

if ! git_out=$(git_as_user "fetch origin --prune" 2>&1); then
	echo "[!] ERROR: git fetch failed for $domain — aborting update."
	echo "$git_out"
	check_result "$E_CONNECT" "git fetch failed :: $domain"
fi

branch=$(git_as_user "rev-parse --abbrev-ref HEAD" 2>/dev/null | head -1)
if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then
	branch=$(git_as_user "symbolic-ref -q --short HEAD" 2>/dev/null | head -1)
fi
if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then
	# Detached HEAD: there is no branch to fast-forward or reset safely.
	if git_as_user "merge --ff-only FETCH_HEAD" >/dev/null 2>&1; then
		echo "[*] Detached HEAD fast-forwarded to FETCH_HEAD."
		branch=""
	else
		echo "[!] ERROR: $domain is on a detached HEAD and cannot be fast-forwarded — aborting."
		check_result "$E_CONNECT" "detached HEAD, ff failed :: $domain"
	fi
fi

if [ -n "$branch" ]; then
	if git_as_user "merge --ff-only origin/$branch" >/dev/null 2>&1; then
		:
	else
		dirty_paths=$(git_as_user "status --porcelain" 2>/dev/null | grep -v '^??' | head -25)
		dirty_count=$(git_as_user "status --porcelain" 2>/dev/null | grep -vc '^??')
		local_ahead=$(git_as_user "rev-list --count origin/$branch..$branch" 2>/dev/null || echo 0)
		if [ -n "$dirty_paths" ]; then
			echo "[!] Working tree has $dirty_count locally modified tracked file(s) — listing up to 25:"
			echo "$dirty_paths"
		fi
		if [ "${local_ahead:-0}" -gt 0 ] 2>/dev/null; then
			echo "[!] Local branch is $local_ahead commit(s) ahead of origin/$branch — those commits will be detached (recoverable via reflog)."
		fi
		if ! git_as_user "reset --hard origin/$branch" >/dev/null 2>&1; then
			echo "[!] ERROR: git reset --hard failed for $domain — aborting update."
			check_result "$E_CONNECT" "git reset --hard failed :: $domain"
		fi
		echo "[+] Recovered with hard reset to origin/$branch (untracked runtime files preserved)."
		$BIN/v-add-user-notification "$user" "GitHub Sync" "'$domain' için deploy, yerel değişiklikler ($dirty_count takipli dosya${local_ahead:+, $local_ahead yerel commit}) yüzünden fast-forward edilemedi ve origin/$branch ile eşitlendi. Takipsiz dosyalar (yeni yüklenenler) korundu; üzerine yazılanlar sunucu günlüğünde listelendi." 2>/dev/null || true
	fi
fi

# Build if necessary
if [ -f "$docroot/composer.json" ] && command -v composer &>/dev/null; then
	echo "[*] Running composer install..."
	su - "$user" -s /bin/bash -c "cd '$docroot' && composer install --no-dev -o" 2>&1 || true
fi

if [ -f "$docroot/package.json" ] && command -v npm &>/dev/null; then
	echo "[*] Running npm build..."
	su - "$user" -s /bin/bash -c "cd '$docroot' && (npm run build 2>/dev/null || npm install --production)" 2>&1 || true
fi

if ls "$docroot"/*.csproj &>/dev/null && command -v dotnet &>/dev/null; then
	echo "[*] Re-building .NET project..."
	su - "$user" -s /bin/bash -c "cd '$docroot' && dotnet publish -c Release -o '$docroot/publish'" 2>&1 || true
fi

# Permissions Hardening
chown -R "$user:$user" "$docroot"
find "$docroot" -type d -exec chmod 755 {} + 2>/dev/null || true
find "$docroot" -type f -exec chmod 644 {} + 2>/dev/null || true
# Secret-bearing files must NOT stay world-readable after the blanket 644:
# - .env and scanner backups (.env.bak-*) carry DB credentials / APP_KEY
# - deploy.php embeds the per-domain HMAC deploy secret
for secret in "$docroot"/.env "$docroot"/.env.bak-* "$docroot"/deploy.php; do
	if [ -f "$secret" ] && [ ! -L "$secret" ]; then
		chmod 600 "$secret"
	fi
done
# deploy.php must additionally stay readable by the web server group.
if [ -f "$docroot/deploy.php" ] && [ ! -L "$docroot/deploy.php" ]; then
	chown "$user:${WEB_RGROUPS:-www-data}" "$docroot/deploy.php"
	chmod 640 "$docroot/deploy.php"
fi
[ -d "$docroot/.git" ] && [ ! -L "$docroot/.git" ] && chmod -R 700 "$docroot/.git"

# Restart isolated app service if configured
unit_name="hestia-app-${user}-${domain}"
if systemctl is-active --quiet "$unit_name" 2>/dev/null; then
	echo "[*] Restarting application service: $unit_name..."
	systemctl restart "$unit_name" 2>/dev/null || true
fi

# Purge CDN/application caches when the deploy actually changed the tree, so
# visitors (and plain F5 refreshes) always see the new commit immediately.
new_head=$(su - "$user" -s /bin/bash -c "cd '$docroot' && git rev-parse HEAD" 2>/dev/null)
if [ -n "$old_head" ] && [ "$old_head" != "$new_head" ]; then
	echo "[*] New commit deployed ($old_head -> $new_head) — purging caches..."
	$BIN/v-purge-web-domain-cache "$user" "$domain" || true
else
	echo "[*] No new commits (already up to date) — cache purge skipped."
fi

echo "[+] SUCCESS: Domain $domain updated from GitHub."
log_event "$OK" "$user $domain git updated"
exit 0
