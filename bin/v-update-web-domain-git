#!/bin/bash
# info: pull latest changes and rebuild web domain deployed from GitHub
# options: USER DOMAIN

user=$1
domain=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

docroot="$HOMEDIR/$user/web/$domain/public_html"

if [ ! -d "$docroot/.git" ]; then
	check_result "$E_NOTEXIST" "Domain $domain is not a git repository."
fi

echo "[*] Updating git repository in $docroot..."
cd "$docroot" || exit 1

# Remember the deployed commit: caches are purged below only when the pull
# actually moves HEAD, so "Already up to date." webhooks stay free.
old_head=$(su - "$user" -s /bin/bash -c "cd '$docroot' && git rev-parse HEAD" 2>/dev/null)

# Pull latest commits as user — a failed pull must abort the deploy instead
# of reporting success with a stale tree.
su - "$user" -s /bin/bash -c "cd '$docroot' && git pull" 2>&1
pull_rc=$?
if [ $pull_rc -ne 0 ]; then
	echo "[!] ERROR: git pull failed for $domain (exit $pull_rc) — aborting update."
	check_result "$E_CONNECT" "git pull failed :: $domain (exit $pull_rc)"
fi

# Build if necessary
if [ -f "$docroot/composer.json" ] && command -v composer &>/dev/null; then
	echo "[*] Running composer install..."
	su - "$user" -s /bin/bash -c "cd '$docroot' && composer install --no-dev -o" 2>&1 || true
fi

if [ -f "$docroot/package.json" ] && command -v npm &>/dev/null; then
	echo "[*] Running npm build..."
	su - "$user" -s /bin/bash -c "cd '$docroot' && (npm run build 2>/dev/null || npm install --production)" 2>&1 || true
fi

if ls "$docroot"/*.csproj &>/dev/null && command -v dotnet &>/dev/null; then
	echo "[*] Re-building .NET project..."
	su - "$user" -s /bin/bash -c "cd '$docroot' && dotnet publish -c Release -o '$docroot/publish'" 2>&1 || true
fi

# Permissions Hardening
chown -R "$user:$user" "$docroot"
find "$docroot" -type d -exec chmod 755 {} + 2>/dev/null || true
find "$docroot" -type f -exec chmod 644 {} + 2>/dev/null || true
# Secret-bearing files must NOT stay world-readable after the blanket 644:
# - .env and scanner backups (.env.bak-*) carry DB credentials / APP_KEY
# - deploy.php embeds the per-domain HMAC deploy secret
for secret in "$docroot"/.env "$docroot"/.env.bak-* "$docroot"/deploy.php; do
	if [ -f "$secret" ] && [ ! -L "$secret" ]; then
		chmod 600 "$secret"
	fi
done
# deploy.php must additionally stay readable by the web server group.
if [ -f "$docroot/deploy.php" ] && [ ! -L "$docroot/deploy.php" ]; then
	chown "$user:${WEB_RGROUPS:-www-data}" "$docroot/deploy.php"
	chmod 640 "$docroot/deploy.php"
fi
[ -d "$docroot/.git" ] && [ ! -L "$docroot/.git" ] && chmod -R 700 "$docroot/.git"

# Restart isolated app service if configured
unit_name="hestia-app-${user}-${domain}"
if systemctl is-active --quiet "$unit_name" 2>/dev/null; then
	echo "[*] Restarting application service: $unit_name..."
	systemctl restart "$unit_name" 2>/dev/null || true
fi

# Purge CDN/application caches when the deploy actually changed the tree, so
# visitors (and plain F5 refreshes) always see the new commit immediately.
new_head=$(su - "$user" -s /bin/bash -c "cd '$docroot' && git rev-parse HEAD" 2>/dev/null)
if [ -n "$old_head" ] && [ "$old_head" != "$new_head" ]; then
	echo "[*] New commit deployed ($old_head -> $new_head) — purging caches..."
	$BIN/v-purge-web-domain-cache "$user" "$domain" || true
else
	echo "[*] No new commits (already up to date) — cache purge skipped."
fi

echo "[+] SUCCESS: Domain $domain updated from GitHub."
log_event "$OK" "$user $domain git updated"
exit 0
