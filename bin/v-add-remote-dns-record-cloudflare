#!/bin/bash
# info: create a DNS TXT record in Cloudflare (for LE dns-01 wildcard)
# options: DOMAIN RECORD
#
# example: v-add-remote-dns-record-cloudflare example.com "challenge-value"
#
# Uses the Cloudflare API v4 to create a _acme-challenge TXT record. The newly
# created record ID is printed to stdout (the last line) so the caller can
# delete it later with v-delete-remote-dns-record-cloudflare.
# Requires DNS_API_PROVIDER=cloudflare, CF_API_TOKEN and CF_ZONE_ID in hestia.conf.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
domain=$1
record=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Cloudflare API helper
cf_get() {
	printf 'header = "Authorization: Bearer %s"\n' "$CF_API_TOKEN" | \
		curl --silent --show-error --max-time 30 -K - "https://api.cloudflare.com/client/v4$1"
}

# Resolve zone ID by walking up domain hierarchy
resolve_zone_id() {
	local target="$1"
	local cur="$target"
	local zid=""
	while [ -n "$cur" ]; do
		zid=$(cf_get "/zones?name=$cur" | jq -r '.result[0].id // empty')
		if [ -n "$zid" ]; then
			echo "$zid"
			return 0
		fi
		if [[ "$cur" == *.* ]]; then
			cur="${cur#*.}"
		else
			break
		fi
	done
	return 1
}

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'DOMAIN RECORD'
is_format_valid 'domain' 'record'
check_hestia_demo_mode

if [ "x$(id -u)" != 'x0' ]; then
	echo "Error: Script can be run executed only by root"
	exit 10
fi

if [ "$DNS_API_PROVIDER" != "cloudflare" ]; then
	check_result "$E_INVALID" "DNS_API_PROVIDER is not set to cloudflare"
fi
if [ -z "$CF_API_TOKEN" ]; then
	check_result "$E_NOTEXIST" "CF_API_TOKEN is not configured"
fi

# Dynamically resolve zone ID from domain or fallback to CF_ZONE_ID
zone_id=$(resolve_zone_id "$domain")
if [ -z "$zone_id" ] && [ -n "$CF_ZONE_ID" ]; then
	zone_id="$CF_ZONE_ID"
fi
if [ -z "$zone_id" ]; then
	check_result "$E_NOTEXIST" "Could not resolve Cloudflare Zone ID for $domain"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Cloudflare API v4 endpoint for DNS records.
api_url="https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records"

# Build the JSON payload. The record content may contain characters that need
# escaping, so assemble it with jq to stay JSON-safe.
payload=$(jq -nc \
	--arg name "_acme-challenge.$domain" \
	--arg content "$record" \
	'{type:"TXT", name:$name, content:$content, ttl:120}')

# Send the Authorization header via curl stdin config so the API token
# never appears on the process command line (readable via /proc)
answer=$(printf 'header = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\n' "$CF_API_TOKEN" |
	curl --silent --show-error --max-time 30 -K - \
		--request POST "$api_url" \
		--data "$payload")

# Parse the response.
success=$(echo "$answer" | jq -r '.success // false')
if [ "$success" != "true" ]; then
	err_msg=$(echo "$answer" | jq -r '.errors[0].message // "unknown Cloudflare API error"')
	check_result "$E_CONNECT" "Cloudflare API request failed for $domain: $err_msg"
fi

# Extract the newly created record id (printed to stdout for the caller).
record_id=$(echo "$answer" | jq -r '.result.id')

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "DNS" "Created Cloudflare TXT record for _acme-challenge.$domain (id: $record_id)."
log_event "$OK" "$ARGUMENTS"

echo "$record_id"
exit
