#!/bin/bash
# info: print the GitHub webhook secret for the webhook listener (internal)
# options: NONE
#
# The webhook PHP endpoint runs as the unprivileged panel user and cannot
# read root-owned vault.conf / hestia.conf directly, so it fetches the
# secret through this sudo-whitelisted helper.

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
[ -f /etc/hestiacp/hestia.conf ] && source /etc/hestiacp/hestia.conf
[ -z "$HESTIA" ] && HESTIA="/usr/local/hestia"
# shellcheck source=/usr/local/hestia/func/main.sh
[ -f "$HESTIA/func/main.sh" ] && source "$HESTIA/func/main.sh"
# load config file
[ -f "$HESTIA/conf/hestia.conf" ] && source_conf "$HESTIA/conf/hestia.conf"

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

secret=""

# Primary location: the root-only vault
if [ -f "$HESTIA/conf/vault.conf" ]; then
	line=$(grep -m1 "^GITHUB_WEBHOOK_SECRET=" "$HESTIA/conf/vault.conf")
	secret=${line#GITHUB_WEBHOOK_SECRET=}
	secret=$(printf '%s' "$secret" | sed "s/^['\"]//; s/['\"]$//")
fi

# Fallback: a config value managed via v-change-sys-config-value
if [ -z "$secret" ] && [ -n "$GITHUB_WEBHOOK_SECRET" ]; then
	secret="$GITHUB_WEBHOOK_SECRET"
fi

if [ -z "$secret" ]; then
	# No secret configured — print nothing, non-zero exit. The webhook
	# endpoint treats this as fail-closed (403).
	exit 1
fi

printf '%s' "$secret"
exit 0
