#!/bin/bash
# info: configure automatic git deployment for a web domain
# options: USER DOMAIN REPO_URL [BRANCH]
#
# example: v-add-web-domain-git admin example.com https://github.com/user/repo.git main
#
# This script registers a git repository for zero-downtime auto-deployment:
#   - clones the repo into the domain's public_html (preserving deploy.php)
#   - writes the repo URL and branch to the domain config
#   - regenerates deploy.sh with the correct branch
#   - the webhook receiver (public_html/deploy.php) verifies HMAC-SHA256
#     signatures using the per-domain GIT_DEPLOY_SECRET created at provisioning
#
# For private repositories, embed credentials directly in REPO_URL:
#   PAT:  https://github_pat_xxx@github.com/user/repo.git
#   SSH:  git@github.com:user/repo.git

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
domain_idn=$2
repo_url=$3
branch=${4:-main}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN REPO_URL [BRANCH]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"

# Branch name is substituted into deploy.sh via sed, so it must not contain
# sed metacharacters (&, |, \) or any other shell/sed active characters.
if ! [[ "${branch:-main}" =~ ^[A-Za-z0-9._/-]+$ ]]; then
	check_result "$E_INVALID" "invalid branch format :: $branch"
fi

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

docroot="$HOMEDIR/$user/web/$domain/public_html"
domain_home="$HOMEDIR/$user/web/$domain"

# Everything below lives in the customer's home and the checked-out repo is
# customer-controlled (it may ship deploy.php/deploy.sh as symlinks). File
# operations therefore run as the customer (user_exec); the only root-side
# change left (deploy.php group) uses chown -h, which never follows links.
is_user_path_nosymlink "$domain_home"
is_user_path_nosymlink "$docroot"

# Validate repository URL (allow http(s), git, ssh forms).
case "$repo_url" in
	http://*|https://*|git://*|git@*|ssh://*) : ;;
	*)
		check_result "$E_INVALID" "invalid repository URL: $repo_url"
		;;
esac

# Preserve the deploy.php webhook receiver before cloning (skel ships it).
preserve_deploy_php=""
if user_exec test -f "$docroot/deploy.php"; then
	preserve_deploy_php=$(user_exec cat -- "$docroot/deploy.php")
fi

# Initialize the working tree as a git repo and fetch the requested branch.
# We clone into a temp dir then move .git into place to avoid clobbering
# existing public_html assets (index.html, deploy.php, etc.).
if [ ! -d "$docroot/.git" ]; then
	echo "[*] Initializing git repository for $domain..."
	tmp_clone=$(mktemp -d)
	# mktemp creates a 0700 root-owned dir while user_exec (setpriv) drops to
	# the domain user — the user cannot traverse it, so the clone would always
	# fail. Hand the dir over to the user first.
	chown "$user:$user" "$tmp_clone"
	chmod 700 "$tmp_clone"
	user_exec git clone --branch "${branch:-main}" --depth 1 "$repo_url" "$tmp_clone/repo" >/dev/null 2>&1
	if [ $? -ne 0 ]; then
		rm -rf "$tmp_clone"
		check_result "$E_CONNECT" "git clone failed (check URL/credentials/branch)"
	fi
	# Move .git into the docroot; copy any missing tracked files on top.
	user_exec mv "$tmp_clone/repo/.git" "$docroot/.git"
	rm -rf "$tmp_clone"
fi

# Always (re)set the remote origin so URL/credential rotation is supported.
user_exec git -C "$docroot" remote remove origin 2>/dev/null || true
user_exec git -C "$docroot" remote add origin "$repo_url"
user_exec git -C "$docroot" fetch origin "${branch:-main}" >/dev/null 2>&1 || true
user_exec git -C "$docroot" checkout -B "${branch:-main}" "origin/${branch:-main}" -f >/dev/null 2>&1 || true

# Restore the webhook receiver if it was clobbered by the clone; install it
# from the skeleton when missing (domains provisioned before this feature, or
# wiped by v-deploy-github-repo, have no deploy.php at all).
if [ -n "$preserve_deploy_php" ] && ! user_exec test -f "$docroot/deploy.php"; then
	printf '%s' "$preserve_deploy_php" | user_exec tee -- "$docroot/deploy.php" > /dev/null
elif ! user_exec test -f "$docroot/deploy.php" && [ -f "$WEBTPL/skel/public_html/deploy.php" ]; then
	user_exec rm -f -- "$docroot/deploy.php"
	user_exec tee -- "$docroot/deploy.php" < "$WEBTPL/skel/public_html/deploy.php" > /dev/null
fi

# (Re)generate deploy.sh with the correct branch baked in.
deploy_sh="$domain_home/deploy.sh"
user_exec rm -f -- "$deploy_sh"
if [ -f "$WEBTPL/skel/deploy.sh" ]; then
	user_exec tee -- "$deploy_sh" < "$WEBTPL/skel/deploy.sh" > /dev/null
else
	# Minimal fallback if the skel template is unavailable.
	user_exec tee -- "$deploy_sh" > /dev/null <<EOF
#!/bin/bash
set -e
cd "$docroot"
git fetch origin "${branch:-main}"
git reset --hard "origin/${branch:-main}"
[ -f composer.json ] && command -v composer >/dev/null && composer install --no-interaction --prefer-dist || true
[ -f package.json ] && command -v npm >/dev/null && (npm ci || npm install) || true
command -v pm2 >/dev/null && pm2 reload all --silent || true
EOF
fi
user_exec sed -i "s|%branch%|${branch:-main}|g" "$deploy_sh"
user_exec chmod 700 -- "$deploy_sh"

# Make sure the deploy secret exists (older domains created before this
# feature may not have one yet).
secret=$(get_object_value 'web' 'DOMAIN' "$domain" '$GIT_DEPLOY_SECRET')
if [ -z "$secret" ] || [ "$secret" = "%deploy_secret%" ]; then
	secret=$(generate_password 'a-z0-9' 64)
	if [ -z "$secret" ]; then
		secret=$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
	fi
	add_object_key 'web' 'DOMAIN' "$domain" 'GIT_DEPLOY_SECRET' 'TIME'
	update_object_value 'web' 'DOMAIN' "$domain" '$GIT_DEPLOY_SECRET' "$secret"
fi

# Re-inject the secret into deploy.php (it may have been overwritten by clone).
deploy_php="$docroot/deploy.php"
if user_exec test -f "$deploy_php"; then
	# If deploy.php still has the placeholder, fill it; otherwise leave as-is.
	if user_exec grep -q '%deploy_secret%' "$deploy_php" 2>/dev/null; then
		user_exec sed -i "s/%deploy_secret%/$secret/g" "$deploy_php"
	fi
fi

# Persist repo URL + branch in domain config. Strip embedded credentials from
# the stored value — the token lives only in .git/config (user-owned, 700);
# deploys fetch via remote origin anyway.
git_repo_clean=$(printf '%s' "$repo_url" | sed -E 's#(://)[^/@]+@#\1#')
add_object_key 'web' 'DOMAIN' "$domain" 'GIT_REPO' 'TIME'
update_object_value 'web' 'DOMAIN' "$domain" '$GIT_REPO' "$git_repo_clean"
add_object_key 'web' 'DOMAIN' "$domain" 'GIT_BRANCH' 'TIME'
update_object_value 'web' 'DOMAIN' "$domain" '$GIT_BRANCH' "${branch:-main}"

# Normalise permissions after git operations (as the owner: every file here
# was created by user_exec, and find -P never follows symlinks).
user_exec find "$docroot" -type d -exec chmod 755 {} + 2>/dev/null || true
user_exec find "$docroot" -type f -exec chmod 644 {} + 2>/dev/null || true

# Secret-bearing files must not stay world-readable after the blanket 644
# (parity with the hardening in v-update-web-domain-git). .env carries DB
# credentials / APP_KEY; .git/config may embed the pull credentials.
for secret in "$docroot"/.env "$docroot"/.env.bak-*; do
	if [ -f "$secret" ] && [ ! -L "$secret" ]; then
		user_exec chmod 600 -- "$secret"
	fi
done
[ -d "$docroot/.git" ] && [ ! -L "$docroot/.git" ] && user_exec chmod -R 700 -- "$docroot/.git"

# Harden the webhook receiver: deploy.php contains the HMAC secret that can
# trigger code deployment, so it must NOT be world-readable. 644 would let any
# other tenant (or any local process) read the secret. Restrict to owner + the
# web server group only (WEB_RGROUPS, e.g. www-data).
if [ -f "$deploy_php" ] && [ ! -L "$deploy_php" ]; then
	chown -h "$user:${WEB_RGROUPS:-www-data}" "$deploy_php"
	user_exec chmod 640 -- "$deploy_php"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "system" "Info" "Web" "Git auto-deploy enabled for domain (Domain: $domain, User: $user, Branch: ${branch:-main})."
# Strip any credentials embedded in the repo URL (scheme://token@) before
# logging so PATs never reach system.log.
logged_repo_url=$(printf '%s' "$repo_url" | sed -E 's#^[a-zA-Z][a-zA-Z0-9+.-]*://[^/@]+@##')
ARGUMENTS=${ARGUMENTS//"$repo_url"/$logged_repo_url}
log_event "$OK" "$ARGUMENTS"

echo "[+] Git auto-deploy configured for $domain (branch: ${branch:-main})."
echo "    Webhook URL:  https://$domain/deploy.php"
echo "    Secret:       $secret"
exit
