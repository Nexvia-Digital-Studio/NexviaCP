#!/bin/bash
# info: install official Portainer CE Docker Management engine
# options: NONE
#
# This script installs official Portainer CE on the server for NexviaCP

source /etc/hestiacp/hestia.conf
source $HESTIA/func/main.sh
source_conf "$HESTIA/conf/hestia.conf"

# Ensure root user
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: v-add-sys-portainer can be executed only by root user"
	exit 10
fi

echo "[*] Installing official Portainer CE Docker Manager..."

# Install Docker if not installed
if ! command -v docker &> /dev/null; then
    echo "[*] Installing Docker engine..."
    curl -fsSL https://get.docker.com -o get-docker.sh
    sh get-docker.sh
    rm -f get-docker.sh
fi

# Create Portainer data volume
docker volume create portainer_data &> /dev/null || true

# Remove old container if exists
docker rm -f portainer &> /dev/null || true

# Run official Portainer CE Container
docker run -d -p 9000:9000 -p 9443:9443 --name portainer --restart=always -v /var/run/docker.sock:/var/run/docker.sock -v portainer_data:/data portainer/portainer-ce:latest

# Set configuration value
$BIN/v-change-sys-config-value "PORTAINER_SUPPORT" "yes"

log_event "$OK" "$ARGUMENTS"
echo "[+] Official Portainer CE successfully installed and running on port 9000!"
exit 0
