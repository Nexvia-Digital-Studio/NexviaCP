#!/bin/bash
# info: gather Redis memory stats, hit/miss ratios, domain cache mappings, and slow SQL summaries
# options: [FORMAT]
#
# example: v-list-cache-governance json

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

format=${1:-json}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

python3 - "$HOMEDIR" "$HESTIA" "$format" "$BIN" << 'PYEOF'
import sys
import os
import re
import glob
import json
import subprocess

homedir = sys.argv[1]
hestia = sys.argv[2]
format_type = sys.argv[3] if len(sys.argv) > 3 else "json"
bin_dir = sys.argv[4] if len(sys.argv) > 4 else "/usr/local/hestia/bin"

# 1. GATHER REDIS STATS
redis_info = {}
redis_installed = False
redis_running = False
redis_version = "Unknown"
used_mem_bytes = 0
used_mem_human = "0B"
peak_mem_human = "0B"
max_mem_human = "0B"
frag_ratio = 1.0
connected_clients = 0
ops_per_sec = 0
keyspace_hits = 0
keyspace_misses = 0
hit_rate_pct = 100.0
db_stats = {f"db{i}": {"db_index": i, "keys_count": 0, "expires_count": 0, "avg_ttl_sec": 0, "assigned_domain": None, "assigned_user": None} for i in range(16)}

# Detect redis-cli and auth
redis_auth = []
for conf_path in ("/etc/redis/redis.conf", "/etc/redis/redis-server.conf"):
    if os.path.isfile(conf_path):
        try:
            with open(conf_path, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    if line.strip().startswith("requirepass"):
                        parts = line.strip().split()
                        if len(parts) >= 2:
                            redis_auth = ["-a", parts[1].strip('"').strip("'"), "--no-auth-warning"]
                            break
        except Exception:
            pass

# Check if redis-cli executable exists
redis_cli_path = None
for p in ("/usr/bin/redis-cli", "/usr/local/bin/redis-cli", "/bin/redis-cli"):
    if os.path.isfile(p) and os.access(p, os.X_OK):
        redis_cli_path = p
        break

if not redis_cli_path:
    # try which
    try:
        w_out = subprocess.run(["which", "redis-cli"], capture_output=True, text=True)
        if w_out.returncode == 0 and w_out.stdout.strip():
            redis_cli_path = w_out.stdout.strip()
    except Exception:
        pass

if redis_cli_path:
    redis_installed = True
    try:
        # Check if redis is responsive via ping
        ping_cmd = [redis_cli_path] + redis_auth + ["ping"]
        p_res = subprocess.run(ping_cmd, capture_output=True, text=True, timeout=2)
        if "PONG" in p_res.stdout:
            redis_running = True
            
            # Fetch INFO
            info_cmd = [redis_cli_path] + redis_auth + ["info"]
            i_res = subprocess.run(info_cmd, capture_output=True, text=True, timeout=2)
            if i_res.returncode == 0:
                for line in i_res.stdout.splitlines():
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    if ":" in line:
                        k, v = line.split(":", 1)
                        redis_info[k.strip()] = v.strip()
                        
            redis_version = redis_info.get("redis_version", "7.0.x")
            used_mem_bytes = int(redis_info.get("used_memory", 0))
            used_mem_human = redis_info.get("used_memory_human", "0B")
            peak_mem_human = redis_info.get("used_memory_peak_human", "0B")
            max_mem_human = redis_info.get("maxmemory_human", "Unlimited")
            try:
                frag_ratio = float(redis_info.get("mem_fragmentation_ratio", 1.0))
            except ValueError:
                frag_ratio = 1.0
            connected_clients = int(redis_info.get("connected_clients", 0))
            ops_per_sec = int(redis_info.get("instantaneous_ops_per_sec", 0))
            keyspace_hits = int(redis_info.get("keyspace_hits", 0))
            keyspace_misses = int(redis_info.get("keyspace_misses", 0))
            total_requests = keyspace_hits + keyspace_misses
            hit_rate_pct = round((keyspace_hits / total_requests) * 100, 1) if total_requests > 0 else None
            
            # Parse db keyspaces (e.g. db0:keys=12,expires=0,avg_ttl=0)
            for i in range(16):
                db_key = f"db{i}"
                if db_key in redis_info:
                    val = redis_info[db_key]
                    k_match = re.search(r'keys=(\d+)', val)
                    e_match = re.search(r'expires=(\d+)', val)
                    t_match = re.search(r'avg_ttl=(\d+)', val)
                    db_stats[db_key]["keys_count"] = int(k_match.group(1)) if k_match else 0
                    db_stats[db_key]["expires_count"] = int(e_match.group(1)) if e_match else 0
                    db_stats[db_key]["avg_ttl_sec"] = int(t_match.group(1)) if t_match else 0
    except Exception:
        pass

total_redis_keys = sum(db_stats[f"db{i}"]["keys_count"] for i in range(16))

# Helper to format bytes
def human_bytes(b):
    if b < 1024:
        return f"{b} B"
    elif b < 1048576:
        return f"{b/1024:.1f} KB"
    elif b < 1073741824:
        return f"{b/1048576:.1f} MB"
    else:
        return f"{b/1073741824:.2f} GB"

# 2. GATHER FASTCGI & PROXY CACHE STATS ACROSS ALL CANDIDATE CACHE DIRS
candidate_cache_dirs = [
    "/var/cache/nginx/micro",
    "/var/cache/nginx/proxy",
    "/var/cache/nginx/fastcgi",
    "/var/cache/nginx/fastcgi_cache",
    "/var/run/nginx-cache",
    "/tmp/nginx_cache"
]
total_microcache_bytes = 0
total_microcache_files = 0
domain_cache_sizes = {}

for root_dir in candidate_cache_dirs:
    if os.path.isdir(root_dir):
        for root, dirs, files in os.walk(root_dir):
            for f in files:
                fpath = os.path.join(root, f)
                try:
                    sz = os.path.getsize(fpath)
                    total_microcache_bytes += sz
                    total_microcache_files += 1
                except Exception:
                    pass

# Measure per-domain microcache size
for d_check_dir in ("/var/cache/nginx/micro", "/var/cache/nginx/fastcgi", "/var/cache/nginx/proxy"):
    if os.path.isdir(d_check_dir):
        for d_entry in os.listdir(d_check_dir):
            subpath = os.path.join(d_check_dir, d_entry)
            if os.path.isdir(subpath):
                d_bytes = 0
                for r, ds, fs in os.walk(subpath):
                    for f in fs:
                        try:
                            d_bytes += os.path.getsize(os.path.join(r, f))
                        except Exception:
                            pass
                domain_cache_sizes[d_entry] = domain_cache_sizes.get(d_entry, 0) + d_bytes

# Gather Live MySQL/MariaDB QPS & Uptime
mysql_uptime_sec = 0
mysql_queries_total = 0
mysql_qps = 0.0
try:
    s_cmd = subprocess.run(["mysql", "-N", "-e", "SHOW GLOBAL STATUS LIKE 'Uptime'; SHOW GLOBAL STATUS LIKE 'Questions';"], capture_output=True, text=True, timeout=2)
    if s_cmd.returncode == 0:
        for line in s_cmd.stdout.splitlines():
            parts = line.split()
            if len(parts) >= 2:
                if parts[0] == "Uptime":
                    mysql_uptime_sec = int(parts[1])
                elif parts[0] == "Questions":
                    mysql_queries_total = int(parts[1])
        if mysql_uptime_sec > 0 and mysql_queries_total > 0:
            mysql_qps = round(mysql_queries_total / mysql_uptime_sec, 1)
except Exception:
    pass

# 3. GATHER DOMAIN ALLOCATIONS & WEB.CONF
domains_list = {}
assigned_db_count = 0
fastcgi_enabled_count = 0

users_conf_files = glob.glob(os.path.join(hestia, "data/users/*/web.conf"))

for wconf in users_conf_files:
    u = os.path.basename(os.path.dirname(wconf))
    try:
        with open(wconf, 'r', encoding='utf-8', errors='ignore') as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith('#'):
                    continue
                # Parse key-values
                kvs = dict(re.findall(r"([A-Z0-9_]+)='([^']*)'", line))
                dname = kvs.get("DOMAIN")
                if not dname:
                    continue
                
                redis_db_val = kvs.get("REDIS_DB", "")
                fastcgi_val = kvs.get("FASTCGI_CACHE", "no")
                fastcgi_dur = kvs.get("FASTCGI_DURATION", "2m")
                app_type = kvs.get("APP_TYPE", "php")
                
                # Check .env existence and values
                env_file = os.path.join(homedir, u, "web", dname, "public_html", ".env")
                env_exists = os.path.isfile(env_file)
                env_has_redis = False
                
                if env_exists:
                    try:
                        with open(env_file, 'r', encoding='utf-8', errors='ignore') as ef:
                            content = ef.read()
                            if "REDIS_DB" in content:
                                env_has_redis = True
                                if not redis_db_val:
                                    m = re.search(r'REDIS_DB=["\']?(\d+)["\']?', content)
                                    if m:
                                        redis_db_val = m.group(1)
                    except Exception:
                        pass
                
                db_num = int(redis_db_val) if redis_db_val.isdigit() else None
                if db_num is not None and 0 <= db_num <= 15:
                    assigned_db_count += 1
                    db_stats[f"db{db_num}"]["assigned_domain"] = dname
                    db_stats[f"db{db_num}"]["assigned_user"] = u
                
                if fastcgi_val.lower() == "yes":
                    fastcgi_enabled_count += 1
                    
                d_cache_bytes = domain_cache_sizes.get(dname, 0)
                
                domains_list[dname] = {
                    "DOMAIN": dname,
                    "USER": u,
                    "REDIS_DB": db_num,
                    "REDIS_STATUS": "active" if (db_num is not None) else "not_configured",
                    "FASTCGI_CACHE": fastcgi_val,
                    "FASTCGI_DURATION": fastcgi_dur,
                    "CACHE_SIZE_BYTES": d_cache_bytes,
                    "CACHE_SIZE_HUMAN": human_bytes(d_cache_bytes),
                    "APP_TYPE": app_type,
                    "ENV_EXISTS": env_exists,
                    "ENV_HAS_REDIS": env_has_redis
                }
    except Exception:
        pass

# Fallback: scan homedir if no web.conf domains were found
if not domains_list:
    for u_dir in glob.glob(os.path.join(homedir, "*")):
        u = os.path.basename(u_dir)
        for d_dir in glob.glob(os.path.join(u_dir, "web", "*")):
            dname = os.path.basename(d_dir)
            if os.path.isdir(d_dir):
                env_file = os.path.join(d_dir, "public_html", ".env")
                env_exists = os.path.isfile(env_file)
                env_has_redis = False
                redis_db_val = None
                if env_exists:
                    try:
                        with open(env_file, 'r', encoding='utf-8', errors='ignore') as ef:
                            cnt = ef.read()
                            if "REDIS_DB" in cnt:
                                env_has_redis = True
                                m = re.search(r'REDIS_DB=["\']?(\d+)["\']?', cnt)
                                if m:
                                    redis_db_val = int(m.group(1))
                    except Exception:
                        pass
                
                d_cache_bytes = domain_cache_sizes.get(dname, 0)
                domains_list[dname] = {
                    "DOMAIN": dname,
                    "USER": u,
                    "REDIS_DB": redis_db_val,
                    "REDIS_STATUS": "active" if (redis_db_val is not None) else "not_configured",
                    "FASTCGI_CACHE": "no",
                    "FASTCGI_DURATION": "2m",
                    "CACHE_SIZE_BYTES": d_cache_bytes,
                    "CACHE_SIZE_HUMAN": human_bytes(d_cache_bytes),
                    "APP_TYPE": "php",
                    "ENV_EXISTS": env_exists,
                    "ENV_HAS_REDIS": env_has_redis
                }

# 4. GATHER MYSQL SLOW QUERY SUMMARY
slow_query_summary = {
    "status": "ok",
    "slow_log": {
        "enabled": False,
        "log_file": "/var/log/mysql/mariadb-slow.log",
        "file_exists": False,
        "total_slow_queries_count": 0
    },
    "queries_count": 0,
    "queries": []
}

analyzer_script = os.path.join(bin_dir, "v-analyze-mysql-queries")
if os.path.isfile(analyzer_script) and os.access(analyzer_script, os.X_OK):
    try:
        a_res = subprocess.run([analyzer_script, "auto", "5", "json", homedir, hestia], capture_output=True, text=True, timeout=5)
        if a_res.returncode == 0 and a_res.stdout.strip().startswith("{"):
            slow_query_summary = json.loads(a_res.stdout)
    except Exception:
        pass

# Assemble Master Governance Payload
governance_data = {
    "summary": {
        "REDIS_INSTALLED": redis_installed,
        "REDIS_RUNNING": redis_running,
        "REDIS_VERSION": redis_version,
        "REDIS_USED_MEMORY_HUMAN": used_mem_human,
        "REDIS_USED_MEMORY_BYTES": used_mem_bytes,
        "REDIS_PEAK_MEMORY_HUMAN": peak_mem_human,
        "REDIS_MAX_MEMORY_HUMAN": max_mem_human,
        "REDIS_MEM_FRAGMENTATION_RATIO": frag_ratio,
        "REDIS_CONNECTED_CLIENTS": connected_clients,
        "REDIS_OPS_PER_SEC": ops_per_sec,
        "REDIS_HIT_RATE_PCT": hit_rate_pct,
        "REDIS_KEYSPACE_HITS": keyspace_hits,
        "REDIS_KEYSPACE_MISSES": keyspace_misses,
        "REDIS_ASSIGNED_DOMAINS_COUNT": assigned_db_count,
        "TOTAL_REDIS_KEYS": total_redis_keys,
        "FASTCGI_TOTAL_SIZE_BYTES": total_microcache_bytes,
        "FASTCGI_TOTAL_SIZE_HUMAN": human_bytes(total_microcache_bytes),
        "FASTCGI_TOTAL_FILES": total_microcache_files,
        "FASTCGI_ENABLED_COUNT": fastcgi_enabled_count,
        "TOTAL_MONITORED_DOMAINS": len(domains_list),
        "SLOW_QUERIES_COUNT": slow_query_summary.get("slow_log", {}).get("total_slow_queries_count", 0),
        "ACTIVE_SLOW_PATTERNS": len(slow_query_summary.get("queries", [])),
        "SLOW_LOG_ENABLED": slow_query_summary.get("slow_log", {}).get("enabled", False),
        "MYSQL_QPS": mysql_qps,
        "MYSQL_QUERIES_TOTAL": mysql_queries_total
    },
    "redis_databases": db_stats,
    "domains": domains_list,
    "slow_queries": slow_query_summary
}

if format_type == "json":
    print(json.dumps(governance_data, indent=4))
else:
    s = governance_data["summary"]
    print(f"Redis Status     : {'Running (' + s['REDIS_VERSION'] + ')' if s['REDIS_RUNNING'] else 'Stopped'}")
    print(f"Redis Memory     : {s['REDIS_USED_MEMORY_HUMAN']} (Peak: {s['REDIS_PEAK_MEMORY_HUMAN']})")
    print(f"Redis Hit Rate   : {s['REDIS_HIT_RATE_PCT']}% ({s['REDIS_KEYSPACE_HITS']} hits / {s['REDIS_KEYSPACE_MISSES']} misses)")
    print(f"FastCGI Cache    : {s['FASTCGI_TOTAL_SIZE_HUMAN']} ({s['FASTCGI_TOTAL_FILES']} files)")
    print(f"Slow SQL Queries : {s['SLOW_QUERIES_COUNT']} logged (Log Active: {s['SLOW_LOG_ENABLED']})")
    print(f"Active Domains   : {s['TOTAL_MONITORED_DOMAINS']}")
PYEOF

exit 0
