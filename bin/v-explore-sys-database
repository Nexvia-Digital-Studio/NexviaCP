#!/bin/bash
# info: explore database schema, table rows and run safe queries for Nexvia DB Studio
# options: USER DATABASE [TABLE] [SQL_QUERY]

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
[ -f /etc/hestiacp/hestia.conf ] && source /etc/hestiacp/hestia.conf
[ -z "$HESTIA" ] && HESTIA="/usr/local/hestia"
# shellcheck source=/usr/local/hestia/func/main.sh
[ -f "$HESTIA/func/main.sh" ] && source "$HESTIA/func/main.sh"
# load config file
[ -f "$HESTIA/conf/hestia.conf" ] && source_conf "$HESTIA/conf/hestia.conf"

user=$1
database=$2
table=$3
sql_query=$4

check_args '2' "$#" 'USER DATABASE [TABLE] [SQL_QUERY]'
is_format_valid 'user'

# Ensure root
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: Script can be executed only by root user"
	exit 10
fi

# Sanitize inputs
clean_db=$(echo "$database" | tr -cd 'a-zA-Z0-9_-')
clean_table=$(echo "$table" | tr -cd 'a-zA-Z0-9_-')

python3 - "$clean_db" "$clean_table" "$sql_query" << 'PYEOF'
import sys, subprocess, json, re

db = sys.argv[1]
table = sys.argv[2] if len(sys.argv) > 2 else ""
custom_sql = sys.argv[3] if len(sys.argv) > 3 else ""

def run_mysql(query, target_db=""):
    cmd = ["mysql", "--defaults-file=/root/.my.cnf", "--batch", "--raw", "--skip-column-names", "-e", query]
    if target_db:
        cmd.extend([target_db])
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        return res.stdout.strip(), res.stderr.strip()
    except Exception as e:
        # Fallback to direct socket
        cmd = ["mysql", "--batch", "--raw", "--skip-column-names", "-e", query]
        if target_db:
            cmd.extend([target_db])
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        return res.stdout.strip(), res.stderr.strip()

def run_mysql_with_headers(query, target_db=""):
    cmd = ["mysql", "--defaults-file=/root/.my.cnf", "--batch", "--raw", "-e", query]
    if target_db:
        cmd.extend([target_db])
    try:
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        return res.stdout.strip(), res.stderr.strip()
    except Exception as e:
        cmd = ["mysql", "--batch", "--raw", "-e", query]
        if target_db:
            cmd.extend([target_db])
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        return res.stdout.strip(), res.stderr.strip()

result = {
    "status": "ok",
    "database": db,
    "tables": [],
    "selected_table": table,
    "columns": [],
    "rows": [],
    "total_rows": 0
}

# 1. Fetch tables summary
tables_q = f"SELECT table_name, engine, table_rows, ROUND(data_length/1024/1024, 2), ROUND(index_length/1024/1024, 2), table_collation FROM information_schema.TABLES WHERE table_schema = '{db}';"
out, err = run_mysql(tables_q)

if out:
    for line in out.splitlines():
        parts = line.split("\t")
        if len(parts) >= 6:
            result["tables"].append({
                "name": parts[0],
                "engine": parts[1] or "InnoDB",
                "rows": int(parts[2]) if parts[2].isdigit() else 0,
                "data_mb": float(parts[3]) if parts[3] and parts[3] != "NULL" else 0.0,
                "index_mb": float(parts[4]) if parts[4] and parts[4] != "NULL" else 0.0,
                "collation": parts[5] or ""
            })

# 2. If table is selected, fetch columns and preview rows
if table:
    # Columns
    col_q = f"DESCRIBE `{db}`.`{table}`;"
    col_out, _ = run_mysql(col_q)
    if col_out:
        for line in col_out.splitlines():
            parts = line.split("\t")
            if len(parts) >= 2:
                result["columns"].append({
                    "field": parts[0],
                    "type": parts[1],
                    "null": parts[2] if len(parts) > 2 else "",
                    "key": parts[3] if len(parts) > 3 else "",
                    "default": parts[4] if len(parts) > 4 else "",
                    "extra": parts[5] if len(parts) > 5 else ""
                })

    # Rows (first 50)
    data_q = f"SELECT * FROM `{db}`.`{table}` LIMIT 50;"
    data_out, _ = run_mysql_with_headers(data_q)
    if data_out:
        lines = data_out.splitlines()
        if len(lines) > 0:
            headers = lines[0].split("\t")
            result["headers"] = headers
            for line in lines[1:]:
                vals = line.split("\t")
                row_dict = {}
                for idx, h in enumerate(headers):
                    row_dict[h] = vals[idx] if idx < len(vals) else ""
                result["rows"].append(row_dict)
            result["total_rows"] = len(result["rows"])

# 3. If custom SQL is requested
if custom_sql:
    # Security: only allow read-only queries
    sql_clean = custom_sql.strip()
    if not re.match(r'^(SELECT|SHOW|EXPLAIN|DESCRIBE|DESC)\s', sql_clean, re.IGNORECASE):
        result["status"] = "error"
        result["error"] = "Only read-only queries (SELECT, SHOW, EXPLAIN, DESCRIBE) are permitted in DB Studio."
    else:
        if not re.search(r'\bLIMIT\b', sql_clean, re.IGNORECASE):
            sql_clean += " LIMIT 50"
        
        sql_out, sql_err = run_mysql_with_headers(sql_clean, db)
        if sql_err and not sql_out:
            result["status"] = "error"
            result["error"] = sql_err
        elif sql_out:
            lines = sql_out.splitlines()
            if len(lines) > 0:
                headers = lines[0].split("\t")
                result["headers"] = headers
                result["rows"] = []
                for line in lines[1:]:
                    vals = line.split("\t")
                    row_dict = {}
                    for idx, h in enumerate(headers):
                        row_dict[h] = vals[idx] if idx < len(vals) else ""
                    result["rows"].append(row_dict)
                result["total_rows"] = len(result["rows"])

print(json.dumps(result))
PYEOF

exit 0
