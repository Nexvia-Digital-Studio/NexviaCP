#!/bin/bash
# info: check updates from Nexvia-Digital-Studio/NexviaCP and upstream HestiaCP
# options: [FORMAT]

# Includes
[ -f /etc/hestiacp/hestia.conf ] && source /etc/hestiacp/hestia.conf
[ -f "$HESTIA/func/main.sh" ] && source "$HESTIA/func/main.sh"
[ -f "$HESTIA/conf/hestia.conf" ] && source_conf "$HESTIA/conf/hestia.conf" 2>/dev/null || true

format=${1:-json}
gh_token="$GITHUB_TOKEN"

# Validate requested output format
case "$format" in
	json|text|shell)
		;;
	*)
		echo "ERROR: Invalid format '$format' (supported: json, text, shell)."
		exit "${E_INVALID:-2}"
		;;
esac

tmp_nx=$(mktemp -t nx_commit_XXXXXX)
tmp_up=$(mktemp -t up_release_XXXXXX)
trap 'rm -f "$tmp_nx" "$tmp_up"' EXIT

# Feed the auth token via a curl config on stdin so it never appears
# on the process command line (/proc safe)
if [ -n "$gh_token" ]; then
	printf 'header = "Authorization: Bearer %s"\n' "$gh_token" |
		curl -s -K - -H "Accept: application/vnd.github+json" \
			"https://api.github.com/repos/Nexvia-Digital-Studio/NexviaCP/commits/main" \
			> "$tmp_nx" 2>/dev/null
else
	curl -s -H "Accept: application/vnd.github+json" \
		"https://api.github.com/repos/Nexvia-Digital-Studio/NexviaCP/commits/main" \
		> "$tmp_nx" 2>/dev/null
fi
curl -s -H "Accept: application/vnd.github+json" "https://api.github.com/repos/hestiacp/hestiacp/releases/latest" > "$tmp_up" 2>/dev/null

python3 - "$tmp_nx" "$tmp_up" "$format" << 'PYEOF'
import json, sys, os

tmp_nx = sys.argv[1]
tmp_up = sys.argv[2]
format_arg = sys.argv[3] if len(sys.argv) > 3 else "json"

nexvia_data = {}
try:
    with open(tmp_nx, "r") as f:
        nexvia_data = json.load(f)
except:
    pass

upstream_data = {}
try:
    with open(tmp_up, "r") as f:
        upstream_data = json.load(f)
except:
    pass

sha = nexvia_data.get("sha", "latest")[:7] if isinstance(nexvia_data, dict) else "latest"
full_sha = nexvia_data.get("sha", "latest") if isinstance(nexvia_data, dict) else "latest"
msg = nexvia_data.get("commit", {}).get("message", "NexviaCP Core Updates") if isinstance(nexvia_data, dict) else "NexviaCP Core"
date = nexvia_data.get("commit", {}).get("author", {}).get("date", "") if isinstance(nexvia_data, dict) else ""
author = nexvia_data.get("commit", {}).get("author", {}).get("name", "Nexvia Digital Studio") if isinstance(nexvia_data, dict) else "Nexvia"
html_url = nexvia_data.get("html_url", "https://github.com/Nexvia-Digital-Studio/NexviaCP") if isinstance(nexvia_data, dict) else "https://github.com/Nexvia-Digital-Studio/NexviaCP"

up_tag = upstream_data.get("tag_name", "v1.10.4") if isinstance(upstream_data, dict) else "v1.10.4"
up_name = upstream_data.get("name", "Service Release") if isinstance(upstream_data, dict) else "Service Release"
up_date = upstream_data.get("published_at", "") if isinstance(upstream_data, dict) else ""
up_url = upstream_data.get("html_url", "https://github.com/hestiacp/hestiacp/releases") if isinstance(upstream_data, dict) else "https://github.com/hestiacp/hestiacp/releases"

out = {
    "nexvia": {
        "repo": "Nexvia-Digital-Studio/NexviaCP",
        "branch": "main",
        "latest_sha": sha,
        "full_sha": full_sha,
        "latest_message": msg,
        "author": author,
        "latest_date": date,
        "commit_url": html_url,
        "up_to_date": "yes"
    },
    "upstream_hestia": {
        "repo": "hestiacp/hestiacp",
        "latest_version": up_tag,
        "title": up_name,
        "published_at": up_date,
        "changelog_url": up_url
    }
}

if format_arg == "json":
    print(json.dumps(out, indent=4, ensure_ascii=False))
else:
    print(f"NexviaCP: {sha} - {msg}")
    print(f"Upstream Hestia: {up_tag}")
PYEOF

rm -f "$tmp_nx" "$tmp_up"
exit 0
